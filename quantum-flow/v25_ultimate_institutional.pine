
//@version=6
indicator("QUANTUM FLOW ULTIMATE v25.0 — INSTITUTIONAL ADAPTIVE ENGINE", overlay=true,
         max_labels_count=500, max_lines_count=500, max_boxes_count=500, max_bars_back=1000)

// ═══════════════════════════════════════════════════════
// TYPES
// ═══════════════════════════════════════════════════════
type pivotPoint
    float currentLevel
    float lastLevel
    bool crossed
    int barTime     = na
    int barIdx      = na

type trendBias
    int bias = 0

type trailExt
    float top = na
    float bottom = na
    int topTime = na
    int topIdx = na
    int bottomTime = na
    int bottomIdx = na

type liqPool
    float level
    int touches
    int firstBar
    int lastBar
    int firstTime
    bool isHigh
    bool swept

type breakerBlock
    float bHigh
    float bLow
    int bTime
    int bias
    int birthBar

type obData
    float bHigh
    float bLow
    int bTime
    int bias
    bool isBearishCandle
    box boxRef               // store box reference

type zoneContact
    float zoneTop
    float zoneBot
    float contactPrice
    int contactBar
    int dir
    string zoneName
    bool fired
    float zrs

type retestZone
    float level
    int bias
    int birthBar
    bool tested

BULLISH_C = 1
BEARISH_C = -1
GREEN_C   = #089981
RED_C     = #F23645

// ═══════════════════════════════════════════════════════
// INSTRUMENT PROFILES
// ═══════════════════════════════════════════════════════
isGold = str.contains(str.upper(syminfo.ticker), "XAU") or str.contains(str.upper(syminfo.ticker), "GOLD") or str.contains(str.upper(syminfo.ticker), "GC")
isNQ   = str.contains(str.upper(syminfo.ticker), "NQ") or str.contains(str.upper(syminfo.ticker), "MNQ")
isES   = str.contains(str.upper(syminfo.ticker), "ES") or str.contains(str.upper(syminfo.ticker), "MES") or str.contains(str.upper(syminfo.ticker), "SPX")
isEU   = str.contains(str.upper(syminfo.ticker), "EUR") and str.contains(str.upper(syminfo.ticker), "USD")
isGU   = str.contains(str.upper(syminfo.ticker), "GBP") and str.contains(str.upper(syminfo.ticker), "USD")
isUJ   = str.contains(str.upper(syminfo.ticker), "USD") and str.contains(str.upper(syminfo.ticker), "JPY")
isBTC  = str.contains(str.upper(syminfo.ticker), "BTC") or str.contains(str.upper(syminfo.ticker), "MBT")
isFX   = isEU or isGU or isUJ

float profDisplMult = isGold?1.3:isNQ?1.5:isES?1.2:isFX?1.4:isBTC?1.3:1.3
float profSweepTol  = isGold?0.10:isNQ?0.08:isES?0.06:isFX?0.12:isBTC?0.10:0.10
int   profHPThresh  = isGold?4:isNQ?5:isES?4:isFX?4:isBTC?4:4
string profCorr1    = isGold?"TVC:DXY":isNQ?"CME_MINI:ES1!":isES?"CME_MINI:NQ1!":isEU?"TVC:DXY":isGU?"TVC:DXY":isUJ?"FX:EURUSD":isBTC?"BINANCE:ETHUSD":"TVC:DXY"
string profCorr2    = isGold?"TVC:TNX":isNQ?"TVC:TNX":isES?"TVC:VIX":isFX?"TVC:TNX":isBTC?"CRYPTOCAP:TOTAL":"TVC:TNX"
string profName     = isGold?"GOLD":isNQ?"NQ":isES?"ES":isEU?"EUR/USD":isGU?"GBP/USD":isUJ?"USD/JPY":isBTC?"BTC":"GENERAL"

// ═══════════════════════════════════════════════════════
// INPUTS
// ═══════════════════════════════════════════════════════
GRP_PROF = "═══ INSTRUMENT ═══"
i_profOverride = input.string("Auto","Profile",group=GRP_PROF,options=["Auto","Gold","NQ","ES","EUR/USD","GBP/USD","USD/JPY","BTC"])

GRP_V15 = "═══ v25 ZONE MASTERY ENGINE ═══"
i_useZoneEntry  = input.bool(true,"Two-Phase Zone Entry",group=GRP_V15)
i_pendingBars   = input.int(0,"Validation Window (0=auto)",group=GRP_V15,minval=0,maxval=30)
i_zrsThresh     = input.int(4,"Min Zone Reaction Score",group=GRP_V15,minval=1,maxval=10)
i_hardBiasGate  = input.bool(true,"Hard Bias Gate",group=GRP_V15)
i_moveExhaust   = input.bool(true,"Move Exhaustion Filter",group=GRP_V15)
i_moveATRLimit  = input.float(5.0,"Max Move (ATR×)",group=GRP_V15,minval=2.0,maxval=15.0,step=0.5)
i_sweepReject   = input.bool(true,"Require Sweep Rejection",group=GRP_V15)
i_dirCooldown   = input.bool(true,"Directional Cooldown",group=GRP_V15)
i_showTPSL      = input.bool(true,"Show TP/SL Boxes",group=GRP_V15)
i_bosRetest     = input.bool(true,"BOS Retest Entries",group=GRP_V15)
i_zoneMemBars   = input.int(5,"Zone Contact Memory (bars)",group=GRP_V15,minval=2,maxval=10)
i_sessDelay     = input.int(3,"Session Start Delay (bars)",group=GRP_V15,minval=0,maxval=10)
i_useTrailing   = input.bool(true,"Trailing Stop by Structure",group=GRP_V15)
i_trailATRMult  = input.float(1.0,"Trailing ATR Multiplier",group=GRP_V15,minval=0.5,maxval=3.0,step=0.1)

GRP_SESS = "═══ SESSIONS ═══"
i_showTokyo  = input.bool(true,"Tokyo",inline="tk",group=GRP_SESS)
i_tokyoTime  = input.session("0000-0900","",inline="tk",group=GRP_SESS)
i_tokyoCol   = input.color(color.rgb(255,152,0,85),"",inline="tk",group=GRP_SESS)
i_showLondon = input.bool(true,"London",inline="ln",group=GRP_SESS)
i_londonTime = input.session("0800-1630","",inline="ln",group=GRP_SESS)
i_londonCol  = input.color(color.rgb(76,175,79,85),"",inline="ln",group=GRP_SESS)
i_showNY     = input.bool(true,"New York",inline="ny",group=GRP_SESS)
i_nyTime     = input.session("1300-2200","",inline="ny",group=GRP_SESS)
i_nyCol      = input.color(color.rgb(33,149,243,85),"",inline="ny",group=GRP_SESS)
i_sessZone   = input.string("UTC","Timezone",group=GRP_SESS)
i_showSessBG = input.bool(true,"Session Background",group=GRP_SESS)
i_sessBGTransp = input.int(90,"BG Transparency",group=GRP_SESS,minval=70,maxval=98)
i_autoHide   = input.bool(true,"Auto-hide Boxes above 1H",group=GRP_SESS)
i_prevDays   = input.int(3,"Previous Session Days",group=GRP_SESS,minval=1,maxval=5)
i_showPrevLines = input.bool(true,"Prev Session H/L Lines",group=GRP_SESS)
i_prevStyle  = input.string("Dashed","Line Style",group=GRP_SESS,options=["Solid","Dashed","Dotted"])
i_showSB     = input.bool(true,"Silver Bullet Windows",group=GRP_SESS)
i_sbLN       = input.session("0800-0900","SB London (UTC)",group=GRP_SESS)
i_sbNYAM     = input.session("1500-1600","SB NY AM (UTC)",group=GRP_SESS)
i_sbNYPM     = input.session("1900-2000","SB NY PM (UTC)",group=GRP_SESS)

GRP_BIAS = "═══ HTF BIAS ═══"
i_biasMode = input.string("Daily/4H","Bias Mode",group=GRP_BIAS,options=["Weekly/Daily","Daily/4H"])
i_htfWeight = input.int(40,"Higher TF Weight %",group=GRP_BIAS,minval=20,maxval=70,step=5)
i_ltfWeight = input.int(60,"Lower TF Weight %",group=GRP_BIAS,minval=30,maxval=80,step=5)
i_biasNeutralOK = input.bool(false,"Allow Signals in Neutral",group=GRP_BIAS)

GRP_INT = "═══ Internal Structure ═══"
i_showInternals = input.bool(true,"Show Internal Structure",group=GRP_INT)
i_intLen        = input.int(5,"Internal Length",group=GRP_INT,minval=3,maxval=20)
i_showIntBull   = input.string("All","Bullish",group=GRP_INT,inline="ib",options=["All","BOS","CHoCH"])
i_intBullCol    = input.color(GREEN_C,"",group=GRP_INT,inline="ib")
i_showIntBear   = input.string("All","Bearish",group=GRP_INT,inline="ibe",options=["All","BOS","CHoCH"])
i_intBearCol    = input.color(RED_C,"",group=GRP_INT,inline="ibe")
i_intLabelSize  = input.string(size.tiny,"Label Size",group=GRP_INT,options=[size.tiny,size.small,size.normal])

GRP_SWG = "═══ Swing Structure ═══"
i_showSwing     = input.bool(true,"Show Swing Structure",group=GRP_SWG)
i_swingLen      = input.int(50,"Swing Length",group=GRP_SWG,minval=5,maxval=200)
i_showSwgBull   = input.string("All","Bullish",group=GRP_SWG,inline="sb",options=["All","BOS","CHoCH"])
i_swgBullCol    = input.color(GREEN_C,"",group=GRP_SWG,inline="sb")
i_showSwgBear   = input.string("All","Bearish",group=GRP_SWG,inline="sbe",options=["All","BOS","CHoCH"])
i_swgBearCol    = input.color(RED_C,"",group=GRP_SWG,inline="sbe")
i_swgLabelSize  = input.string(size.small,"Label Size",group=GRP_SWG,options=[size.tiny,size.small,size.normal])
i_showSwgPts    = input.bool(false,"Show HH/HL/LH/LL",group=GRP_SWG)
i_showStrongWeak = input.bool(true,"Show Strong/Weak H/L",group=GRP_SWG)
i_showPossibility = input.bool(true,"Show Shift Possibility",group=GRP_SWG)

GRP_OB = "═══ Order Blocks ═══"
i_showIntOB  = input.bool(true,"Internal OBs",group=GRP_OB,inline="iob")
i_intOBSize  = input.int(5,"",group=GRP_OB,minval=1,maxval=20,inline="iob")
i_showSwgOB  = input.bool(false,"Swing OBs",group=GRP_OB,inline="sob")
i_swgOBSize  = input.int(5,"",group=GRP_OB,minval=1,maxval=20,inline="sob")
i_obFilter   = input.string("Atr","OB Filter",group=GRP_OB,options=["Atr","Cumulative Mean Range"])
i_obMitig    = input.string("High/Low","OB Mitigation",group=GRP_OB,options=["Close","High/Low"])
i_showBreaker = input.bool(true,"Breaker Blocks",group=GRP_OB)
i_intBullOBCol = input.color(color.new(#3179f5,80),"Int Bull OB",group=GRP_OB)
i_intBearOBCol = input.color(color.new(#f77c80,80),"Int Bear OB",group=GRP_OB)
i_swgBullOBCol = input.color(color.new(#1848cc,80),"Swing Bull OB",group=GRP_OB)
i_swgBearOBCol = input.color(color.new(#b22833,80),"Swing Bear OB",group=GRP_OB)

GRP_FVG = "═══ Fair Value Gaps ═══"
i_showFVG    = input.bool(true,"Show FVGs",group=GRP_FVG)
i_showIFVG   = input.bool(true,"Show IFVGs",group=GRP_FVG)
i_showCE     = input.bool(true,"Show CE Lines",group=GRP_FVG)
i_maxFVG     = input.int(5,"Max FVGs",group=GRP_FVG,minval=1,maxval=15)
i_fvgBullCol = input.color(color.new(#00ff68,70),"Bull FVG",group=GRP_FVG)
i_fvgBearCol = input.color(color.new(#ff0008,70),"Bear FVG",group=GRP_FVG)

GRP_EQ = "═══ Equal Highs/Lows ═══"
i_showEQL    = input.bool(true,"Show EQH/EQL",group=GRP_EQ)
i_eqlBars    = input.int(3,"Bars Confirmation",group=GRP_EQ,minval=1)
i_eqlThresh  = input.float(0.1,"Threshold",group=GRP_EQ,minval=0,maxval=10,step=0.1)
i_eqlSize    = input.string(size.tiny,"Label Size",group=GRP_EQ,options=[size.tiny,size.small,size.normal])

GRP_LIQ = "═══ LIQUIDITY MAP ═══"
i_showLiqMap = input.bool(true,"Show Liquidity Pools",group=GRP_LIQ)
i_liqPvtLen  = input.int(10,"Pivot Length",group=GRP_LIQ,minval=3,maxval=30)
i_liqMaxPools = input.int(10,"Max Pools",group=GRP_LIQ,minval=3,maxval=20)
i_liqBullCol = input.color(color.new(#00E5FF,50),"Buy Stops",group=GRP_LIQ)
i_liqBearCol = input.color(color.new(#FF6D00,50),"Sell Stops",group=GRP_LIQ)

GRP_ARSI = "═══ ADAPTIVE RSI ═══"
i_useARSI   = input.bool(true,"Enable",group=GRP_ARSI)
i_arsiLen   = input.int(249,"Length",group=GRP_ARSI,minval=14,maxval=500)
i_arsiLB    = input.int(43,"Lookback",group=GRP_ARSI,minval=10,maxval=200)
i_arsiOSM   = input.float(0.1,"OS Margin",group=GRP_ARSI,minval=0.01,maxval=0.5,step=0.01)
i_arsiOBM   = input.float(0.1,"OB Margin",group=GRP_ARSI,minval=0.01,maxval=0.5,step=0.01)

GRP_ADV = "═══ ADVANCED ═══"
i_showPDZ   = input.bool(true,"Premium/Discount Zones",group=GRP_ADV)
i_premCol   = input.color(color.rgb(244,67,54,85),"Premium",inline="pd",group=GRP_ADV)
i_discCol   = input.color(color.rgb(76,175,80,85),"Discount",inline="pd",group=GRP_ADV)
i_extPrem   = input.int(95,"Extreme Premium %",group=GRP_ADV,minval=85,maxval=140)
i_extDisc   = input.int(5,"Extreme Discount %",group=GRP_ADV,minval=-100,maxval=15)
i_showDOpen = input.bool(false,"Daily/Weekly Open",group=GRP_ADV)
i_showSMT   = input.bool(true,"SMT Divergence",group=GRP_ADV)
i_smtTicker = input.string("","SMT Symbol (blank=auto)",group=GRP_ADV)
i_smtLen    = input.int(8,"SMT Pivot Len",group=GRP_ADV,minval=3,maxval=20)
i_showDiv   = input.bool(true,"RSI Divergence Labels",group=GRP_ADV)
i_divPvtLen = input.int(5,"Divergence Pivot Len",group=GRP_ADV,minval=3,maxval=20)
i_divMaxBars = input.int(80,"Divergence Max Bars",group=GRP_ADV,minval=20,maxval=200)
i_showOTE   = input.bool(true,"OTE Zones",group=GRP_ADV)
i_showIB    = input.bool(true,"Opening Range / IB",group=GRP_ADV)
i_showADR   = input.bool(true,"ADR Exhaustion",group=GRP_ADV)

GRP_SIG = "═══ SIGNALS ═══"
i_cooldown   = input.int(6,"Cooldown Bars",group=GRP_SIG,minval=1,maxval=30)
i_sessFilter = input.bool(false,"Require Active Session",group=GRP_SIG)
i_shiftBodyMult = input.float(0.0,"Shift Body Mult (0=auto)",group=GRP_SIG,minval=0.0,maxval=2.5,step=0.1)
i_hpThreshold = input.int(0,"HP Threshold (0=auto)",group=GRP_SIG,minval=0,maxval=15)

GRP_VIS = "═══ DISPLAY ═══"
i_showDash  = input.bool(true,"Main Dashboard",group=GRP_VIS)
i_showMI    = input.bool(true,"Market Intel",group=GRP_VIS)
i_showEMA   = input.bool(false,"EMAs",group=GRP_VIS)
i_showVWAP  = input.bool(false,"VWAP",group=GRP_VIS)
i_showPDHL  = input.bool(false,"PDH/PDL",group=GRP_VIS)
i_emaF=input.int(9,"EMA Fast",group=GRP_VIS), i_emaM=input.int(21,"EMA Mid",group=GRP_VIS)
i_emaS=input.int(50,"EMA Slow",group=GRP_VIS), i_ema200=input.int(200,"EMA 200",group=GRP_VIS)
i_modeHist = input.string("Historical","Structure Mode",group=GRP_VIS,options=["Historical","Present"])

// ═══════════════════════════════════════════════════════
// RESOLVED PROFILE
// ═══════════════════════════════════════════════════════
float rDisplMult = i_shiftBodyMult > 0 ? i_shiftBodyMult : profDisplMult
int   rHPThresh  = i_hpThreshold > 0 ? i_hpThreshold : profHPThresh
string smtSym    = i_smtTicker != "" ? i_smtTicker : profCorr1
string corrSym2  = profCorr2
string rProfName = i_profOverride == "Auto" ? profName : i_profOverride

// v25: Adaptive validation window
tfSec = timeframe.in_seconds()
adaptPendBars = i_pendingBars > 0 ? i_pendingBars : (tfSec <= 300 ? 10 : tfSec <= 900 ? 8 : tfSec <= 3600 ? 12 : 8)

// ═══════════════════════════════════════════════════════
// CORE CALCULATIONS
// ═══════════════════════════════════════════════════════
var int prevDayN = na
isNewDay = false
cd = dayofmonth(time)
if na(prevDayN) or cd != prevDayN
    isNewDay := true
prevDayN := cd

atr14 = ta.atr(14)
atr200 = ta.atr(200)
adaptCD = math.max(2, math.round(i_cooldown * (tfSec <= 300 ? 2.5 : tfSec <= 900 ? 1.5 : 1.0)))
eF = ta.ema(close, i_emaF), eM = ta.ema(close, i_emaM)
eS = ta.ema(close, i_emaS), e200 = ta.ema(close, i_ema200)
[stV, stD] = ta.supertrend(3.0, 10)
stBull = stD == 1
volSMA = ta.sma(volume, 20)
volR = volume / math.max(volSMA, 1)
prng = high - low
cloc = prng > 0 ? 100.0 * (close - low) / prng : 50.0
body = math.abs(close - open)
avgBody10 = ta.sma(body, 10)
avgBody3 = (math.abs(close[1]-open[1]) + math.abs(close[2]-open[2]) + math.abs(close[3]-open[3])) / 3
avgBodyRef = math.max(avgBody3, avgBody10)
drawOK = true

// VWAP
var float cPV = 0.0, var float cVol = 0.0
if isNewDay
    cPV := 0.0, cVol := 0.0
cPV += volume * hl2, cVol += volume
vwap = cVol > 0 ? cPV / cVol : hl2
cumTR = ta.cum(ta.tr)
volMeasure = i_obFilter == "Atr" ? atr200 : cumTR / bar_index

// Candle anatomy for ZRS
bodyRatio = prng > 0 ? body / prng : 0.5
lowerWick = math.min(close, open) - low
upperWick = high - math.max(close, open)
lowerWickR = prng > 0 ? lowerWick / prng : 0
upperWickR = prng > 0 ? upperWick / prng : 0

// Historical arrays (limit size for performance)
maxHist = 500
var array<float> arr_highs = array.new<float>()
var array<float> arr_lows = array.new<float>()
var array<int> arr_times = array.new<int>()
var array<bool> arr_isBearCandle = array.new<bool>()
arr_highs.unshift(high)
arr_lows.unshift(low)
arr_times.unshift(time)
arr_isBearCandle.unshift(close < open)
if array.size(arr_highs) > maxHist
    arr_highs.pop()
    arr_lows.pop()
    arr_times.pop()
    arr_isBearCandle.pop()

// ═══════════════════════════════════════════════════════
// HTF BIAS + HARD GATE
// ═══════════════════════════════════════════════════════
htfTF = i_biasMode == "Weekly/Daily" ? "W" : "D"
htfC1 = request.security(syminfo.tickerid, htfTF, close[1], lookahead=barmerge.lookahead_off)
htfO1 = request.security(syminfo.tickerid, htfTF, open[1], lookahead=barmerge.lookahead_off)
htfE9 = request.security(syminfo.tickerid, htfTF, ta.ema(close,9), lookahead=barmerge.lookahead_off)
htfE21 = request.security(syminfo.tickerid, htfTF, ta.ema(close,21), lookahead=barmerge.lookahead_off)
htfCur = request.security(syminfo.tickerid, htfTF, close, lookahead=barmerge.lookahead_off)
htfCurO = request.security(syminfo.tickerid, htfTF, open, lookahead=barmerge.lookahead_off)
htfBias = (not na(htfC1) and htfC1>htfO1?25:-25) + (not na(htfCur) and htfCur>htfCurO?35:-35) + (not na(htfE9) and not na(htfE21)?(htfE9>htfE21?40:htfE9<htfE21?-40:0):0)

ltfTF = i_biasMode == "Weekly/Daily" ? "D" : "240"
ltfC1 = request.security(syminfo.tickerid, ltfTF, close[1], lookahead=barmerge.lookahead_off)
ltfO1 = request.security(syminfo.tickerid, ltfTF, open[1], lookahead=barmerge.lookahead_off)
ltfE9 = request.security(syminfo.tickerid, ltfTF, ta.ema(close,9), lookahead=barmerge.lookahead_off)
ltfE21 = request.security(syminfo.tickerid, ltfTF, ta.ema(close,21), lookahead=barmerge.lookahead_off)
ltfCur = request.security(syminfo.tickerid, ltfTF, close, lookahead=barmerge.lookahead_off)
ltfCurO = request.security(syminfo.tickerid, ltfTF, open, lookahead=barmerge.lookahead_off)
ltfBias = (not na(ltfC1) and ltfC1>ltfO1?20:-20) + (not na(ltfCur) and ltfCur>ltfCurO?30:-30) + (not na(ltfE9) and not na(ltfE21)?(ltfE9>ltfE21?30:ltfE9<ltfE21?-30:0):0) + (close>e200?20:-20)

totalW = math.max(i_htfWeight + i_ltfWeight, 1)
combBias = math.round((htfBias * i_htfWeight + ltfBias * i_ltfWeight) / totalW)
htfLabel = i_biasMode == "Weekly/Daily" ? "W" : "D"
ltfLabel = i_biasMode == "Weekly/Daily" ? "D" : "4H"
biasTxt = combBias>=50?"STRONG BULL":combBias>=20?"BULL":combBias<=-50?"STRONG BEAR":combBias<=-20?"BEAR":"NEUTRAL"
biasIsBull = combBias >= 20, biasIsBear = combBias <= -20
biasNeutral = not biasIsBull and not biasIsBear

hardBlockBuy  = i_hardBiasGate and combBias <= -40
hardBlockSell = i_hardBiasGate and combBias >= 40
softBlockBuy  = combBias <= -20 and combBias > -40
softBlockSell = combBias >= 20 and combBias < 40
biasAllowBuy  = not hardBlockBuy and (biasIsBull or (biasNeutral and i_biasNeutralOK))
biasAllowSell = not hardBlockSell and (biasIsBear or (biasNeutral and i_biasNeutralOK))

var int prevBDir = 0
curBDir = biasIsBull ? 1 : biasIsBear ? -1 : 0
biasFlip = prevBDir != 0 and curBDir != 0 and prevBDir != curBDir
prevBDir := curBDir

// ═══════════════════════════════════════════════════════
// ADAPTIVE RSI + DIVERGENCE
// ═══════════════════════════════════════════════════════
arsi = ta.rsi(close, i_arsiLen)
arsiMax = ta.highest(arsi, i_arsiLB), arsiMin = ta.lowest(arsi, i_arsiLB)
arsiRng = arsiMax - arsiMin
arsiOB = arsiMax - arsiRng * i_arsiOBM, arsiOS = arsiMin + arsiRng * i_arsiOSM
arsiSlope = arsi - arsi[1]
arsiBull = i_useARSI and arsi > arsiOS and arsiSlope > 0
arsiBear = i_useARSI and arsi < arsiOB and arsiSlope < 0
arsiRegime = arsi > arsiOB ? "OB" : arsi < arsiOS ? "OS" : "MID"

dvPL = ta.pivotlow(low, i_divPvtLen, i_divPvtLen), dvPH = ta.pivothigh(high, i_divPvtLen, i_divPvtLen)
currPricePL = ta.valuewhen(not na(dvPL), low[i_divPvtLen], 0), prevPricePL = ta.valuewhen(not na(dvPL), low[i_divPvtLen], 1)
currRsiPL = ta.valuewhen(not na(dvPL), arsi[i_divPvtLen], 0), prevRsiPL = ta.valuewhen(not na(dvPL), arsi[i_divPvtLen], 1)
currIdxPL = ta.valuewhen(not na(dvPL), bar_index, 0), prevIdxPL = ta.valuewhen(not na(dvPL), bar_index, 1)
currPricePH = ta.valuewhen(not na(dvPH), high[i_divPvtLen], 0), prevPricePH = ta.valuewhen(not na(dvPH), high[i_divPvtLen], 1)
currRsiPH = ta.valuewhen(not na(dvPH), arsi[i_divPvtLen], 0), prevRsiPH = ta.valuewhen(not na(dvPH), arsi[i_divPvtLen], 1)
currIdxPH = ta.valuewhen(not na(dvPH), bar_index, 0), prevIdxPH = ta.valuewhen(not na(dvPH), bar_index, 1)
plSpan = not na(currIdxPL) and not na(prevIdxPL)?currIdxPL-prevIdxPL:9999
phSpan = not na(currIdxPH) and not na(prevIdxPH)?currIdxPH-prevIdxPH:9999
divRegBull = not na(dvPL) and not na(prevPricePL) and not na(prevRsiPL) and currPricePL<prevPricePL and currRsiPL>prevRsiPL and plSpan>0 and plSpan<=i_divMaxBars
divHidBull = not na(dvPL) and not na(prevPricePL) and not na(prevRsiPL) and currPricePL>prevPricePL and currRsiPL<prevRsiPL and plSpan>0 and plSpan<=i_divMaxBars
divRegBear = not na(dvPH) and not na(prevPricePH) and not na(prevRsiPH) and currPricePH>prevPricePH and currRsiPH<prevRsiPH and phSpan>0 and phSpan<=i_divMaxBars
divHidBear = not na(dvPH) and not na(prevPricePH) and not na(prevRsiPH) and currPricePH<prevPricePH and currRsiPH>prevRsiPH and phSpan>0 and phSpan<=i_divMaxBars
anyDivBull = divRegBull or divHidBull, anyDivBear = divRegBear or divHidBear

if i_showDiv and divRegBull and drawOK
    label.new(bar_index-i_divPvtLen,low[i_divPvtLen],"REG DIV▲",color=color.new(#00BCD4,15),textcolor=color.white,style=label.style_label_up,size=size.tiny)
if i_showDiv and divHidBull and drawOK
    label.new(bar_index-i_divPvtLen,low[i_divPvtLen],"HID DIV▲",color=color.new(#00BCD4,40),textcolor=color.white,style=label.style_label_up,size=size.tiny)
if i_showDiv and divRegBear and drawOK
    label.new(bar_index-i_divPvtLen,high[i_divPvtLen],"REG DIV▼",color=color.new(#E040FB,15),textcolor=color.white,style=label.style_label_down,size=size.tiny)
if i_showDiv and divHidBear and drawOK
    label.new(bar_index-i_divPvtLen,high[i_divPvtLen],"HID DIV▼",color=color.new(#E040FB,40),textcolor=color.white,style=label.style_label_down,size=size.tiny)

// ═══════════════════════════════════════════════════════
// VOLUME INTELLIGENCE + PRESSURE
// ═══════════════════════════════════════════════════════
viType = volR>=3?"CLIMAX":volR>=2?"VERY HIGH":volR>=1.5?"HIGH":volR>=1?"ABOVE AVG":"LOW"
viBull = close>open and cloc>70 and body>prng*0.6
viBear = close<open and cloc<30 and body>prng*0.6
viDoji = body < prng * 0.1
viExhTop = viDoji and volR>=2 and close[1]>close[2], viExhBot = viDoji and volR>=2 and close[1]<close[2]
viConvBull = viBull and volR>=1.5, viConvBear = viBear and volR>=1.5

sHL = math.max(prng, syminfo.mintick)
bPress = volume * (close - low) / sHL, sPress = volume * (high - close) / sHL
delta = bPress - sPress
cumD14 = ta.sma(delta, 14)
pressR = ta.sma((bPress+sPress)>0?bPress/(bPress+sPress)*100:50.0, 14)
strongBP = pressR>60 and cumD14>0, strongSP = pressR<40 and cumD14<0
pressR5 = ta.sma(pressR, 5)
pressShiftBull = pressR>55 and pressR5[1]<45, pressShiftBear = pressR<45 and pressR5[1]>55
flowBull = pressR>58 and cumD14>0 and volR>=1.2, flowBear = pressR<42 and cumD14<0 and volR>=1.2

var float sessCumDelta = 0.0
if isNewDay
    sessCumDelta := 0.0
sessCumDelta += delta
var float sessDeltaHi=na, var float sessPriceHi=na, var float sessDeltaLo=na, var float sessPriceLo=na
if isNewDay
    sessDeltaHi:=na, sessPriceHi:=na, sessDeltaLo:=na, sessPriceLo:=na
if high>=nz(sessPriceHi,high)
    sessPriceHi:=high, sessDeltaHi:=sessCumDelta
if low<=nz(sessPriceLo,low)
    sessPriceLo:=low, sessDeltaLo:=sessCumDelta
cumDeltaDivBear = not na(sessPriceHi) and high>=sessPriceHi and sessCumDelta<nz(sessDeltaHi)*0.8
cumDeltaDivBull = not na(sessPriceLo) and low<=sessPriceLo and sessCumDelta>nz(sessDeltaLo)*0.8

// ═══════════════════════════════════════════════════════
// v25: TRIPLE-PATTERN ZONE REACTION SCORE (ZRS) - improved
// ═══════════════════════════════════════════════════════

zrs_absorbBull() =>
    s = 0.0
    s += bodyRatio < 0.3 ? 3.0 : bodyRatio < 0.45 ? 1.5 : 0.0
    s += lowerWickR > 0.4 ? 2.5 : lowerWickR > 0.25 ? 1.5 : 0.0
    s += math.min(volR / 1.5, 1.0) * 2.5
    s += cloc > 55 ? 1.5 : 0.0
    s += (delta > 0 and delta[1] <= 0) ? 1.0 : delta > 0 ? 0.5 : 0.0
    s

zrs_absorbBear() =>
    s = 0.0
    s += bodyRatio < 0.3 ? 3.0 : bodyRatio < 0.45 ? 1.5 : 0.0
    s += upperWickR > 0.4 ? 2.5 : upperWickR > 0.25 ? 1.5 : 0.0
    s += math.min(volR / 1.5, 1.0) * 2.5
    s += cloc < 45 ? 1.5 : 0.0
    s += (delta < 0 and delta[1] >= 0) ? 1.0 : delta < 0 ? 0.5 : 0.0
    s

zrs_rejectBull() =>
    wickDom = lowerWick / math.max(upperWick, syminfo.mintick)
    s = 0.0
    s += (bodyRatio >= 0.2 and bodyRatio <= 0.6) ? 2.0 : 0.0
    s += wickDom > 2.5 ? 3.0 : wickDom > 1.5 ? 2.0 : 0.0
    s += close > open ? 2.0 : 0.0
    s += volR >= 1.0 ? 1.5 : 0.0
    s += cloc > 60 ? 1.5 : 0.0
    s

zrs_rejectBear() =>
    wickDom = upperWick / math.max(lowerWick, syminfo.mintick)
    s = 0.0
    s += (bodyRatio >= 0.2 and bodyRatio <= 0.6) ? 2.0 : 0.0
    s += wickDom > 2.5 ? 3.0 : wickDom > 1.5 ? 2.0 : 0.0
    s += close < open ? 2.0 : 0.0
    s += volR >= 1.0 ? 1.5 : 0.0
    s += cloc < 40 ? 1.5 : 0.0
    s

zrs_engulfBull() =>
    s = 0.0
    s += (close > open and body > prng * 0.55) ? 3.0 : 0.0
    s += (close > open[1] and close[1] < open[1]) ? 3.0 : 0.0
    s += volR >= 1.3 ? 2.0 : volR >= 1.0 ? 1.0 : 0.0
    s += cloc > 70 ? 1.5 : 0.0
    s

zrs_engulfBear() =>
    s = 0.0
    s += (close < open and body > prng * 0.55) ? 3.0 : 0.0
    s += (close < open[1] and close[1] > open[1]) ? 3.0 : 0.0
    s += volR >= 1.3 ? 2.0 : volR >= 1.0 ? 1.0 : 0.0
    s += cloc < 30 ? 1.5 : 0.0
    s

twoBarBullRev = close[1] < open[1] and close > open and close > open[1]
twoBarBearRev = close[1] > open[1] and close < open and close < open[1]
twoBarBonusBull = twoBarBullRev ? 3.0 : 0.0
twoBarBonusBear = twoBarBearRev ? 3.0 : 0.0
climaxBonus = volR >= 3.0 ? 3.0 : volR >= 2.5 ? 2.0 : 0.0

ZRS_bull = math.max(zrs_absorbBull(), zrs_rejectBull(), zrs_engulfBull()) + twoBarBonusBull + climaxBonus
ZRS_bear = math.max(zrs_absorbBear(), zrs_rejectBear(), zrs_engulfBear()) + twoBarBonusBear + climaxBonus

// ═══════════════════════════════════════════════════════
// REGIME + WYCKOFF
// ═══════════════════════════════════════════════════════
[diP, diM, adx] = ta.dmi(14, 14)
bbB = ta.sma(close,20), bbD = 2.0*ta.stdev(close,20)
bbW = bbB>0?((bbB+bbD)-(bbB-bbD))/bbB*100:0.0, bbWS = ta.sma(bbW, 50)
chopI = 100.0*math.log10(ta.sma(ta.atr(1),14)*14/(ta.highest(high,14)-ta.lowest(low,14)))/math.log10(14)
dir14 = math.abs(close-close[14]), vol14 = ta.sma(math.abs(close-close[1]),14)*14
effR = vol14>0?dir14/vol14:0.0
isTrend = adx>22 and effR>0.35, isChop = chopI>61.8 and adx<25, isRange = adx<22
regBull = isTrend and diP>diM, regBear = isTrend and diM>diP
isVolExp = bbW>bbWS*1.3, isVolCmp = bbW<bbWS*0.7
regTxt = adx>35?"STRONG TREND":isTrend?"TRENDING":isChop?"CHOPPY":isRange?"RANGING":"DEVELOPING"

sma50 = ta.sma(close, 50), rH20 = ta.highest(high, 20), rL20 = ta.lowest(low, 20)
spring = low<rL20[1] and close>rL20[1] and close>open
utad = high>rH20[1] and close<rH20[1] and close<open
rPct = close>0?(rH20-rL20)/close*100:0.0
tightR = rPct<ta.sma(rPct,50)*0.7, volDecl = volR<0.7
isAccum = tightR and volDecl and close<sma50 and isRange
isDist = tightR and volDecl and close>sma50 and isRange
isManip = spring or utad
wyTxt = spring?"SPRING ▲":utad?"UTAD ▼":isAccum?"ACCUMULATION":isDist?"DISTRIBUTION":regBull?"MARKUP ▲":regBear?"MARKDOWN ▼":"DEVELOPING"

// ═══════════════════════════════════════════════════════
// DAILY DATA + P/D + ADR
// ═══════════════════════════════════════════════════════
pdh = request.security(syminfo.tickerid,"D",high[1],lookahead=barmerge.lookahead_off)
pdl = request.security(syminfo.tickerid,"D",low[1],lookahead=barmerge.lookahead_off)
dOpen = request.security(syminfo.tickerid,"D",open,lookahead=barmerge.lookahead_off)
wOpen = request.security(syminfo.tickerid,"W",open,lookahead=barmerge.lookahead_off)
dATR = request.security(syminfo.tickerid,"D",ta.atr(14),lookahead=barmerge.lookahead_off)
pdLookback = tfSec<=300?200:tfSec<=900?150:tfSec<=3600?100:50
swH_fb = ta.highest(high, pdLookback), swL_fb = ta.lowest(low, pdLookback)
var float swH_deal = na, var float swL_deal = na

// Sessions
dayF = ":123456"
showBox = not i_autoHide or tfSec <= 3600
inTK = not na(time(timeframe.period, i_tokyoTime+dayF, i_sessZone)) and timeframe.isintraday
inLN = not na(time(timeframe.period, i_londonTime+dayF, i_sessZone)) and timeframe.isintraday
inNY = not na(time(timeframe.period, i_nyTime+dayF, i_sessZone)) and timeframe.isintraday
tkSt = inTK and not inTK[1], tkEn = not inTK and inTK[1]
lnSt = inLN and not inLN[1], lnEn = not inLN and inLN[1]
nySt = inNY and not inNY[1], nyEn = not inNY and inNY[1]
inOvlp = inLN and inNY, inKZ = inOvlp, inActive = inTK or inLN or inNY
inSBLN = not na(time(timeframe.period,i_sbLN+dayF,i_sessZone)) and timeframe.isintraday
inSBNA = not na(time(timeframe.period,i_sbNYAM+dayF,i_sessZone)) and timeframe.isintraday
inSBNP = not na(time(timeframe.period,i_sbNYPM+dayF,i_sessZone)) and timeframe.isintraday
inSB = inSBLN or inSBNA or inSBNP

barMin = minute(time, i_sessZone), barHour = hour(time, i_sessZone)
isQuarterHour = barMin==0 or barMin==15 or barMin==30 or barMin==45
isMacroTime = (barHour==2 and barMin>=33) or (barHour==3 and barMin<=0) or (barHour==4 and barMin>=3 and barMin<=30) or (barHour==8 and barMin>=50) or (barHour==9 and barMin<=10) or (barHour==9 and barMin>=50) or (barHour==10 and barMin<=10) or (barHour==10 and barMin>=50) or (barHour==11 and barMin<=10) or (barHour==13 and barMin>=10 and barMin<=40) or (barHour==15 and barMin>=15 and barMin<=45)
timeScore = (inSB?3:inKZ?2:inActive?1:0)+(isQuarterHour?1:0)+(isMacroTime?2:0)

// v25: Session start delay — bars since session opened
var int sessBarsIn = 0
if tkSt or lnSt or nySt
    sessBarsIn := 0
if inActive
    sessBarsIn += 1
sessEstablished = sessBarsIn > i_sessDelay

// Session H/L tracking
var float cTH=na,var float cTL=na,var float cLH=na,var float cLL=na,var float cNH=na,var float cNL=na
if tkSt
    cTH:=high, cTL:=low
else if inTK
    cTH:=math.max(nz(cTH,high),high), cTL:=math.min(nz(cTL,low),low)
if lnSt
    cLH:=high, cLL:=low
else if inLN
    cLH:=math.max(nz(cLH,high),high), cLL:=math.min(nz(cLL,low),low)
if nySt
    cNH:=high, cNL:=low
else if inNY
    cNH:=math.max(nz(cNH,high),high), cNL:=math.min(nz(cNL,low),low)

var float pTH1=na,var float pTL1=na,var float pTH2=na,var float pTL2=na,var float pTH3=na,var float pTL3=na
var float pLH1=na,var float pLL1=na,var float pLH2=na,var float pLL2=na,var float pLH3=na,var float pLL3=na
var float pNH1=na,var float pNL1=na,var float pNH2=na,var float pNL2=na,var float pNH3=na,var float pNL3=na
if tkEn and not na(cTH)
    pTH3:=pTH2,pTL3:=pTL2,pTH2:=pTH1,pTL2:=pTL1,pTH1:=cTH,pTL1:=cTL
if lnEn and not na(cLH)
    pLH3:=pLH2,pLL3:=pLL2,pLH2:=pLH1,pLL2:=pLL1,pLH1:=cLH,pLL1:=cLL
if nyEn and not na(cNH)
    pNH3:=pNH2,pNL3:=pNL2,pNH2:=pNH1,pNL2:=pNL1,pNH1:=cNH,pNL1:=cNL

// IB
ibSession = isGold?"0800-0830":(isNQ or isES)?"1430-1500":"0800-0830"
inIB = not na(time(timeframe.period, ibSession+dayF, i_sessZone)) and timeframe.isintraday
ibSt = inIB and not inIB[1]
var float ibHi=na, var float ibLo=na, var bool ibSet=false
if ibSt
    ibHi:=high, ibLo:=low, ibSet:=false
else if inIB
    ibHi:=math.max(nz(ibHi,high),high), ibLo:=math.min(nz(ibLo,low),low)
else if not inIB and inIB[1] and not na(ibHi)
    ibSet:=true
ibWidth = not na(ibHi) and not na(ibLo)?ibHi-ibLo:na
ibNarrow = not na(ibWidth) and not na(atr14) and ibWidth<atr14*0.5
ibBrokenUp = ibSet and close>nz(ibHi), ibBrokenDn = ibSet and close<nz(ibLo)
var line ibHL=na, var line ibLL=na
if i_showIB and ibSet and barstate.islast and not na(ibHi)
    line.delete(ibHL), line.delete(ibLL)
    ibHL:=line.new(bar_index-60,ibHi,bar_index+20,ibHi,color=color.new(#FFD700,30),style=line.style_solid,width=2)
    ibLL:=line.new(bar_index-60,ibLo,bar_index+20,ibLo,color=color.new(#FFD700,30),style=line.style_solid,width=2)

// ═══════════════════════════════════════════════════════
// SWEEP ENGINE (v25: improved rejection validation)
// ═══════════════════════════════════════════════════════
sTol = atr14 * profSweepTol
cSH(l) => not na(l) and high > l + sTol and close < l
cSL(l) => not na(l) and low < l - sTol and close > l
swpBear=false, swpBull=false
var string swpSource="", var float sweepDepth=0.0
if cSH(pTH1)
    swpBear:=true, swpSource:="Prev TK Hi", sweepDepth:=high-pTH1
else if cSH(pLH1)
    swpBear:=true, swpSource:="Prev LN Hi", sweepDepth:=high-pLH1
else if cSH(pNH1)
    swpBear:=true, swpSource:="Prev NY Hi", sweepDepth:=high-pNH1
else if i_prevDays>=2 and (cSH(pTH2) or cSH(pLH2) or cSH(pNH2))
    swpBear:=true, swpSource:="Prev D2 Hi"
else if i_prevDays>=3 and (cSH(pTH3) or cSH(pLH3) or cSH(pNH3))
    swpBear:=true, swpSource:="Prev D3 Hi"
if cSL(pTL1)
    swpBull:=true, swpSource:="Prev TK Lo", sweepDepth:=pTL1-low
else if cSL(pLL1)
    swpBull:=true, swpSource:="Prev LN Lo", sweepDepth:=pLL1-low
else if cSL(pNL1)
    swpBull:=true, swpSource:="Prev NY Lo", sweepDepth:=pNL1-low
else if i_prevDays>=2 and (cSL(pTL2) or cSL(pLL2) or cSL(pNL2))
    swpBull:=true, swpSource:="Prev D2 Lo"
else if i_prevDays>=3 and (cSL(pTL3) or cSL(pLL3) or cSL(pNL3))
    swpBull:=true, swpSource:="Prev D3 Lo"
tkLoSwept = inLN and not na(cTL) and low<cTL-sTol and close>cTL
tkHiSwept = inLN and not na(cTH) and high>cTH+sTol and close<cTH
if tkLoSwept
    swpBull:=true, swpSource:="TK Lows"
if tkHiSwept
    swpBear:=true, swpSource:="TK Highs"
lnLoSwept = inNY and not na(cLL) and low<cLL-sTol and close>cLL
lnHiSwept = inNY and not na(cLH) and high>cLH+sTol and close<cLH
if lnLoSwept
    swpBull:=true, swpSource:="LN Lows"
if lnHiSwept
    swpBear:=true, swpSource:="LN Highs"
if not na(pdh) and cSH(pdh)
    swpBear:=true, swpSource:="PDH"
if not na(pdl) and cSL(pdl)
    swpBull:=true, swpSource:="PDL"

sweepRejBull = cloc>55 and lowerWickR>0.3
sweepRejBear = cloc<45 and upperWickR>0.3
swpBullValid = swpBull and (not i_sweepReject or sweepRejBull)
swpBearValid = swpBear and (not i_sweepReject or sweepRejBear)

prox = atr14 * 0.5
cNr(l) => not na(l) and math.abs(close-l) < prox
nearHi = cNr(pTH1) or cNr(pLH1) or cNr(pNH1) or cNr(pTH2) or cNr(pLH2) or cNr(pNH2)
nearLo = cNr(pTL1) or cNr(pLL1) or cNr(pNL1) or cNr(pTL2) or cNr(pLL2) or cNr(pNL2)

// Session boxes (compact)
MSD = 86400000
dLeft = math.abs(math.floor((last_bar_time-time)/MSD)), sIR = dLeft<60 and showBox
var box tkB=na, var box lnB=na, var box nyB=na
if tkSt and i_showTokyo and sIR
    tkB:=box.new(bar_index,high,bar_index+1,low,border_color=color.new(i_tokyoCol,30),bgcolor=i_tokyoCol,border_width=1,border_style=line.style_dashed)
else if inTK and i_showTokyo and sIR and not na(tkB)
    box.set_top(tkB,math.max(nz(cTH,high),high)), box.set_bottom(tkB,math.min(nz(cTL,low),low)), box.set_right(tkB,bar_index+1)
if lnSt and i_showLondon and sIR
    lnB:=box.new(bar_index,high,bar_index+1,low,border_color=color.new(i_londonCol,30),bgcolor=i_londonCol,border_width=1,border_style=line.style_dashed)
else if inLN and i_showLondon and sIR and not na(lnB)
    box.set_top(lnB,math.max(nz(cLH,high),high)), box.set_bottom(lnB,math.min(nz(cLL,low),low)), box.set_right(lnB,bar_index+1)
if nySt and i_showNY and sIR
    nyB:=box.new(bar_index,high,bar_index+1,low,border_color=color.new(i_nyCol,30),bgcolor=i_nyCol,border_width=1,border_style=line.style_dashed)
else if inNY and i_showNY and sIR and not na(nyB)
    box.set_top(nyB,math.max(nz(cNH,high),high)), box.set_bottom(nyB,math.min(nz(cNL,low),low)), box.set_right(nyB,bar_index+1)

pLS = i_prevStyle=="Solid"?line.style_solid:i_prevStyle=="Dashed"?line.style_dashed:line.style_dotted
var line lTH1=na,var line lTL1=na,var line lLH1=na,var line lLL1=na,var line lNH1=na,var line lNL1=na
if i_showPrevLines and barstate.islast
    line.delete(lTH1),line.delete(lTL1),line.delete(lLH1),line.delete(lLL1),line.delete(lNH1),line.delete(lNL1)
    ext = bar_index+50
    if not na(pTH1)
        lTH1:=line.new(bar_index-100,pTH1,ext,pTH1,color=color.new(#FF9800,30),style=pLS,width=1)
        lTL1:=line.new(bar_index-100,pTL1,ext,pTL1,color=color.new(#FF9800,30),style=pLS,width=1)
    if not na(pLH1)
        lLH1:=line.new(bar_index-100,pLH1,ext,pLH1,color=color.new(#4CAF50,30),style=pLS,width=1)
        lLL1:=line.new(bar_index-100,pLL1,ext,pLL1,color=color.new(#4CAF50,30),style=pLS,width=1)
    if not na(pNH1)
        lNH1:=line.new(bar_index-100,pNH1,ext,pNH1,color=color.new(#2196F3,30),style=pLS,width=1)
        lNL1:=line.new(bar_index-100,pNL1,ext,pNL1,color=color.new(#2196F3,30),style=pLS,width=1)

// ═══════════════════════════════════════════════════════
// STRUCTURE ENGINE (v25: fixed line accumulation, improved OB handling)
// ═══════════════════════════════════════════════════════
var pivotPoint swingHi=pivotPoint.new(na,na,false), var pivotPoint swingLo=pivotPoint.new(na,na,false)
var pivotPoint intHi=pivotPoint.new(na,na,false), var pivotPoint intLo=pivotPoint.new(na,na,false)
var pivotPoint eqHi=pivotPoint.new(na,na,false), var pivotPoint eqLo=pivotPoint.new(na,na,false)
var trendBias swingTrend=trendBias.new(0), var trendBias intTrend=trendBias.new(0)
var trailExt trailing=trailExt.new()

_swgHighest=ta.highest(high,i_swingLen), _swgLowest=ta.lowest(low,i_swingLen)
_intHighest=ta.highest(high,i_intLen), _intLowest=ta.lowest(low,i_intLen)
_eqHighest=ta.highest(high,i_eqlBars), _eqLowest=ta.lowest(low,i_eqlBars)
var int _swgLeg=0
if high[i_swingLen]>_swgHighest
    _swgLeg:=0
else if low[i_swingLen]<_swgLowest
    _swgLeg:=1
var int _intLeg=0
if high[i_intLen]>_intHighest
    _intLeg:=0
else if low[i_intLen]<_intLowest
    _intLeg:=1
var int _eqLeg=0
if high[i_eqlBars]>_eqHighest
    _eqLeg:=0
else if low[i_eqlBars]<_eqLowest
    _eqLeg:=1

_swgLegChg=ta.change(_swgLeg), _intLegChg=ta.change(_intLeg), _eqLegChg=ta.change(_eqLeg)
_xoIntHi=ta.crossover(close,nz(intHi.currentLevel)), _xuIntLo=ta.crossunder(close,nz(intLo.currentLevel))
_xoSwgHi=ta.crossover(close,nz(swingHi.currentLevel)), _xuSwgLo=ta.crossunder(close,nz(swingLo.currentLevel))
isDispBull = body > avgBodyRef * rDisplMult and cloc > 55 and close > open
isDispBear = body > avgBodyRef * rDisplMult and cloc < 45 and close < open

getStructure(int sz, int legChg, bool eqMode=false, bool intMode=false) =>
    newPiv=legChg!=0, pivLow=legChg==1, pivHigh=legChg==-1
    float _retBot=na,int _retBotTime=na,int _retBotIdx=na,float _retTop=na,int _retTopTime=na,int _retTopIdx=na
    string _retTag=""
    if newPiv
        if pivLow
            pivotPoint pp = eqMode?eqLo:intMode?intLo:swingLo
            if eqMode and not na(pp.currentLevel) and math.abs(pp.currentLevel-low[sz])<i_eqlThresh*atr200
                if i_showEQL and drawOK
                    line.new(chart.point.new(pp.barTime,na,pp.currentLevel),chart.point.new(time[sz],na,low[sz]),xloc=xloc.bar_time,color=i_swgBullCol,style=line.style_dotted)
                    midIdx=math.round(0.5*(pp.barIdx+bar_index-sz))
                    label.new(chart.point.new(na,midIdx,low[sz]),"EQL",xloc.bar_index,color=color(na),textcolor=i_swgBullCol,style=label.style_label_up,size=i_eqlSize)
            pp.lastLevel:=pp.currentLevel, pp.currentLevel:=low[sz], pp.crossed:=false, pp.barTime:=time[sz], pp.barIdx:=bar_index[sz]
            if not eqMode and not intMode
                _retBot:=pp.currentLevel,_retBotTime:=pp.barTime,_retBotIdx:=pp.barIdx
                _retTag:=pp.currentLevel<pp.lastLevel?"LL":"HL"
        else
            pivotPoint pp = eqMode?eqHi:intMode?intHi:swingHi
            if eqMode and not na(pp.currentLevel) and math.abs(pp.currentLevel-high[sz])<i_eqlThresh*atr200
                if i_showEQL and drawOK
                    line.new(chart.point.new(pp.barTime,na,pp.currentLevel),chart.point.new(time[sz],na,high[sz]),xloc=xloc.bar_time,color=i_swgBearCol,style=line.style_dotted)
                    midIdx=math.round(0.5*(pp.barIdx+bar_index-sz))
                    label.new(chart.point.new(na,midIdx,high[sz]),"EQH",xloc.bar_index,color=color(na),textcolor=i_swgBearCol,style=label.style_label_down,size=i_eqlSize)
            pp.lastLevel:=pp.currentLevel, pp.currentLevel:=high[sz], pp.crossed:=false, pp.barTime:=time[sz], pp.barIdx:=bar_index[sz]
            if not eqMode and not intMode
                _retTop:=pp.currentLevel,_retTopTime:=pp.barTime,_retTopIdx:=pp.barIdx
                _retTag:=pp.currentLevel>pp.lastLevel?"HH":"LH"
    [_retTop,_retTopTime,_retTopIdx,_retBot,_retBotTime,_retBotIdx,_retTag]

// OB arrays with box references
var array<obData> swgOBs=array.new<obData>(), var array<obData> intOBs=array.new<obData>()
var array<breakerBlock> breakers=array.new<breakerBlock>(), var array<box> breakerBoxes=array.new<box>()

// Helper to create OB box
createOBBox(bHigh, bLow, bTime, isInt, bias) =>
    c = isInt?(bias==BEARISH_C?i_intBearOBCol:i_intBullOBCol):(bias==BEARISH_C?i_swgBearOBCol:i_swgBullOBCol)
    b = box.new(bTime, bHigh, last_bar_time, bLow, xloc=xloc.bar_time, bgcolor=c, border_color=na)
    b

storeOB(pivotPoint pp, bool isInt, int bias) =>
    show = isInt?i_showIntOB:i_showSwgOB
    if show and pp.barIdx>0 and pp.barIdx<bar_index
        startIdx = math.max(pp.barIdx, 0)
        endIdx = math.min(bar_index, array.size(arr_highs)-1)
        if startIdx < endIdx
            bestIdx = -1
            // Limit search to last 200 bars for performance
            startIdx = math.max(startIdx, array.size(arr_highs)-200)
            if bias == BEARISH_C
                float bestVal = na
                for i=startIdx to endIdx
                    if i<array.size(arr_isBearCandle) and not array.get(arr_isBearCandle, i)
                        if na(bestVal) or array.get(arr_highs, i) > bestVal
                            bestVal := array.get(arr_highs, i)
                            bestIdx := i
            else
                float bestVal2 = na
                for i=startIdx to endIdx
                    if i<array.size(arr_isBearCandle) and array.get(arr_isBearCandle, i)
                        if na(bestVal2) or array.get(arr_lows, i) < bestVal2
                            bestVal2 := array.get(arr_lows, i)
                            bestIdx := i
            if bestIdx>=0 and bestIdx<array.size(arr_highs)
                bHigh = array.get(arr_highs, bestIdx)
                bLow = array.get(arr_lows, bestIdx)
                bTime = array.get(arr_times, bestIdx)
                isBear = array.get(arr_isBearCandle, bestIdx)
                ob = obData.new(bHigh, bLow, bTime, bias, isBear, na)
                obs = isInt?intOBs:swgOBs
                // Manage size
                if array.size(obs) >= (isInt?i_intOBSize:i_swgOBSize) * 2
                    while array.size(obs) > (isInt?i_intOBSize:i_swgOBSize)
                        old = array.pop(obs)
                        if not na(old.boxRef)
                            box.delete(old.boxRef)
                array.unshift(obs, ob)
                // Create box now
                ob.boxRef := createOBBox(bHigh, bLow, bTime, isInt, bias)

addBreaker(obData ob) =>
    if i_showBreaker and array.size(breakers) < 10
        array.unshift(breakers, breakerBlock.new(ob.bHigh, ob.bLow, ob.bTime, ob.bias==BULLISH_C?BEARISH_C:BULLISH_C, bar_index))

deleteOBs(bool isInt) =>
    obs = isInt?intOBs:swgOBs
    // Safe removal: iterate backwards
    for i = array.size(obs)-1 to 0
        ob = array.get(obs, i)
        crossed = (bearMitigSrc>ob.bHigh and ob.bias==BEARISH_C) or (bullMitigSrc<ob.bLow and ob.bias==BULLISH_C)
        if crossed
            addBreaker(ob)
            if not na(ob.boxRef)
                box.delete(ob.boxRef)
            array.remove(obs, i)

if i_showBreaker
    for i = array.size(breakers)-1 to 0
        bb = array.get(breakers, i)
        mitigated = (bb.bias==BULLISH_C and close<bb.bLow) or (bb.bias==BEARISH_C and close>bb.bHigh)
        if mitigated or (bar_index - bb.birthBar > 200)
            array.remove(breakers, i)

drawOBs(bool isInt) =>
    obs = isInt?intOBs:swgOBs
    for ob in obs
        if not na(ob.boxRef)
            // Update box to extend to current bar
            box.set_right(ob.boxRef, last_bar_time)
            // Optionally update colors if needed
    // No need to create new boxes each time

drawBreakers() =>
    if i_showBreaker and array.size(breakers)>0
        // Ensure we have enough boxes
        while array.size(breakerBoxes) < array.size(breakers)
            array.push(breakerBoxes, box.new(na,na,na,na, xloc=xloc.bar_time, extend=extend.right))
        for i = 0 to math.min(array.size(breakers)-1, array.size(breakerBoxes)-1)
            bb = array.get(breakers, i)
            bx = array.get(breakerBoxes, i)
            c = bb.bias==BULLISH_C?color.new(#00BCD4,75):color.new(#FF5722,75)
            bx.set_top_left_point(chart.point.new(bb.bTime,na,bb.bHigh))
            bx.set_bottom_right_point(chart.point.new(last_bar_time,na,bb.bLow))
            bx.set_border_color(c), bx.set_bgcolor(c)

// v25: OB REACTION DETECTION
var bool intOBBullR=false, var bool intOBBearR=false
var bool swgOBBullR=false, var bool swgOBBearR=false
var bool breakerBullR=false, var bool breakerBearR=false
intOBBullR:=false, intOBBearR:=false, swgOBBullR:=false, swgOBBearR:=false
breakerBullR:=false, breakerBearR:=false

if array.size(intOBs)>0
    for ob in intOBs
        if ob.bias==BULLISH_C and low<=ob.bHigh and low>=ob.bLow
            intOBBullR:=true
            break
        if ob.bias==BEARISH_C and high>=ob.bLow and high<=ob.bHigh
            intOBBearR:=true
            break
if array.size(swgOBs)>0
    for ob in swgOBs
        if ob.bias==BULLISH_C and low<=ob.bHigh and low>=ob.bLow
            swgOBBullR:=true
            break
        if ob.bias==BEARISH_C and high>=ob.bLow and high<=ob.bHigh
            swgOBBearR:=true
            break
if i_showBreaker and array.size(breakers)>0
    for bb in breakers
        if bb.bias==BULLISH_C and low<=bb.bHigh and low>=bb.bLow
            breakerBullR:=true
        else if bb.bias==BEARISH_C and high>=bb.bLow and high<=bb.bHigh
            breakerBearR:=true

displayStruct(bool isInt, bool xoHi, bool xuLo) =>
    pivotPoint pp = isInt?intHi:swingHi
    trendBias tr = isInt?intTrend:swingTrend
    lStyle = isInt?line.style_dashed:line.style_solid, lSize = isInt?i_intLabelSize:i_swgLabelSize
    bullCol = isInt?i_intBullCol:i_swgBullCol, bearCol = isInt?i_intBearCol:i_swgBearCol
    bool _bullBOS=false,bool _bullCH=false,bool _bearBOS=false,bool _bearCH=false,bool _posBuy=false,bool _posSell=false
    float _brokenLevelBull = na, float _brokenLevelBear = na
    extraCond = isInt?(intHi.currentLevel!=swingHi.currentLevel):true
    displOK_bull = isDispBull or (not isInt)
    if xoHi and not pp.crossed and extraCond and displOK_bull
        tag = tr.bias==BEARISH_C?"CHoCH":"BOS"
        if tag=="CHoCH"
            _bullCH:=true
        else
            _bullBOS:=true
        _brokenLevelBull := pp.currentLevel
        pp.crossed:=true, tr.bias:=BULLISH_C
        if isInt and tag=="CHoCH" and swingTrend.bias==BEARISH_C
            _posBuy:=true
        showFilter=isInt?i_showIntBull:i_showSwgBull, showMain=isInt?i_showInternals:i_showSwing
        dispOK = showMain and (showFilter=="All" or (showFilter=="BOS" and tag!="CHoCH") or (showFilter=="CHoCH" and tag=="CHoCH"))
        if dispOK and drawOK
            var line sl=line.new(na,na,na,na,xloc=xloc.bar_time), var label slb=label.new(na,na)
            if i_modeHist=="Present"
                sl.delete(), slb.delete()
            sl:=line.new(chart.point.new(pp.barTime,na,pp.currentLevel),chart.point.new(time,na,pp.currentLevel),xloc.bar_time,color=bullCol,style=lStyle)
            midIdx=math.round(0.5*(pp.barIdx+bar_index))
            slb:=label.new(chart.point.new(na,midIdx,pp.currentLevel),tag,xloc.bar_index,color=color(na),textcolor=bullCol,style=label.style_label_down,size=lSize)
        if (isInt and i_showIntOB) or (not isInt and i_showSwgOB)
            storeOB(pp, isInt, BULLISH_C)
    pp := isInt?intLo:swingLo
    extraCond2 = isInt?(intLo.currentLevel!=swingLo.currentLevel):true
    displOK_bear = isDispBear or (not isInt)
    if xuLo and not pp.crossed and extraCond2 and displOK_bear
        tag2 = tr.bias==BULLISH_C?"CHoCH":"BOS"
        if tag2=="CHoCH"
            _bearCH:=true
        else
            _bearBOS:=true
        _brokenLevelBear := pp.currentLevel
        pp.crossed:=true, tr.bias:=BEARISH_C
        if isInt and tag2=="CHoCH" and swingTrend.bias==BULLISH_C
            _posSell:=true
        showFilter2=isInt?i_showIntBear:i_showSwgBear, showMain2=isInt?i_showInternals:i_showSwing
        dispOK2 = showMain2 and (showFilter2=="All" or (showFilter2=="BOS" and tag2!="CHoCH") or (showFilter2=="CHoCH" and tag2=="CHoCH"))
        if dispOK2 and drawOK
            var line sl2=line.new(na,na,na,na,xloc=xloc.bar_time), var label slb2=label.new(na,na)
            if i_modeHist=="Present"
                sl2.delete(), slb2.delete()
            sl2:=line.new(chart.point.new(pp.barTime,na,pp.currentLevel),chart.point.new(time,na,pp.currentLevel),xloc.bar_time,color=bearCol,style=lStyle)
            midIdx2=math.round(0.5*(pp.barIdx+bar_index))
            slb2:=label.new(chart.point.new(na,midIdx2,pp.currentLevel),tag2,xloc.bar_index,color=color(na),textcolor=bearCol,style=label.style_label_up,size=lSize)
        if (isInt and i_showIntOB) or (not isInt and i_showSwgOB)
            storeOB(pp, isInt, BEARISH_C)
    [_bullBOS,_bullCH,_bearBOS,_bearCH,_posBuy,_posSell,_brokenLevelBull,_brokenLevelBear]

[sNewTop,sNewTopTime,sNewTopIdx,sNewBot,sNewBotTime,sNewBotIdx,sSwgTag] = getStructure(i_swingLen,_swgLegChg,false,false)
[_nt1,_ntt1,_nti1,_nb1,_nbt1,_nbi1,_itag] = getStructure(i_intLen,_intLegChg,false,true)
if i_showEQL
    [_et,_ett,_eti,_eb,_ebt,_ebi,_etag] = getStructure(i_eqlBars,_eqLegChg,true,false)

if not na(sNewTop)
    trailing.top:=sNewTop, trailing.topTime:=sNewTopTime, trailing.topIdx:=sNewTopIdx, swH_deal:=sNewTop
    if i_showSwgPts and drawOK
        label.new(chart.point.new(sNewTopTime,na,sNewTop),sSwgTag,xloc.bar_time,color=color(na),textcolor=i_swgBearCol,style=label.style_label_down,size=size.small)
if not na(sNewBot)
    trailing.bottom:=sNewBot, trailing.bottomTime:=sNewBotTime, trailing.bottomIdx:=sNewBotIdx, swL_deal:=sNewBot
    if i_showSwgPts and drawOK
        label.new(chart.point.new(sNewBotTime,na,sNewBot),sSwgTag,xloc.bar_time,color=color(na),textcolor=i_swgBullCol,style=label.style_label_up,size=size.small)
if i_showStrongWeak
    trailing.top:=math.max(high,nz(trailing.top,high)), trailing.topTime:=trailing.top==high?time:trailing.topTime, trailing.topIdx:=trailing.top==high?bar_index:trailing.topIdx
    trailing.bottom:=math.min(low,nz(trailing.bottom,low)), trailing.bottomTime:=trailing.bottom==low?time:trailing.bottomTime, trailing.bottomIdx:=trailing.bottom==low?bar_index:trailing.bottomIdx

[aIntBullBOS,aIntBullCH,aIntBearBOS,aIntBearCH,intPosBuy,intPosSell,intBrokenBull,intBrokenBear] = displayStruct(true,_xoIntHi,_xuIntLo)
[aSwgBullBOS,aSwgBullCH,aSwgBearBOS,aSwgBearCH,swgPosBuy,swgPosSell,swgBrokenBull,swgBrokenBear] = displayStruct(false,_xoSwgHi,_xuSwgLo)
if i_showIntOB
    deleteOBs(true)
if i_showSwgOB
    deleteOBs(false)

// v25: BOS RETEST ZONES (enhanced)
var array<retestZone> retestZones = array.new<retestZone>()
if i_bosRetest
    if not na(intBrokenBull)
        array.unshift(retestZones, retestZone.new(intBrokenBull, 1, bar_index, false))
    if not na(intBrokenBear)
        array.unshift(retestZones, retestZone.new(intBrokenBear, -1, bar_index, false))
    if not na(swgBrokenBull)
        array.unshift(retestZones, retestZone.new(swgBrokenBull, 1, bar_index, false))
    if not na(swgBrokenBear)
        array.unshift(retestZones, retestZone.new(swgBrokenBear, -1, bar_index, false))
    // Cleanup old
    if array.size(retestZones) > 20
        while array.size(retestZones) > 15
            array.pop(retestZones)

var bool retestBullR = false, var bool retestBearR = false
retestBullR := false, retestBearR := false
if i_bosRetest and array.size(retestZones) > 0
    rTol = atr14 * 0.3
    for i = array.size(retestZones)-1 to 0
        rz = array.get(retestZones, i)
        if not rz.tested and (bar_index - rz.birthBar) >= 2 and (bar_index - rz.birthBar) <= 25
            if rz.bias == 1 and math.abs(low - rz.level) < rTol
                retestBullR := true
                rz.tested := true
            else if rz.bias == -1 and math.abs(high - rz.level) < rTol
                retestBearR := true
                rz.tested := true
        if (bar_index - rz.birthBar) > 25
            array.remove(retestZones, i)

// Shift possibility (v25: reset only on swing bias change)
var int intBullCHCount=0, var int intBearCHCount=0
var int lastSwingBias = 0
if swingTrend.bias != lastSwingBias and lastSwingBias != 0
    intBullCHCount := 0
    intBearCHCount := 0
lastSwingBias := swingTrend.bias

if aIntBullCH and swingTrend.bias==BEARISH_C
    intBullCHCount += 1
if aIntBearCH and swingTrend.bias==BULLISH_C
    intBearCHCount += 1

possibilityBuy = (intBullCHCount>=2) or (intBullCHCount>=1 and strongBP)
possibilitySell = (intBearCHCount>=2) or (intBearCHCount>=1 and strongSP)
anyBosB = aSwgBullBOS or aSwgBullCH or aIntBullBOS or aIntBullCH
anyBosS = aSwgBearBOS or aSwgBearCH or aIntBearBOS or aIntBearCH

var bool prevPossB=false, var bool prevPossS=false
possNewB = possibilityBuy and not prevPossB, possNewS = possibilitySell and not prevPossS
prevPossB:=possibilityBuy, prevPossS:=possibilitySell
if i_showPossibility and possNewB and drawOK
    label.new(bar_index,low,"⚠ BUY SIDE\nSHIFT POSSIBLE",style=label.style_label_up,color=color.new(#00BCD4,20),textcolor=color.white,size=size.small,yloc=yloc.belowbar)
if i_showPossibility and possNewS and drawOK
    label.new(bar_index,high,"⚠ SELL SIDE\nSHIFT POSSIBLE",style=label.style_label_down,color=color.new(#E040FB,20),textcolor=color.white,size=size.small,yloc=yloc.abovebar)

// Strong/Weak lines (only at last bar)
if i_showStrongWeak and barstate.islast
    var line swHL=line.new(na,na,na,na,xloc=xloc.bar_time,color=i_swgBearCol), var line swLL=line.new(na,na,na,na,xloc=xloc.bar_time,color=i_swgBullCol)
    var label swHLb=label.new(na,na,color=color(na),textcolor=i_swgBearCol,xloc=xloc.bar_time,style=label.style_label_down,size=size.tiny)
    var label swLLb=label.new(na,na,color=color(na),textcolor=i_swgBullCol,xloc=xloc.bar_time,style=label.style_label_up,size=size.tiny)
    rtb = last_bar_time+20*(time-time[1])
    if not na(trailing.topTime)
        swHL.set_first_point(chart.point.new(trailing.topTime,na,trailing.top)), swHL.set_second_point(chart.point.new(rtb,na,trailing.top))
        swHLb.set_point(chart.point.new(rtb,na,trailing.top)), swHLb.set_text(swingTrend.bias==BEARISH_C?"Strong High":"Weak High")
    if not na(trailing.bottomTime)
        swLL.set_first_point(chart.point.new(trailing.bottomTime,na,trailing.bottom)), swLL.set_second_point(chart.point.new(rtb,na,trailing.bottom))
        swLLb.set_point(chart.point.new(rtb,na,trailing.bottom)), swLLb.set_text(swingTrend.bias==BULLISH_C?"Strong Low":"Weak Low")

if barstate.islastconfirmedhistory or barstate.islast
    if i_showIntOB
        drawOBs(true)
    if i_showSwgOB
        drawOBs(false)
    drawBreakers()

// ═══════════════════════════════════════════════════════
// PREMIUM/DISCOUNT + ADR
// ═══════════════════════════════════════════════════════
swH100 = not na(swH_deal)?math.max(swH_deal,swH_fb):swH_fb
swL100 = not na(swL_deal)?math.min(swL_deal,swL_fb):swL_fb
swMid = (swH100+swL100)/2.0
pdPct = swH100!=swL100?math.max(0,math.min(100,(close-swL100)/(swH100-swL100)*100)):50.0
extPrem = pdPct>=i_extPrem, extDisc = pdPct<=i_extDisc
inDisc = close<swMid, inPrem = close>swMid

pdModBull = pdPct<40 ? -1 : pdPct>60 ? 2 : 0
pdModBear = pdPct>60 ? -1 : pdPct<40 ? 2 : 0
pdModBull += pdPct<10 ? -1 : 0
pdModBear += pdPct>90 ? -1 : 0

var float dayHi=na, var float dayLo=na
if isNewDay
    dayHi:=high, dayLo:=low
else
    dayHi:=math.max(nz(dayHi,high),high), dayLo:=math.min(nz(dayLo,low),low)
dayRange = nz(dayHi)-nz(dayLo)
adrPct = not na(dATR) and dATR>0?dayRange/dATR*100:0
adrExhausted = adrPct>=80
adrTxt = adrPct>=85?"EXHAUSTED":adrPct>=65?"MATURE":adrPct<40?"FRESH":"DEVELOPING"
adrHardBlock = adrPct>=85
adrBlockSell = adrHardBlock and not na(dayLo) and close<=nz(dayLo)+dayRange*0.3
adrBlockBuy  = adrHardBlock and not na(dayHi) and close>=nz(dayHi)-dayRange*0.3

// ═══════════════════════════════════════════════════════
// FVG ENGINE (unchanged but robust)
// ═══════════════════════════════════════════════════════
var box[] fvB=array.new_box(0), var box[] fvS=array.new_box(0)
var box[] ifvB=array.new_box(0), var box[] ifvS=array.new_box(0)
fvMin = atr14 * 0.3
fBG = low-high[2], fSG = low[2]-high
var float newBullTop=na,var float newBullBot=na,var float newBearTop=na,var float newBearBot=na
newBullTop:=na, newBullBot:=na, newBearTop:=na, newBearBot:=na

if fBG>0 and fBG>=fvMin and i_showFVG
    newBullTop:=low, newBullBot:=high[2]
    array.push(fvB,box.new(bar_index-2,low,bar_index+40,high[2],bgcolor=color.new(i_fvgBullCol,90),border_color=color.new(i_fvgBullCol,60),border_width=1,text="FVG",text_color=color.new(i_fvgBullCol,25),text_size=size.tiny))
    if i_showCE and drawOK
        line.new(bar_index-2,(low+high[2])/2,bar_index+40,(low+high[2])/2,color=color.new(i_fvgBullCol,40),style=line.style_dotted,width=1)
    if array.size(fvB)>i_maxFVG
        box.delete(array.shift(fvB))
if fSG>0 and fSG>=fvMin and i_showFVG
    newBearTop:=low[2], newBearBot:=high
    array.push(fvS,box.new(bar_index-2,low[2],bar_index+40,high,bgcolor=color.new(i_fvgBearCol,90),border_color=color.new(i_fvgBearCol,60),border_width=1,text="FVG",text_color=color.new(i_fvgBearCol,25),text_size=size.tiny))
    if i_showCE and drawOK
        line.new(bar_index-2,(low[2]+high)/2,bar_index+40,(low[2]+high)/2,color=color.new(i_fvgBearCol,40),style=line.style_dotted,width=1)
    if array.size(fvS)>i_maxFVG
        box.delete(array.shift(fvS))

// IFVG
if not na(newBearTop) and i_showIFVG and array.size(fvB)>0
    for i=array.size(fvB)-1 to 0
        bx=array.get(fvB,i), bTop=box.get_top(bx), bBot=box.get_bottom(bx)
        oTop=math.min(bTop,newBearTop), oBot=math.max(bBot,newBearBot)
        if oTop>oBot
            if array.size(ifvS)<i_maxFVG
                array.push(ifvS,box.new(bar_index,oTop,bar_index+40,oBot,bgcolor=color.new(#FF5722,85),border_color=color.new(#FF5722,40),border_width=2,text="IFVG",text_color=color.new(#FF5722,10),text_size=size.tiny))
            box.delete(bx), array.remove(fvB,i)
            break
if not na(newBullTop) and i_showIFVG and array.size(fvS)>0
    for i=array.size(fvS)-1 to 0
        bx=array.get(fvS,i), bTop=box.get_top(bx), bBot=box.get_bottom(bx)
        oTop=math.min(bTop,newBullTop), oBot=math.max(bBot,newBullBot)
        if oTop>oBot
            if array.size(ifvB)<i_maxFVG
                array.push(ifvB,box.new(bar_index,oTop,bar_index+40,oBot,bgcolor=color.new(#00BCD4,85),border_color=color.new(#00BCD4,40),border_width=2,text="IFVG",text_color=color.new(#00BCD4,10),text_size=size.tiny))
            box.delete(bx), array.remove(fvS,i)
            break

// BOS-FVG star
if anyBosB and fBG>0 and fBG>=fvMin and close[1]>open[1] and array.size(fvB)>0
    bx=array.get(fvB,array.size(fvB)-1)
    box.set_text(bx,"BOS-FVG ★"), box.set_border_color(bx,color.new(#FFD700,20)), box.set_border_width(bx,3)
if anyBosS and fSG>0 and fSG>=fvMin and close[1]<open[1] and array.size(fvS)>0
    bx=array.get(fvS,array.size(fvS)-1)
    box.set_text(bx,"BOS-FVG ★"), box.set_border_color(bx,color.new(#FFD700,20)), box.set_border_width(bx,3)

var bool zBullFVM=false, var bool zBearFVM=false
zBullFVM:=false, zBearFVM:=false
if array.size(fvB)>0
    for i=array.size(fvB)-1 to 0
        bx=array.get(fvB,i), bT=box.get_top(bx), bB=box.get_bottom(bx), fM=(bT+bB)/2
        if close<bB
            box.delete(bx), array.remove(fvB,i)
        else if low<=fM and close>bB
            zBullFVM:=true
            box.set_text(bx, "FVG CE✓")
if array.size(fvS)>0
    for i=array.size(fvS)-1 to 0
        bx=array.get(fvS,i), bT=box.get_top(bx), bB=box.get_bottom(bx), fM=(bT+bB)/2
        if close>bT
            box.delete(bx), array.remove(fvS,i)
        else if high>=fM and close<bT
            zBearFVM:=true
            box.set_text(bx, "FVG CE✓")

var bool ifvBullR=false, var bool ifvBearR=false
ifvBullR:=false, ifvBearR:=false
if array.size(ifvB)>0
    for i=array.size(ifvB)-1 to 0
        bx=array.get(ifvB,i), bT=box.get_top(bx), bB=box.get_bottom(bx)
        if low<bB
            box.delete(bx), array.remove(ifvB,i)
        else if low<=bT and low>=bB
            ifvBullR:=true
if array.size(ifvS)>0
    for i=array.size(ifvS)-1 to 0
        bx=array.get(ifvS,i), bT=box.get_top(bx), bB=box.get_bottom(bx)
        if high>bT
            box.delete(bx), array.remove(ifvS,i)
        else if high>=bB and high<=bT
            ifvBearR:=true

// ═══════════════════════════════════════════════════════
// 1H ORDER BLOCKS (unchanged)
// ═══════════════════════════════════════════════════════
[h1BC,h1BT,h1BB]=request.security(syminfo.tickerid,"60",[close[2]<open[2] and close[1]>open[1] and close[1]>high[2] and math.abs(close[2]-open[2])/(high[2]-low[2]+syminfo.mintick)>0.6,high[2],low[2]],lookahead=barmerge.lookahead_off)
[h1SC,h1ST,h1SB]=request.security(syminfo.tickerid,"60",[close[2]>open[2] and close[1]<open[1] and close[1]<low[2] and math.abs(close[2]-open[2])/(high[2]-low[2]+syminfo.mintick)>0.6,high[2],low[2]],lookahead=barmerge.lookahead_off)
var box[] h1OBB=array.new_box(0), var box[] h1OBS=array.new_box(0)
if h1BC and not h1BC[1]
    array.push(h1OBB,box.new(bar_index,h1BT,bar_index+55,h1BB,bgcolor=color.new(#7C4DFF,78),border_color=color.new(#7C4DFF,25),border_width=2,text="1H OB",text_color=color.new(#7C4DFF,10),text_size=size.tiny))
    if array.size(h1OBB)>5
        box.delete(array.shift(h1OBB))
if h1SC and not h1SC[1]
    array.push(h1OBS,box.new(bar_index,h1ST,bar_index+55,h1SB,bgcolor=color.new(#FF6D00,78),border_color=color.new(#FF6D00,25),border_width=2,text="1H OB",text_color=color.new(#FF6D00,10),text_size=size.tiny))
    if array.size(h1OBS)>5
        box.delete(array.shift(h1OBS))
var bool h1BR=false, var bool h1SR=false
h1BR:=false, h1SR:=false
if array.size(h1OBB)>0
    for i=array.size(h1OBB)-1 to 0
        bx=array.get(h1OBB,i), bT=box.get_top(bx), bB=box.get_bottom(bx)
        if low<bB
            box.delete(bx), array.remove(h1OBB,i)
        else if low<=bT and low>=bB
            h1BR:=true
if array.size(h1OBS)>0
    for i=array.size(h1OBS)-1 to 0
        bx=array.get(h1OBS,i), bT=box.get_top(bx), bB=box.get_bottom(bx)
        if high>bT
            box.delete(bx), array.remove(h1OBS,i)
        else if high>=bB and high<=bT
            h1SR:=true

// ═══════════════════════════════════════════════════════
// LIQUIDITY MAP + SMT (compact)
// ═══════════════════════════════════════════════════════
liqPH = ta.pivothigh(high,i_liqPvtLen,i_liqPvtLen), liqPL = ta.pivotlow(low,i_liqPvtLen,i_liqPvtLen)
var array<liqPool> liqPools = array.new<liqPool>()
var array<line> liqLines=array.new<line>(), var array<label> liqLabels=array.new<label>()
if not na(liqPH) and i_showLiqMap
    exists=false
    for [idx,pool] in liqPools
        if pool.isHigh and math.abs(pool.level-high[i_liqPvtLen])<atr14*0.2
            pool.touches+=1, pool.lastBar:=bar_index-i_liqPvtLen, exists:=true
            break
    if not exists
        liqPools.unshift(liqPool.new(high[i_liqPvtLen],1,bar_index-i_liqPvtLen,bar_index-i_liqPvtLen,time[i_liqPvtLen],true,false))
if not na(liqPL) and i_showLiqMap
    exists2=false
    for [idx,pool] in liqPools
        if not pool.isHigh and math.abs(pool.level-low[i_liqPvtLen])<atr14*0.2
            pool.touches+=1, pool.lastBar:=bar_index-i_liqPvtLen, exists2:=true
            break
    if not exists2
        liqPools.unshift(liqPool.new(low[i_liqPvtLen],1,bar_index-i_liqPvtLen,bar_index-i_liqPvtLen,time[i_liqPvtLen],false,false))
if i_showLiqMap
    for [idx,pool] in liqPools
        if not pool.swept
            if pool.isHigh and high>pool.level+sTol
                pool.swept:=true
            else if not pool.isHigh and low<pool.level-sTol
                pool.swept:=true
if i_showLiqMap and liqPools.size()>i_liqMaxPools*3
    while liqPools.size()>i_liqMaxPools*2
        liqPools.pop()
var float nearestBSL=na, var float nearestSSL=na
nearestBSL:=na, nearestSSL:=na
if i_showLiqMap
    float minDistHi=99999999.0, float minDistLo=99999999.0
    for [idx,pool] in liqPools
        if not pool.swept
            d=math.abs(close-pool.level)
            if pool.isHigh and d<minDistHi
                minDistHi:=d, nearestBSL:=pool.level
            else if not pool.isHigh and d<minDistLo
                minDistLo:=d, nearestSSL:=pool.level
if i_showLiqMap and barstate.islast
    for ln in liqLines
        line.delete(ln)
    liqLines.clear()
    for lb in liqLabels
        label.delete(lb)
    liqLabels.clear()
    drawn=0
    for [idx,pool] in liqPools
        if not pool.swept and drawn<i_liqMaxPools
            c=pool.isHigh?i_liqBullCol:i_liqBearCol, w=math.min(pool.touches,4)
            liqLines.push(line.new(pool.firstBar,pool.level,bar_index+30,pool.level,color=c,style=line.style_dotted,width=w))
            liqLabels.push(label.new(bar_index+31,pool.level,(pool.isHigh?"BSL":"SSL")+" ×"+str.tostring(pool.touches),color=color(na),textcolor=c,style=label.style_label_left,size=size.tiny))
            drawn+=1

// SMT
smH = request.security(smtSym,timeframe.period,high,lookahead=barmerge.lookahead_off)
smL = request.security(smtSym,timeframe.period,low,lookahead=barmerge.lookahead_off)
goldRet = close!=0 and close[1]!=0?math.log(close/close[1]):0
smtRet = smH!=0 and smH[1]!=0?math.log(((smH+smL)/2)/((smH[1]+smL[1])/2)):0
smtCorr = ta.correlation(goldRet, smtRet, 20)
smtCorrValid = smtCorr < -0.2
gPH=ta.pivothigh(high,i_smtLen,i_smtLen), gPL=ta.pivotlow(low,i_smtLen,i_smtLen)
currGoldPH=ta.valuewhen(not na(gPH),high[i_smtLen],0), prevGoldPH=ta.valuewhen(not na(gPH),high[i_smtLen],1)
currDxyAtGPH=ta.valuewhen(not na(gPH),smL[i_smtLen],0), prevDxyAtGPH=ta.valuewhen(not na(gPH),smL[i_smtLen],1)
currGoldPL=ta.valuewhen(not na(gPL),low[i_smtLen],0), prevGoldPL=ta.valuewhen(not na(gPL),low[i_smtLen],1)
currDxyAtGPL=ta.valuewhen(not na(gPL),smH[i_smtLen],0), prevDxyAtGPL=ta.valuewhen(not na(gPL),smH[i_smtLen],1)
var bool smtB=false, var bool smtS=false
smtB:=false, smtS:=false
if not na(gPH) and not na(prevGoldPH) and not na(prevDxyAtGPH) and smtCorrValid
    if currGoldPH>prevGoldPH and currDxyAtGPH>=prevDxyAtGPH
        smtS:=true
if not na(gPL) and not na(prevGoldPL) and not na(prevDxyAtGPL) and smtCorrValid
    if currGoldPL<prevGoldPL and currDxyAtGPL<=prevDxyAtGPL
        smtB:=true
if i_showSMT and smtB and drawOK
    label.new(bar_index-i_smtLen,low[i_smtLen],"SMT▲",color=color.new(#00BCD4,15),textcolor=color.white,style=label.style_label_up,size=size.small)
if i_showSMT and smtS and drawOK
    label.new(bar_index-i_smtLen,high[i_smtLen],"SMT▼",color=color.new(#E040FB,15),textcolor=color.white,style=label.style_label_down,size=size.small)

// OTE zones
var float oteBullHi=na,var float oteBullLo=na,var float oteBearHi=na,var float oteBearLo=na
var int oteBar=na, var int oteBias=0
if isDispBull and anyBosB
    dispLo=low[1]<low?low[1]:math.min(low,nz(low[2],low))
    oteBullHi:=high-(high-dispLo)*0.62, oteBullLo:=high-(high-dispLo)*0.79
    oteBar:=bar_index, oteBias:=1
if isDispBear and anyBosS
    dispHi=high[1]>high?high[1]:math.max(high,nz(high[2],high))
    oteBearLo:=low+(dispHi-low)*0.62, oteBearHi:=low+(dispHi-low)*0.79
    oteBar:=bar_index, oteBias:=-1
oteActive = not na(oteBar) and (bar_index-oteBar)<30
oteReaction = (oteActive and oteBias==1 and not na(oteBullHi) and low<=oteBullHi and low>=oteBullLo) or (oteActive and oteBias==-1 and not na(oteBearHi) and high>=oteBearLo and high<=oteBearHi)
var box oteBox=na
if i_showOTE and barstate.islast and oteActive
    box.delete(oteBox)
    if oteBias==1 and not na(oteBullHi)
        oteBox:=box.new(nz(oteBar,bar_index),oteBullHi,bar_index+10,oteBullLo,bgcolor=color.new(#00E5FF,88),border_color=color.new(#00E5FF,40),border_width=2,text="OTE",text_color=color.new(#00E5FF,20),text_size=size.tiny)
    else if oteBias==-1 and not na(oteBearHi)
        oteBox:=box.new(nz(oteBar,bar_index),oteBearHi,bar_index+10,oteBearLo,bgcolor=color.new(#FF5722,88),border_color=color.new(#FF5722,40),border_width=2,text="OTE",text_color=color.new(#FF5722,20),text_size=size.tiny)

// ═══════════════════════════════════════════════════════
// v25: ZONE AGGREGATION + STACKING COUNT
// ═══════════════════════════════════════════════════════
anyBullZone = h1BR or zBullFVM or ifvBullR or breakerBullR or oteReaction or intOBBullR or swgOBBullR or retestBullR
anyBearZone = h1SR or zBearFVM or ifvBearR or breakerBearR or oteReaction or intOBBearR or swgOBBearR or retestBearR

zoneStackBull = (h1BR?1:0)+(zBullFVM?1:0)+(ifvBullR?1:0)+(breakerBullR?1:0)+((oteReaction and oteBias==1)?1:0)+(intOBBullR?1:0)+(swgOBBullR?1:0)+(retestBullR?1:0)
zoneStackBear = (h1SR?1:0)+(zBearFVM?1:0)+(ifvBearR?1:0)+(breakerBearR?1:0)+((oteReaction and oteBias==-1)?1:0)+(intOBBearR?1:0)+(swgOBBearR?1:0)+(retestBearR?1:0)

stackModBull = zoneStackBull>=3 ? -2 : zoneStackBull>=2 ? -1 : 0
stackModBear = zoneStackBear>=3 ? -2 : zoneStackBear>=2 ? -1 : 0

shiftBull = close>open and body>avgBodyRef*rDisplMult and cloc>60
shiftBear = close<open and body>avgBodyRef*rDisplMult and cloc<40

dqBull = (shiftBull?2:0)+((fBG>0 and fBG>=fvMin)?2:0)+(volR>=1.5?1:0)+(inActive?1:0)+(anyBosB?2:0)+(swpBullValid?2:0)+(cloc>80?1:0)
dqBull := math.min(dqBull, 10)
dqBear = (shiftBear?2:0)+((fSG>0 and fSG>=fvMin)?2:0)+(volR>=1.5?1:0)+(inActive?1:0)+(anyBosS?2:0)+(swpBearValid?2:0)+(cloc<20?1:0)
dqBear := math.min(dqBear, 10)

zName = retestBullR or retestBearR ? "BOS RETEST" : h1BR or h1SR ? "1H OB" : intOBBullR or intOBBearR ? "INT OB" : swgOBBullR or swgOBBearR ? "SWG OB" : zBullFVM or zBearFVM ? "FVG" : ifvBullR or ifvBearR ? "IFVG" : breakerBullR or breakerBearR ? "BREAKER" : oteReaction ? "OTE" : swpBullValid or swpBearValid ? swpSource : "Zone"

// ═══════════════════════════════════════════════════════
// v25: MULTI-BAR ZONE CONTACT MEMORY (array of contacts)
// ═══════════════════════════════════════════════════════
var array<zoneContact> zoneContacts = array.new<zoneContact>()
maxContacts = i_zoneMemBars * 2

// When zone contact happens, store it
if anyBullZone
    array.unshift(zoneContacts, zoneContact.new(na, na, close, bar_index, 1, zName, false, ZRS_bull))
if anyBearZone
    array.unshift(zoneContacts, zoneContact.new(na, na, close, bar_index, -1, zName, false, ZRS_bear))
// Remove old contacts
for i = array.size(zoneContacts)-1 to 0
    if bar_index - array.get(zoneContacts, i).contactBar > i_zoneMemBars
        array.remove(zoneContacts, i)
// Keep size manageable
while array.size(zoneContacts) > maxContacts
    array.pop(zoneContacts)

// Effective ZRS: best score among active contacts
effectiveZRS_bull = 0.0
effectiveZRS_bear = 0.0
for contact in zoneContacts
    if contact.dir == 1
        effectiveZRS_bull := math.max(effectiveZRS_bull, contact.zrs)
    else
        effectiveZRS_bear := math.max(effectiveZRS_bear, contact.zrs)

// v25: Effective ZRS threshold with all modulations
effThreshBull = math.max(1, i_zrsThresh + pdModBull + stackModBull + (isChop ? 2 : 0) + (not sessEstablished ? 2 : 0))
effThreshBear = math.max(1, i_zrsThresh + pdModBear + stackModBear + (isChop ? 2 : 0) + (not sessEstablished ? 2 : 0))

// ═══════════════════════════════════════════════════════
// MOVE EXHAUSTION (improved anchor)
// ═══════════════════════════════════════════════════════
var float moveAnchorPrice=na, var int moveAnchorDir=0, var int moveSignalCount=0
moveDistance = not na(moveAnchorPrice)?math.abs(close-moveAnchorPrice):0.0
moveATRs = (not na(atr14) and atr14>0)?moveDistance/atr14:0.0
moveExhausted = i_moveExhaust and (moveATRs>i_moveATRLimit or moveSignalCount>4)

// ═══════════════════════════════════════════════════════
// STRUCTURE ALIGNMENT (unchanged)
// ═══════════════════════════════════════════════════════
structAligned_bull = swingTrend.bias == BULLISH_C or (swingTrend.bias == BEARISH_C and intBullCHCount >= 2)
structAligned_bear = swingTrend.bias == BEARISH_C or (swingTrend.bias == BULLISH_C and intBearCHCount >= 2)
structPenaltyBull = structAligned_bull ? 0 : (swingTrend.bias == BEARISH_C and intBullCHCount == 1) ? 3 : 1
structPenaltyBear = structAligned_bear ? 0 : (swingTrend.bias == BULLISH_C and intBearCHCount == 1) ? 3 : 1

// ═══════════════════════════════════════════════════════
// HP SCORING (unchanged)
// ═══════════════════════════════════════════════════════
hpBullC = (inSB?2:0)+(volR>=1.5?1:0)+(arsiBull?1:0)+(nearLo?2:0)+(extDisc?2:0)+(smtB?3:0)+(pressShiftBull?2:0)+(viConvBull?1:0)+(possibilityBuy?2:0)+(anyDivBull?2:0)+(flowBull?1:0)+(timeScore>=4?2:timeScore>=2?1:0)+(dqBull>=7?2:dqBull>=5?1:0)+(ibBrokenUp?1:0)+(breakerBullR?2:0)+((oteReaction and oteBias==1)?2:0)
hpBullC += math.round(ZRS_bull >= 8 ? 3 : ZRS_bull >= 6 ? 2 : ZRS_bull >= 4 ? 1 : 0)
hpBullC += zoneStackBull >= 3 ? 4 : zoneStackBull >= 2 ? 2 : 0
hpBullC += retestBullR ? 2 : 0
hpBullC -= isChop ? 3 : 0
hpBullC -= strongSP ? 1 : 0
hpBullC -= arsiBear ? 1 : 0
hpBullC -= adrExhausted ? 3 : 0
hpBullC -= cumDeltaDivBear ? 1 : 0
hpBullC -= moveExhausted and moveAnchorDir==1 ? 4 : 0
hpBullC -= softBlockBuy ? 2 : 0
hpBullC -= structPenaltyBull

hpBearC = (inSB?2:0)+(volR>=1.5?1:0)+(arsiBear?1:0)+(nearHi?2:0)+(extPrem?2:0)+(smtS?3:0)+(pressShiftBear?2:0)+(viConvBear?1:0)+(possibilitySell?2:0)+(anyDivBear?2:0)+(flowBear?1:0)+(timeScore>=4?2:timeScore>=2?1:0)+(dqBear>=7?2:dqBear>=5?1:0)+(ibBrokenDn?1:0)+(breakerBearR?2:0)+((oteReaction and oteBias==-1)?2:0)
hpBearC += math.round(ZRS_bear >= 8 ? 3 : ZRS_bear >= 6 ? 2 : ZRS_bear >= 4 ? 1 : 0)
hpBearC += zoneStackBear >= 3 ? 4 : zoneStackBear >= 2 ? 2 : 0
hpBearC += retestBearR ? 2 : 0
hpBearC -= isChop ? 3 : 0
hpBearC -= strongBP ? 1 : 0
hpBearC -= arsiBull ? 1 : 0
hpBearC -= adrExhausted ? 3 : 0
hpBearC -= cumDeltaDivBull ? 1 : 0
hpBearC -= moveExhausted and moveAnchorDir==-1 ? 4 : 0
hpBearC -= softBlockSell ? 2 : 0
hpBearC -= structPenaltyBear

// ═══════════════════════════════════════════════════════
// SIGNAL ENGINE — Two-Phase with ZRS + Multi-Bar Memory
// ═══════════════════════════════════════════════════════
var int lastBuyBar=0, var int lastSellBar=0, var float lastBuyPrice=na, var float lastSellPrice=na
confirmedBar = barstate.isconfirmed
sessOK = not i_sessFilter or inActive

cdBuyBase = i_dirCooldown ? adaptCD*3 : adaptCD, cdSellBase = i_dirCooldown ? adaptCD*3 : adaptCD
cdBuyOK = (bar_index-lastBuyBar)>=cdBuyBase and (bar_index-lastSellBar)>=adaptCD
cdSellOK = (bar_index-lastSellBar)>=cdSellBase and (bar_index-lastBuyBar)>=adaptCD
distBuyOK = na(lastBuyPrice) or math.abs(close-lastBuyPrice)>atr14*1.5
distSellOK = na(lastSellPrice) or math.abs(close-lastSellPrice)>atr14*1.5

sweepIntoZoneBull = swpBullValid and anyBullZone
sweepIntoZoneBear = swpBearValid and anyBearZone

zoneActive_bull = array.size(zoneContacts) > 0 and any(zoneContacts, c => c.dir == 1)
zoneActive_bear = array.size(zoneContacts) > 0 and any(zoneContacts, c => c.dir == -1)

zoneEntryBuy  = i_useZoneEntry and zoneActive_bull and biasAllowBuy and sessOK and confirmedBar and cdBuyOK and distBuyOK and not adrBlockBuy and (effectiveZRS_bull >= effThreshBull or sweepIntoZoneBull)
zoneEntrySell = i_useZoneEntry and zoneActive_bear and biasAllowSell and sessOK and confirmedBar and cdSellOK and distSellOK and not adrBlockSell and (effectiveZRS_bear >= effThreshBear or sweepIntoZoneBear)

classicBuy  = not i_useZoneEntry and anyBullZone and biasAllowBuy and shiftBull and cdBuyOK and distBuyOK and sessOK and confirmedBar and not adrBlockBuy
classicSell = not i_useZoneEntry and anyBearZone and biasAllowSell and shiftBear and cdSellOK and distSellOK and sessOK and confirmedBar and not adrBlockSell

// Pending signal tracking
var float pendBuyPrice=na, var int pendBuyBar=0, var bool pendBuyActive=false, var int pendBuyHP=0
var float pendSellPrice=na, var int pendSellBar=0, var bool pendSellActive=false, var int pendSellHP=0
var string pendBuyZone="", var string pendSellZone=""

if zoneEntryBuy and not pendBuyActive
    // Use the most recent contact's price
    bestContact = array.get(zoneContacts, array.indexof(zoneContacts, c => c.dir == 1))
    pendBuyPrice := not na(bestContact) ? bestContact.contactPrice : close
    pendBuyBar:=bar_index, pendBuyActive:=true, pendBuyHP:=hpBullC
    pendBuyZone:=not na(bestContact) ? bestContact.zoneName : zName
    // Remove the contact used to avoid double use
    for i = array.size(zoneContacts)-1 to 0
        if array.get(zoneContacts, i).dir == 1
            array.remove(zoneContacts, i)
            break
    if drawOK
        label.new(bar_index,low,"◆ PENDING BUY\n"+pendBuyZone+" ZRS:"+str.tostring(effectiveZRS_bull,"#")+(zoneStackBull>=2?" STACK×"+str.tostring(zoneStackBull):"")+"\nEntry: "+str.tostring(pendBuyPrice,"#.#"),style=label.style_label_up,color=color.new(#00E5FF,20),textcolor=color.white,size=size.small,yloc=yloc.belowbar)

if zoneEntrySell and not pendSellActive
    bestContact = array.get(zoneContacts, array.indexof(zoneContacts, c => c.dir == -1))
    pendSellPrice := not na(bestContact) ? bestContact.contactPrice : close
    pendSellBar:=bar_index, pendSellActive:=true, pendSellHP:=hpBearC
    pendSellZone:=not na(bestContact) ? bestContact.zoneName : zName
    for i = array.size(zoneContacts)-1 to 0
        if array.get(zoneContacts, i).dir == -1
            array.remove(zoneContacts, i)
            break
    if drawOK
        label.new(bar_index,high,"◆ PENDING SELL\n"+pendSellZone+" ZRS:"+str.tostring(effectiveZRS_bear,"#")+(zoneStackBear>=2?" STACK×"+str.tostring(zoneStackBear):"")+"\nEntry: "+str.tostring(pendSellPrice,"#.#"),style=label.style_label_down,color=color.new(#FF6D00,20),textcolor=color.white,size=size.small,yloc=yloc.abovebar)

// Validation
var bool validatedBuy=false, var bool validatedSell=false
var bool invalidatedBuy=false, var bool invalidatedSell=false
validatedBuy:=false, validatedSell:=false, invalidatedBuy:=false, invalidatedSell:=false

if pendBuyActive
    elapsed=bar_index-pendBuyBar
    if elapsed>0 and elapsed<=adaptPendBars
        if isDispBull
            validatedBuy:=true, pendBuyActive:=false
            pendBuyHP:=pendBuyHP+(shiftBull?2:0)+(dqBull>=5?1:0)
        else if not na(pendBuyPrice) and close<pendBuyPrice-atr14*0.5
            invalidatedBuy:=true, pendBuyActive:=false
    else if elapsed>adaptPendBars
        invalidatedBuy:=true, pendBuyActive:=false

if pendSellActive
    elapsed2=bar_index-pendSellBar
    if elapsed2>0 and elapsed2<=adaptPendBars
        if isDispBear
            validatedSell:=true, pendSellActive:=false
            pendSellHP:=pendSellHP+(shiftBear?2:0)+(dqBear>=5?1:0)
        else if not na(pendSellPrice) and close>pendSellPrice+atr14*0.5
            invalidatedSell:=true, pendSellActive:=false
    else if elapsed2>adaptPendBars
        invalidatedSell:=true, pendSellActive:=false

// Final signal
BUY = validatedBuy or classicBuy
SELL = validatedSell or classicSell

finalHPBull = validatedBuy?pendBuyHP:hpBullC, finalHPBear = validatedSell?pendSellHP:hpBearC
HP_BUY = BUY and finalHPBull>=rHPThresh, HP_SELL = SELL and finalHPBear>=rHPThresh

gradeB = finalHPBull>=rHPThresh+3?"A+":finalHPBull>=rHPThresh?"A":finalHPBull>=rHPThresh-2?"B":"C"
gradeS = finalHPBear>=rHPThresh+3?"A+":finalHPBear>=rHPThresh?"A":finalHPBear>=rHPThresh-2?"B":"C"
grade = BUY?gradeB:SELL?gradeS:""
float entryPrice = BUY?(validatedBuy and not na(pendBuyPrice)?pendBuyPrice:close):SELL?(validatedSell and not na(pendSellPrice)?pendSellPrice:close):na

setupName = validatedBuy or validatedSell ? "ZONE ENTRY ✓" : retestBullR or retestBearR ? "BOS RETEST" : sweepIntoZoneBull or sweepIntoZoneBear ? "SWEEP+ZONE" : "ZONE TAP"
hasFlow = (BUY and flowBull) or (SELL and flowBear)
flowTag = hasFlow?" +FLOW":""
stackTag = (BUY and zoneStackBull>=2)?" STK×"+str.tostring(zoneStackBull):(SELL and zoneStackBear>=2)?" STK×"+str.tostring(zoneStackBear):""
zrsTag = validatedBuy?" ZRS:"+str.tostring(ZRS_bull,"#"):validatedSell?" ZRS:"+str.tostring(ZRS_bear,"#"):""
entTxt = not na(entryPrice)?"\nEntry: "+str.tostring(entryPrice,"#.#"):""
dqTxt = BUY?"\nDQ:"+str.tostring(dqBull):SELL?"\nDQ:"+str.tostring(dqBear):""
usedZoneName = validatedBuy?pendBuyZone:validatedSell?pendSellZone:zName

// Update cooldown + move tracker
if BUY
    lastBuyBar:=bar_index, lastBuyPrice:=nz(entryPrice,close)
    if moveAnchorDir!=1
        moveAnchorPrice:=nz(entryPrice,close), moveAnchorDir:=1, moveSignalCount:=1
    else
        moveSignalCount+=1
if SELL
    lastSellBar:=bar_index, lastSellPrice:=nz(entryPrice,close)
    if moveAnchorDir!=-1
        moveAnchorPrice:=nz(entryPrice,close), moveAnchorDir:=-1, moveSignalCount:=1
    else
        moveSignalCount+=1

// ═══════════════════════════════════════════════════════
// SIGNAL LABELS + TP/SL BOXES (enhanced with trailing)
// ═══════════════════════════════════════════════════════
if HP_BUY and drawOK
    label.new(bar_index,low,"★ "+grade+" BUY"+flowTag+zrsTag+stackTag+"\n"+setupName+" | "+usedZoneName+entTxt+dqTxt,style=label.style_label_up,color=color.green,textcolor=color.white,size=size.normal,yloc=yloc.belowbar)
else if BUY and drawOK
    label.new(bar_index,low,grade+" BUY"+flowTag+"\n"+setupName+" | "+usedZoneName+entTxt,style=label.style_label_up,color=color.new(color.green,40),textcolor=color.white,size=size.small,yloc=yloc.belowbar)
if HP_SELL and drawOK
    label.new(bar_index,high,"★ "+grade+" SELL"+flowTag+zrsTag+stackTag+"\n"+setupName+" | "+usedZoneName+entTxt+dqTxt,style=label.style_label_down,color=color.red,textcolor=color.white,size=size.normal,yloc=yloc.abovebar)
else if SELL and drawOK
    label.new(bar_index,high,grade+" SELL"+flowTag+"\n"+setupName+" | "+usedZoneName+entTxt,style=label.style_label_down,color=color.new(color.red,40),textcolor=color.white,size=size.small,yloc=yloc.abovebar)

// v25: TP/SL BOX VISUALIZATION with trailing
if i_showTPSL and (BUY or SELL) and not na(entryPrice) and drawOK
    eP = entryPrice
    slDist = atr14 * 0.5   // SL = 0.5 ATR beyond entry
    if BUY
        slLevel = eP - slDist
        tp1 = eP + slDist * 1.5
        tp2 = eP + slDist * 2.5
        tp3 = not na(nearestBSL) and nearestBSL > eP ? nearestBSL : eP + slDist * 4
        // SL box (red)
        box.new(bar_index, eP, bar_index+20, slLevel, bgcolor=color.new(#FF1744,90), border_color=color.new(#FF1744,40), border_width=1)
        // TP1 box (light green)
        box.new(bar_index, tp1, bar_index+20, eP, bgcolor=color.new(#00E676,92), border_color=color.new(#00E676,50), border_width=1)
        // TP lines
        line.new(bar_index, tp2, bar_index+25, tp2, color=color.new(#00E676,30), style=line.style_dashed, width=1)
        line.new(bar_index, tp3, bar_index+30, tp3, color=color.new(#FFD700,30), style=line.style_solid, width=2)
        // Trailing stop by structure if enabled
        if i_useTrailing
            // Find highest low since entry (or last swing low)
            swingLowSince = ta.lowest(low, bar_index - lastBuyBar + 1)
            // Use the most recent higher low (simplified: just use the lowest low since entry)
            trailStop = swingLowSince - atr14 * i_trailATRMult
            // Draw trailing line (optional)
            line.new(bar_index, trailStop, bar_index+15, trailStop, color=color.new(#FFD700,40), style=line.style_dashed, width=1)
    else
        slLevel = eP + slDist
        tp1 = eP - slDist * 1.5
        tp2 = eP - slDist * 2.5
        tp3 = not na(nearestSSL) and nearestSSL < eP ? nearestSSL : eP - slDist * 4
        box.new(bar_index, slLevel, bar_index+20, eP, bgcolor=color.new(#FF1744,90), border_color=color.new(#FF1744,40), border_width=1)
        box.new(bar_index, eP, bar_index+20, tp1, bgcolor=color.new(#00E676,92), border_color=color.new(#00E676,50), border_width=1)
        line.new(bar_index, tp2, bar_index+25, tp2, color=color.new(#00E676,30), style=line.style_dashed, width=1)
        line.new(bar_index, tp3, bar_index+30, tp3, color=color.new(#FFD700,30), style=line.style_solid, width=2)
        if i_useTrailing
            swingHighSince = ta.highest(high, bar_index - lastSellBar + 1)
            trailStop = swingHighSince + atr14 * i_trailATRMult
            line.new(bar_index, trailStop, bar_index+15, trailStop, color=color.new(#FFD700,40), style=line.style_dashed, width=1)

// Entry line
if (BUY or SELL) and not na(entryPrice) and drawOK
    eCol = BUY?color.new(#00E676,30):color.new(#FF1744,30)
    line.new(bar_index,entryPrice,bar_index+15,entryPrice,color=eCol,style=line.style_dashed,width=2)

// Scratch labels
if invalidatedBuy and drawOK
    label.new(bar_index,low,"✕ SCRATCH",style=label.style_label_up,color=color.new(#546E7A,30),textcolor=color.gray,size=size.tiny,yloc=yloc.belowbar)
if invalidatedSell and drawOK
    label.new(bar_index,high,"✕ SCRATCH",style=label.style_label_down,color=color.new(#546E7A,30),textcolor=color.gray,size=size.tiny,yloc=yloc.abovebar)

// ═══════════════════════════════════════════════════════
// WIN-RATE TRACKER (unchanged)
// ═══════════════════════════════════════════════════════
var int wrTotalBuy=0,var int wrWinBuy=0,var int wrTotalSell=0,var int wrWinSell=0,var int wrTotalHP=0,var int wrWinHP=0
var float wrLastEntry=na,var int wrLastDir=0,var int wrLastBar=0,var float wrLastATR=na
if not na(wrLastEntry) and wrLastDir!=0 and (bar_index-wrLastBar)>0 and (bar_index-wrLastBar)<=50
    target1R=nz(wrLastATR,atr14)
    if wrLastDir==1
        if high>=wrLastEntry+target1R
            wrWinBuy+=1, wrLastDir:=0
        else if low<=wrLastEntry-target1R
            wrLastDir:=0
    else
        if low<=wrLastEntry-target1R
            wrWinSell+=1, wrLastDir:=0
        else if high>=wrLastEntry+target1R
            wrLastDir:=0
if not na(wrLastEntry) and wrLastDir!=0 and (bar_index-wrLastBar)>50
    wrLastDir:=0
if BUY
    wrTotalBuy+=1, wrLastEntry:=nz(entryPrice,close), wrLastDir:=1, wrLastBar:=bar_index, wrLastATR:=atr14
    if HP_BUY
        wrTotalHP+=1
if SELL
    wrTotalSell+=1, wrLastEntry:=nz(entryPrice,close), wrLastDir:=-1, wrLastBar:=bar_index, wrLastATR:=atr14
    if HP_SELL
        wrTotalHP+=1
wrTotal=wrTotalBuy+wrTotalSell, wrWins=wrWinBuy+wrWinSell
wrPct = wrTotal>0?wrWins*100.0/wrTotal:0
wrHPPct = wrTotalHP>0?wrWinHP*100.0/wrTotalHP:0

// ═══════════════════════════════════════════════════════
// PLOTS (unchanged)
// ═══════════════════════════════════════════════════════
plot(i_showEMA?eF:na,"EMA F",color.new(#2196F3,20),1)
plot(i_showEMA?eM:na,"EMA M",color.new(#FF9800,20),2)
plot(i_showEMA?eS:na,"EMA S",color.new(#9E9E9E,40),1,plot.style_cross)
plot(i_showEMA?e200:na,"EMA200",color.new(#E040FB,30),2,plot.style_cross)
plot(i_showVWAP?vwap:na,"VWAP",color.new(color.purple,30),2)
plot(i_showPDHL?pdh:na,"PDH",color.new(#4CAF50,50),1,plot.style_line,true)
plot(i_showPDHL?pdl:na,"PDL",color.new(#F44336,50),1,plot.style_line,true)
plot(stV,"ST",stBull?color.new(#4CAF50,60):color.new(#F44336,60),1,plot.style_linebr)
plot(i_showDOpen?dOpen:na,"DO",color.new(#FFD700,40),1,plot.style_stepline_diamond)
plot(i_showDOpen?wOpen:na,"WO",color.new(#E040FB,40),1,plot.style_stepline_diamond)
plot(i_showPDZ?swMid:na,"EQ",color.new(#FFD700,50),1,plot.style_cross)
plotshape(HP_BUY,title="HP BUY",location=location.belowbar,color=#00E676,style=shape.triangleup,size=size.normal)
plotshape(HP_SELL,title="HP SELL",location=location.abovebar,color=#FF1744,style=shape.triangledown,size=size.normal)
plotshape(zoneEntryBuy and i_useZoneEntry,title="PEND BUY",location=location.belowbar,color=color.new(#00E5FF,30),style=shape.diamond,size=size.small)
plotshape(zoneEntrySell and i_useZoneEntry,title="PEND SELL",location=location.abovebar,color=color.new(#FF6D00,30),style=shape.diamond,size=size.small)
bgcolor(i_showSessBG and inSB?color.new(#FFD700,88):i_showSessBG and inKZ?color.new(color.yellow,i_sessBGTransp):i_showSessBG and inLN?color.new(i_londonCol,i_sessBGTransp+3):i_showSessBG and inNY?color.new(i_nyCol,i_sessBGTransp+3):i_showSessBG and inTK?color.new(i_tokyoCol,i_sessBGTransp+3):na)
bgcolor(i_showPDZ and extPrem?color.new(i_premCol,85):i_showPDZ and extDisc?color.new(i_discCol,85):na)
barcolor(HP_BUY?#00E676:HP_SELL?#FF1744:BUY?color.new(#4CAF50,40):SELL?color.new(#F44336,40):na)

// ═══════════════════════════════════════════════════════
// DASHBOARD (updated to reflect v25 features)
// ═══════════════════════════════════════════════════════
CB=color.new(#080818,0),CB2=color.new(#10102A,0),CBR=color.new(#1E1E4A,20)
CL=#546E7A,CT=#CFD8DC,CG=#00E676,CR=#FF1744,CGD=#FFD700,CCY=#00E5FF,CW=#FF9100,CM=#37474F

if i_showDash and barstate.islast
    var table D=table.new(position.top_right,4,14,border_color=CBR,bgcolor=CB,border_width=1)
    table.cell(D,0,0,"◈ QUANTUM",text_color=CGD,bgcolor=color.new(#0D0D22,0),text_size=size.normal,text_halign=text.align_right)
    table.cell(D,1,0,"FLOW",text_color=CCY,bgcolor=color.new(#0D0D22,0),text_size=size.normal)
    table.cell(D,2,0,"v25.0",text_color=CGD,bgcolor=color.new(#0D0D22,0),text_size=size.normal)
    table.cell(D,3,0,rProfName,text_color=CM,bgcolor=color.new(#0D0D22,0),text_size=size.small)
    bC=combBias>=50?CG:combBias>=20?#4CAF50:combBias<=-50?CR:combBias<=-20?#F44336:CM
    bBG=combBias>=50?color.new(CG,82):combBias<=-50?color.new(CR,82):color.new(CM,92)
    table.cell(D,0,1,"BIAS",text_color=CT,bgcolor=bBG,text_size=size.small,text_halign=text.align_left)
    table.cell(D,1,1,biasTxt+(hardBlockBuy?" 🔒BUY":hardBlockSell?" 🔒SELL":""),text_color=bC,bgcolor=bBG,text_size=size.normal)
    table.cell(D,2,1,htfLabel+(htfBias>0?"+":"")+str.tostring(htfBias),text_color=CT,bgcolor=bBG,text_size=size.small)
    table.cell(D,3,1,ltfLabel+(ltfBias>0?"+":"")+str.tostring(ltfBias)+(biasFlip?" ⚠":""),text_color=biasFlip?CW:CT,bgcolor=bBG,text_size=size.small)
    swgT=swingTrend.bias==BULLISH_C?"BULL ▲":swingTrend.bias==BEARISH_C?"BEAR ▼":"—"
    intT=intTrend.bias==BULLISH_C?"BULL ▲":intTrend.bias==BEARISH_C?"BEAR ▼":"—"
    table.cell(D,0,2,"STRUCT",text_color=CL,bgcolor=CB2,text_size=size.small,text_halign=text.align_left)
    table.cell(D,1,2,"Swing:"+swgT,text_color=swingTrend.bias==BULLISH_C?CG:swingTrend.bias==BEARISH_C?CR:CM,bgcolor=CB2,text_size=size.small)
    table.cell(D,2,2,"Int:"+intT,text_color=intTrend.bias==BULLISH_C?CG:intTrend.bias==BEARISH_C?CR:CM,bgcolor=CB2,text_size=size.small)
    table.cell(D,3,2,possibilityBuy?"⚠BUY SHIFT":possibilitySell?"⚠SELL SHIFT":structAligned_bull and structAligned_bear?"ALIGNED":"—",text_color=possibilityBuy?#00BCD4:possibilitySell?#E040FB:CM,bgcolor=CB2,text_size=size.small)
    zT=retestBullR?"RETEST▲":retestBearR?"RETEST▼":intOBBullR?"INT OB▲":intOBBearR?"INT OB▼":h1BR?"1H OB▲":h1SR?"1H OB▼":zBullFVM?"FVG▲":zBearFVM?"FVG▼":ifvBullR?"IFVG▲":ifvBearR?"IFVG▼":breakerBullR?"BRKR▲":breakerBearR?"BRKR▼":"—"
    table.cell(D,0,3,"ZONES",text_color=CL,bgcolor=CB,text_size=size.small,text_halign=text.align_left)
    table.cell(D,1,3,zT+(zoneStackBull>=2?" STK×"+str.tostring(zoneStackBull):zoneStackBear>=2?" STK×"+str.tostring(zoneStackBear):""),text_color=intOBBullR or h1BR or zBullFVM or ifvBullR or breakerBullR or retestBullR?CG:intOBBearR or h1SR or zBearFVM or ifvBearR or breakerBearR or retestBearR?CR:CM,bgcolor=CB,text_size=size.small)
    table.cell(D,2,3,swpBullValid?"SWEPT "+swpSource:swpBearValid?"SWEPT "+swpSource:"No Sweep",text_color=swpBullValid?CG:swpBearValid?CR:CM,bgcolor=CB,text_size=size.small)
    table.cell(D,3,3,oteReaction?"OTE★":nearHi?"NEAR HI":nearLo?"NEAR LO":"—",text_color=oteReaction?CGD:nearLo?CG:nearHi?CR:CM,bgcolor=CB,text_size=size.small)
    table.cell(D,0,4,"ZRS",text_color=CL,bgcolor=CB2,text_size=size.small,text_halign=text.align_left)
    table.cell(D,1,4,"▲"+str.tostring(ZRS_bull,"#.#")+" ▼"+str.tostring(ZRS_bear,"#.#"),text_color=ZRS_bull>=7 or ZRS_bear>=7?CGD:ZRS_bull>=5 or ZRS_bear>=5?CG:CM,bgcolor=CB2,text_size=size.small)
    table.cell(D,2,4,pendBuyActive?"⏳PEND BUY":pendSellActive?"⏳PEND SELL":"—",text_color=pendBuyActive?CCY:pendSellActive?CW:CM,bgcolor=CB2,text_size=size.small)
    mvTxt=moveExhausted?"EXHAUSTED":moveATRs>3?"EXTENDED":"FRESH"
    table.cell(D,3,4,"Move:"+str.tostring(moveATRs,"#.#")+"R",text_color=moveExhausted?CR:moveATRs>3?CW:CG,bgcolor=CB2,text_size=size.small)
    table.cell(D,0,5,"REGIME",text_color=CL,bgcolor=CB,text_size=size.small,text_halign=text.align_left)
    table.cell(D,1,5,regTxt,text_color=regBull?CG:regBear?CR:isChop?CW:CM,bgcolor=CB,text_size=size.small)
    table.cell(D,2,5,wyTxt,text_color=spring or isAccum or regBull?CG:utad or isDist or regBear?CR:isManip?CW:CM,bgcolor=CB,text_size=size.small)
    table.cell(D,3,5,"ADX "+str.tostring(adx,"#"),text_color=adx>25?CG:CM,bgcolor=CB,text_size=size.small)
    table.cell(D,0,6,"VOL",text_color=CL,bgcolor=CB2,text_size=size.small,text_halign=text.align_left)
    table.cell(D,1,6,viType+" "+str.tostring(volR,"#.#")+"x",text_color=viConvBull?CG:viConvBear?CR:volR>=3?CGD:CM,bgcolor=CB2,text_size=size.small)
    table.cell(D,2,6,viBull?"STR BULL":viBear?"STR BEAR":viDoji?"DOJI":"—",text_color=viBull?CG:viBear?CR:CM,bgcolor=CB2,text_size=size.small)
    table.cell(D,3,6,pressR>55?"BUY PRESS":pressR<45?"SELL PRESS":"NEUT",text_color=pressR>55?CG:pressR<45?CR:CM,bgcolor=CB2,text_size=size.small)
    sTxt=inSB?"SILVER BULLET⚡":inKZ?"KILLZONE":inNY?"NEW YORK":inLN?"LONDON":inTK?"TOKYO":"OFF"
    sC=inSB?CGD:inKZ?CGD:inNY?#AB47BC:inLN?#4CAF50:inTK?#FF9800:CM
    pT=extPrem?"EXT PREM⚠":extDisc?"EXT DISC⚠":inPrem?"Premium":"Discount"
    table.cell(D,0,7,"SESS",text_color=CL,bgcolor=CB,text_size=size.small,text_halign=text.align_left)
    table.cell(D,1,7,sTxt,text_color=sC,bgcolor=CB,text_size=size.small)
    table.cell(D,2,7,pT+" "+str.tostring(pdPct,"#")+"%",text_color=extDisc?CG:extPrem?CR:CM,bgcolor=CB,text_size=size.small)
    table.cell(D,3,7,"ADR "+str.tostring(adrPct,"#")+"%"+(adrHardBlock?" 🔒":""),text_color=adrExhausted?CR:CM,bgcolor=CB,text_size=size.small)
    corrTxt=smtCorrValid?"INV✓":"BREAK"
    table.cell(D,0,8,"CORR",text_color=CL,bgcolor=CB2,text_size=size.small,text_halign=text.align_left)
    table.cell(D,1,8,smtSym+" "+corrTxt,text_color=smtCorrValid?CG:CW,bgcolor=CB2,text_size=size.small)
    table.cell(D,2,8,smtB?"SMT▲":smtS?"SMT▼":"—",text_color=smtB?CG:smtS?CR:CM,bgcolor=CB2,text_size=size.small)
    table.cell(D,3,8,"r:"+str.tostring(smtCorr,"#.##"),text_color=smtCorrValid?CG:CW,bgcolor=CB2,text_size=size.small)
    readTxt = HP_BUY?"★"+grade+" BUY—"+setupName+"—"+usedZoneName:HP_SELL?"★"+grade+" SELL—"+setupName+"—"+usedZoneName:BUY?"▶"+grade+" BUY—"+setupName:SELL?"▶"+grade+" SELL—"+setupName:pendBuyActive?"⏳PEND BUY—Wait Displ":pendSellActive?"⏳PEND SELL—Wait Displ":possibilityBuy?"⚠BUY SHIFTING":possibilitySell?"⚠SELL SHIFTING":isChop?"⚠CHOPPY—AVOID":"MONITORING"
    readC=HP_BUY or BUY?CG:HP_SELL or SELL?CR:pendBuyActive?CCY:pendSellActive?CW:possibilityBuy?#00BCD4:possibilitySell?#E040FB:isChop?CW:CM
    readBG=BUY or HP_BUY?color.new(CG,82):SELL or HP_SELL?color.new(CR,82):color.new(CM,92)
    table.cell(D,0,9,"READ",text_color=CT,bgcolor=readBG,text_size=size.small,text_halign=text.align_left)
    table.merge_cells(D,1,9,3,9)
    table.cell(D,1,9,readTxt,text_color=readC,bgcolor=readBG,text_size=size.normal)
    wrTxt=wrTotal>5?"WR:"+str.tostring(wrPct,"#")+"%  ("+str.tostring(wrWins)+"/"+str.tostring(wrTotal)+")":"WR: Collecting..."
    table.cell(D,0,10,"TRACK",text_color=CL,bgcolor=CB2,text_size=size.small,text_halign=text.align_left)
    table.cell(D,1,10,wrTxt,text_color=wrPct>=55?CG:wrPct>=45?CM:CR,bgcolor=CB2,text_size=size.small)
    table.cell(D,2,10,wrTotalHP>3?"HP:"+str.tostring(wrHPPct,"#")+"%":"",text_color=wrHPPct>=60?CG:CM,bgcolor=CB2,text_size=size.small)
    table.cell(D,3,10,"Sig#"+str.tostring(moveSignalCount),text_color=CM,bgcolor=CB2,text_size=size.small)
    modeTxt=i_useZoneEntry?"ZONE":"CLASSIC"
    table.cell(D,0,11,"v25",text_color=CL,bgcolor=color.new(#0D0D22,0),text_size=size.small,text_halign=text.align_left)
    table.merge_cells(D,1,11,3,11)
    table.cell(D,1,11,modeTxt+" | Gate:"+(i_hardBiasGate?"ON":"off")+" | BOS-RT:"+(i_bosRetest?"ON":"off")+" | Exhaust:"+(i_moveExhaust?"ON":"off")+" | Trail:"+(i_useTrailing?"ON":"off"),text_color=CCY,bgcolor=color.new(#0D0D22,0),text_size=size.small)
    table.cell(D,0,12,"THRESH",text_color=CL,bgcolor=CB2,text_size=size.small,text_halign=text.align_left)
    table.cell(D,1,12,"Buy:"+str.tostring(effThreshBull)+" Sell:"+str.tostring(effThreshBear),text_color=CCY,bgcolor=CB2,text_size=size.small)
    table.cell(D,2,12,"P/D:"+str.tostring(pdPct,"#")+"%",text_color=inDisc?CG:CR,bgcolor=CB2,text_size=size.small)
    table.cell(D,3,12,isChop?"CHOP+2":not sessEstablished?"DELAY+2":"BASE",text_color=isChop or not sessEstablished?CW:CM,bgcolor=CB2,text_size=size.small)
    // Additional row for trailing info
    table.cell(D,0,13,"TRAIL",text_color=CL,bgcolor=CB2,text_size=size.small,text_halign=text.align_left)
    table.cell(D,1,13,i_useTrailing?"ATR×"+str.tostring(i_trailATRMult):"OFF",text_color=CCY,bgcolor=CB2,text_size=size.small)
    table.cell(D,2,13,"Mem:"+str.tostring(i_zoneMemBars),text_color=CM,bgcolor=CB2,text_size=size.small)
    table.cell(D,3,13,"Val:"+str.tostring(adaptPendBars)+"b",text_color=CM,bgcolor=CB2,text_size=size.small)

// Market Intel (unchanged)
if i_showMI and barstate.islast
    var table MI=table.new(position.bottom_left,3,7,border_color=CBR,bgcolor=CB,border_width=1)
    table.cell(MI,0,0,"◈ MARKET",text_color=CGD,bgcolor=color.new(#0D0D22,0),text_size=size.small)
    table.cell(MI,1,0,"INTELLIGENCE",text_color=CCY,bgcolor=color.new(#0D0D22,0),text_size=size.small)
    table.cell(MI,2,0,"v25",text_color=CGD,bgcolor=color.new(#0D0D22,0),text_size=size.small)
    table.cell(MI,0,1,"Regime",text_color=CL,bgcolor=CB2,text_size=size.small,text_halign=text.align_left)
    table.cell(MI,1,1,regTxt,text_color=regBull?CG:regBear?CR:isChop?CW:CM,bgcolor=CB2,text_size=size.small)
    table.cell(MI,2,1,"ADX "+str.tostring(adx,"#.#"),text_color=adx>25?CG:CM,bgcolor=CB2,text_size=size.small)
    table.cell(MI,0,2,"Intent",text_color=CL,bgcolor=CB,text_size=size.small,text_halign=text.align_left)
    table.cell(MI,1,2,wyTxt,text_color=isAccum?#00BCD4:isDist?#FF5722:isManip?CGD:regBull?CG:regBear?CR:CM,bgcolor=CB,text_size=size.small)
    table.cell(MI,2,2,isVolExp?"VOL↑":isVolCmp?"VOL↓":"VOL—",text_color=isVolExp?CGD:isVolCmp?#AB47BC:CM,bgcolor=CB,text_size=size.small)
    bpP=math.round(pressR)
    table.cell(MI,0,3,"Press",text_color=CL,bgcolor=CB2,text_size=size.small,text_halign=text.align_left)
    table.cell(MI,1,3,str.tostring(bpP)+"%B|"+str.tostring(100-bpP)+"%S",text_color=bpP>55?CG:bpP<45?CR:CM,bgcolor=CB2,text_size=size.small)
    table.cell(MI,2,3,(cumD14>0?"Δ+":"Δ-")+(pressShiftBull?" ⚡▲":pressShiftBear?" ⚡▼":""),text_color=cumD14>0?CG:CR,bgcolor=CB2,text_size=size.small)
    bslTxt=not na(nearestBSL)?"BSL:"+str.tostring(nearestBSL,"#.#"):"BSL:—"
    sslTxt=not na(nearestSSL)?"SSL:"+str.tostring(nearestSSL,"#.#"):"SSL:—"
    table.cell(MI,0,4,"LIQ",text_color=CL,bgcolor=CB,text_size=size.small,text_halign=text.align_left)
    table.cell(MI,1,4,bslTxt,text_color=i_liqBullCol,bgcolor=CB,text_size=size.small)
    table.cell(MI,2,4,sslTxt,text_color=i_liqBearCol,bgcolor=CB,text_size=size.small)
    table.cell(MI,0,5,"Struct",text_color=CL,bgcolor=CB2,text_size=size.small,text_halign=text.align_left)
    table.cell(MI,1,5,"SW:"+(swingTrend.bias==BULLISH_C?"BULL▲":swingTrend.bias==BEARISH_C?"BEAR▼":"—"),text_color=swingTrend.bias==BULLISH_C?CG:swingTrend.bias==BEARISH_C?CR:CM,bgcolor=CB2,text_size=size.small)
    table.cell(MI,2,5,"INT:"+(intTrend.bias==BULLISH_C?"BULL▲":intTrend.bias==BEARISH_C?"BEAR▼":"—"),text_color=intTrend.bias==BULLISH_C?CG:intTrend.bias==BEARISH_C?CR:CM,bgcolor=CB2,text_size=size.small)
    mk=isManip?"⚠LIQ HUNT":possibilityBuy?"⚠BUY SHIFT":possibilitySell?"⚠SELL SHIFT":isTrend and strongBP?"STR BUY":isTrend and strongSP?"STR SELL":isAccum?"BUILD LONG":isDist?"BUILD SHORT":isChop?"⚠AVOID":"MONITOR"
    mkC=isManip?CGD:possibilityBuy?#00BCD4:possibilitySell?#E040FB:strongBP?CG:strongSP?CR:isAccum?#00BCD4:isDist?#FF5722:isChop?CW:CM
    table.cell(MI,0,6,"READ",text_color=CT,bgcolor=color.new(mkC,82),text_size=size.small,text_halign=text.align_left)
    table.merge_cells(MI,1,6,2,6)
    table.cell(MI,1,6,mk,text_color=mkC,bgcolor=color.new(mkC,82),text_size=size.small)

// ═══════════════════════════════════════════════════════
// ALERTS (unchanged)
// ═══════════════════════════════════════════════════════
alertcondition(BUY,title="BUY",message="BUY signal")
alertcondition(SELL,title="SELL",message="SELL signal")
alertcondition(HP_BUY,title="HP BUY",message="HIGH PROB BUY")
alertcondition(HP_SELL,title="HP SELL",message="HIGH PROB SELL")
alertcondition(zoneEntryBuy,title="Pending Buy",message="PENDING BUY")
alertcondition(zoneEntrySell,title="Pending Sell",message="PENDING SELL")
alertcondition(swpBullValid or swpBearValid,title="Sweep",message="Session level swept")
alertcondition(possNewB,title="Buy Shift",message="BUY SHIFT POSSIBLE")
alertcondition(possNewS,title="Sell Shift",message="SELL SHIFT POSSIBLE")

if HP_BUY
    alert("QF25 ★"+grade+" BUY|"+setupName+"|"+usedZoneName+"|Entry:"+str.tostring(nz(entryPrice),"#.#")+"|ZRS:"+str.tostring(ZRS_bull,"#")+"|STK:"+str.tostring(zoneStackBull)+"|DQ:"+str.tostring(dqBull)+"|"+biasTxt,alert.freq_once_per_bar)
else if BUY
    alert("QF25 "+grade+" BUY|"+setupName+"|"+usedZoneName+"|Entry:"+str.tostring(nz(entryPrice),"#.#")+"|"+biasTxt,alert.freq_once_per_bar)
if HP_SELL
    alert("QF25 ★"+grade+" SELL|"+setupName+"|"+usedZoneName+"|Entry:"+str.tostring(nz(entryPrice),"#.#")+"|ZRS:"+str.tostring(ZRS_bear,"#")+"|STK:"+str.tostring(zoneStackBear)+"|DQ:"+str.tostring(dqBear)+"|"+biasTxt,alert.freq_once_per_bar)
else if SELL
    alert("QF25 "+grade+" SELL|"+setupName+"|"+usedZoneName+"|Entry:"+str.tostring(nz(entryPrice),"#.#")+"|"+biasTxt,alert.freq_once_per_bar)
if zoneEntryBuy
    alert("QF25 ⏳PEND BUY|"+zName+"|ZRS:"+str.tostring(ZRS_bull,"#")+"|Entry:"+str.tostring(close,"#.#"),alert.freq_once_per_bar)
if zoneEntrySell
    alert("QF25 ⏳PEND SELL|"+zName+"|ZRS:"+str.tostring(ZRS_bear,"#")+"|Entry:"+str.tostring(close,"#.#"),alert.freq_once_per_bar)
if possNewB
    alert("QF25 ⚠BUY SIDE SHIFT POSSIBLE",alert.freq_once_per_bar)
if possNewS
    alert("QF25 ⚠SELL SIDE SHIFT POSSIBLE",alert.freq_once_per_bar)