i_smt_corr_max= input.float(-0.2, "SMT max corr",      group=GRP_T_MISC, minval=-0.9,maxval=0.0,step=0.05)
i_smt_corr_len= input.int(20,     "SMT corr len",      group=GRP_T_MISC, minval=5, maxval=100)
i_h1_obKeep   = input.int(5,      "1H OB keep N",      group=GRP_T_MISC, minval=1, maxval=15)
i_eq_keepN    = input.int(15,     "EQ swept keep N",   group=GRP_T_MISC, minval=3, maxval=50)
i_lookbk_max  = input.int(4500,   "Max lookback bars (≤ max_bars_back)", group=GRP_T_MISC, minval=500,maxval=4900)

// ═══════════════════════════════════════════════════════════════════════════
// v19 TUNE — CANDLE VOLUME LABELS (per-candle volume on the chart)
// ═══════════════════════════════════════════════════════════════════════════
GRP_T_CVOL = "═══ v19 TUNE: Candle Volume Labels ═══"
i_cv_show      = input.bool(false,        "Show Volume on Each Candle",       group=GRP_T_CVOL)
i_cv_lastBars  = input.int(40,            "Rolling window (last N bars)",     group=GRP_T_CVOL, minval=5,  maxval=300)
i_cv_format    = input.string("Auto K/M", "Format",                           group=GRP_T_CVOL, options=["Auto K/M","Raw","Ratio ×","Volume + Ratio"])
i_cv_position  = input.string("Auto",     "Position",                         group=GRP_T_CVOL, options=["Auto","Above","Below"])
i_cv_size      = input.string("tiny",     "Size",                             group=GRP_T_CVOL, options=["tiny","small","normal"])
i_cv_minVolR   = input.float(0.0,         "Min volR to show (0=all)",         group=GRP_T_CVOL, minval=0,  maxval=10, step=0.1)
i_cv_colorByR  = input.bool(true,         "Color by volume intensity",        group=GRP_T_CVOL)
i_cv_climaxCol = input.color(color.new(#F44336, 30), "Climax color",          group=GRP_T_CVOL)
i_cv_vhighCol  = input.color(color.new(#FF9800, 40), "Very High color",       group=GRP_T_CVOL)
i_cv_highCol   = input.color(color.new(#FFC107, 50), "High color",            group=GRP_T_CVOL)
i_cv_normalCol = input.color(color.new(color.gray, 70), "Normal color",       group=GRP_T_CVOL)
i_cv_textCol   = input.color(color.white, "Text color",                       group=GRP_T_CVOL)

float rDisplMult = i_shiftBodyMult > 0 ? i_shiftBodyMult : profDisplMult
int   rHPThresh  = i_hpThreshold > 0 ? i_hpThreshold : profHPThresh
string smtSym    = i_smtTicker != "" ? i_smtTicker : profCorr1
string rProfName = i_profOverride == "Auto" ? profName : i_profOverride
float rSweepTol  = i_swpTolOverride > 0.0 ? i_swpTolOverride : profSweepTol
tfSec = timeframe.in_seconds()
adaptPendBars = i_pendingBars > 0 ? i_pendingBars : (tfSec <= 300 ? i_tf_pend_ltf : tfSec <= 900 ? i_tf_pend_mid : tfSec <= 3600 ? i_tf_pend_hr : i_tf_pend_def)

var int prevDayN = na
isNewDay = false
cd = dayofmonth(time)
if na(prevDayN) or cd != prevDayN
    isNewDay := true
prevDayN := cd
atr14 = ta.atr(i_atr_short)
atr200 = ta.atr(i_atr_long)
adaptCD = math.max(2, math.round(i_cooldown * (tfSec <= 300 ? i_tf_cd_ltf : tfSec <= 900 ? i_tf_cd_mid : i_tf_cd_def)))
eF = ta.ema(close, i_emaF), eM = ta.ema(close, i_emaM)
eS = ta.ema(close, i_emaS), e200 = ta.ema(close, i_ema200)
[stV, stD] = ta.supertrend(i_st_factor, i_st_atr)
stBull = stD == 1
volSMA = ta.sma(volume, i_volsma_len)
volR = volume / math.max(volSMA, 1)
prng = high - low
cloc = prng > 0 ? 100.0 * (close - low) / prng : 50.0
body = math.abs(close - open)
avgBody10 = ta.sma(body, i_avgBodyN)
avgBody3 = (math.abs(close[1]-open[1]) + math.abs(close[2]-open[2]) + math.abs(close[3]-open[3])) / 3
avgBodyRef = math.max(avgBody3, avgBody10)
drawOK = true
var float cPV = 0.0, var float cVol = 0.0
if isNewDay
    cPV := 0.0, cVol := 0.0
cPV += volume * hl2, cVol += volume
vwap = cVol > 0 ? cPV / cVol : hl2
cumTR = ta.cum(ta.tr)
volMeasure = i_obFilter == "Atr" ? atr200 : cumTR / bar_index
bodyRatio = prng > 0 ? body / prng : 0.5
lowerWick = math.min(close, open) - low
upperWick = high - math.max(close, open)
lowerWickR = prng > 0 ? lowerWick / prng : 0
upperWickR = prng > 0 ? upperWick / prng : 0

// v18 CANDLE PATTERNS
body1 = math.abs(close[1] - open[1])
body2 = math.abs(close[2] - open[2])
bullEngulf = close[1] < open[1] and close > open and close >= open[1] and open <= close[1] and body > body1 * i_pat_engulfMult
bearEngulf = close[1] > open[1] and close < open and close <= open[1] and open >= close[1] and body > body1 * i_pat_engulfMult
b2Mid = (open[2] + close[2]) / 2
morningStar = close[2] < open[2] and body2 > avgBody10 * i_pat_starBig and body1 < body2 * i_pat_starMid and close > open and body > avgBody10 * i_pat_starClose and close > b2Mid
eveningStar = close[2] > open[2] and body2 > avgBody10 * i_pat_starBig and body1 < body2 * i_pat_starMid and close < open and body > avgBody10 * i_pat_starClose and close < b2Mid
bullPatternOK = bullEngulf or morningStar
bearPatternOK = bearEngulf or eveningStar
patternTag = bullEngulf ? "ENGULF" : morningStar ? "M.STAR" : bearEngulf ? "ENGULF" : eveningStar ? "E.STAR" : ""

var array<float> arr_highs = array.new<float>()
var array<float> arr_lows = array.new<float>()
var array<int> arr_times = array.new<int>()
var array<bool> arr_isBearCandle = array.new<bool>()
arr_highs.push(high), arr_lows.push(low), arr_times.push(time), arr_isBearCandle.push(close < open)
var array<float> arr_eqHighs = array.new<float>()
var array<int>   arr_eqHighBars = array.new<int>()
var array<bool>  arr_eqHighSwept = array.new<bool>()
var array<float> arr_eqLows = array.new<float>()
var array<int>   arr_eqLowBars = array.new<int>()
var array<bool>  arr_eqLowSwept = array.new<bool>()

// HTF BIAS
htfTF = i_biasMode == "Weekly/Daily" ? "W" : i_biasMode == "Daily/4H" ? "D" : i_biasMode == "4H/30m" ? "240" : "30"
htfC1 = request.security(syminfo.tickerid, htfTF, close[1], lookahead=barmerge.lookahead_off)
htfO1 = request.security(syminfo.tickerid, htfTF, open[1], lookahead=barmerge.lookahead_off)
htfE9 = request.security(syminfo.tickerid, htfTF, ta.ema(close,9), lookahead=barmerge.lookahead_off)
htfE21 = request.security(syminfo.tickerid, htfTF, ta.ema(close,21), lookahead=barmerge.lookahead_off)
htfCur = request.security(syminfo.tickerid, htfTF, close, lookahead=barmerge.lookahead_off)
htfCurO = request.security(syminfo.tickerid, htfTF, open, lookahead=barmerge.lookahead_off)
htfBias = (not na(htfC1) and htfC1>htfO1?i_b_htf_c1:-i_b_htf_c1) + (not na(htfCur) and htfCur>htfCurO?i_b_htf_cur:-i_b_htf_cur) + (not na(htfE9) and not na(htfE21)?(htfE9>htfE21?i_b_htf_ema:htfE9<htfE21?-i_b_htf_ema:0):0)
ltfTF = i_biasMode == "Weekly/Daily" ? "D" : i_biasMode == "Daily/4H" ? "240" : i_biasMode == "4H/30m" ? "30" : "3"
ltfC1 = request.security(syminfo.tickerid, ltfTF, close[1], lookahead=barmerge.lookahead_off)
ltfO1 = request.security(syminfo.tickerid, ltfTF, open[1], lookahead=barmerge.lookahead_off)
ltfE9 = request.security(syminfo.tickerid, ltfTF, ta.ema(close,9), lookahead=barmerge.lookahead_off)
ltfE21 = request.security(syminfo.tickerid, ltfTF, ta.ema(close,21), lookahead=barmerge.lookahead_off)
ltfCur = request.security(syminfo.tickerid, ltfTF, close, lookahead=barmerge.lookahead_off)
ltfCurO = request.security(syminfo.tickerid, ltfTF, open, lookahead=barmerge.lookahead_off)
ltfBias = (not na(ltfC1) and ltfC1>ltfO1?i_b_ltf_c1:-i_b_ltf_c1) + (not na(ltfCur) and ltfCur>ltfCurO?i_b_ltf_cur:-i_b_ltf_cur) + (not na(ltfE9) and not na(ltfE21)?(ltfE9>ltfE21?i_b_ltf_ema:ltfE9<ltfE21?-i_b_ltf_ema:0):0) + (close>e200?i_b_ltf_ema200:-i_b_ltf_ema200)
totalW = math.max(i_htfWeight + i_ltfWeight, 1)
combBias = math.round((htfBias * i_htfWeight + ltfBias * i_ltfWeight) / totalW)
htfLabel = i_biasMode == "Weekly/Daily" ? "W" : i_biasMode == "Daily/4H" ? "D" : i_biasMode == "4H/30m" ? "4H" : "30m"
ltfLabel = i_biasMode == "Weekly/Daily" ? "D" : i_biasMode == "Daily/4H" ? "4H" : i_biasMode == "4H/30m" ? "30m" : "3m"
biasTxt = combBias>=i_b_strong?"STRONG BULL":combBias>=i_b_weak?"BULL":combBias<=-i_b_strong?"STRONG BEAR":combBias<=-i_b_weak?"BEAR":"NEUTRAL"
biasIsBull = combBias >= i_b_weak, biasIsBear = combBias <= -i_b_weak
biasNeutral = not biasIsBull and not biasIsBear
sigmoidF(x) => 1.0 / (1.0 + math.exp(-x))
biasProbBuy_v17  = biasIsBull ? 1.0 : biasNeutral and i_biasNeutralOK ? 0.5 : 0.0
biasProbSell_v17 = biasIsBear ? 1.0 : biasNeutral and i_biasNeutralOK ? 0.5 : 0.0
hardBlockBuy  = i_hardBiasGate and combBias <= -i_b_hardBlock
hardBlockSell = i_hardBiasGate and combBias >= i_b_hardBlock
softBlockBuy  = combBias <= -i_b_weak and combBias > -i_b_hardBlock
softBlockSell = combBias >= i_b_weak and combBias < i_b_hardBlock
biasAllowBuy  = not hardBlockBuy and (biasIsBull or (biasNeutral and i_biasNeutralOK))
biasAllowSell = not hardBlockSell and (biasIsBear or (biasNeutral and i_biasNeutralOK))
var int prevBDir = 0
curBDir = biasIsBull ? 1 : biasIsBear ? -1 : 0
biasFlip = prevBDir != 0 and curBDir != 0 and prevBDir != curBDir
prevBDir := curBDir

arsi = ta.rsi(close, i_arsiLen)
arsiMax = ta.highest(arsi, i_arsiLB), arsiMin = ta.lowest(arsi, i_arsiLB)
arsiRng = arsiMax - arsiMin
arsiOB = arsiMax - arsiRng * i_arsiOBM, arsiOS = arsiMin + arsiRng * i_arsiOSM
arsiSlope = arsi - arsi[1]
arsiBull = i_useARSI and arsi > arsiOS and arsiSlope > 0
arsiBear = i_useARSI and arsi < arsiOB and arsiSlope < 0
arsiRegime = arsi > arsiOB ? "OB" : arsi < arsiOS ? "OS" : "MID"
dvPL = ta.pivotlow(low, i_divPvtLen, i_divPvtLen), dvPH = ta.pivothigh(high, i_divPvtLen, i_divPvtLen)
currPricePL = ta.valuewhen(not na(dvPL), low[i_divPvtLen], 0), prevPricePL = ta.valuewhen(not na(dvPL), low[i_divPvtLen], 1)
currRsiPL = ta.valuewhen(not na(dvPL), arsi[i_divPvtLen], 0), prevRsiPL = ta.valuewhen(not na(dvPL), arsi[i_divPvtLen], 1)
currIdxPL = ta.valuewhen(not na(dvPL), bar_index, 0), prevIdxPL = ta.valuewhen(not na(dvPL), bar_index, 1)
currPricePH = ta.valuewhen(not na(dvPH), high[i_divPvtLen], 0), prevPricePH = ta.valuewhen(not na(dvPH), high[i_divPvtLen], 1)
currRsiPH = ta.valuewhen(not na(dvPH), arsi[i_divPvtLen], 0), prevRsiPH = ta.valuewhen(not na(dvPH), arsi[i_divPvtLen], 1)
currIdxPH = ta.valuewhen(not na(dvPH), bar_index, 0), prevIdxPH = ta.valuewhen(not na(dvPH), bar_index, 1)
plSpan = not na(currIdxPL) and not na(prevIdxPL)?currIdxPL-prevIdxPL:9999
phSpan = not na(currIdxPH) and not na(prevIdxPH)?currIdxPH-prevIdxPH:9999
divRegBull = not na(dvPL) and not na(prevPricePL) and not na(prevRsiPL) and currPricePL<prevPricePL and currRsiPL>prevRsiPL and plSpan>0 and plSpan<=i_divMaxBars
divHidBull = not na(dvPL) and not na(prevPricePL) and not na(prevRsiPL) and currPricePL>prevPricePL and currRsiPL<prevRsiPL and plSpan>0 and plSpan<=i_divMaxBars
divRegBear = not na(dvPH) and not na(prevPricePH) and not na(prevRsiPH) and currPricePH>prevPricePH and currRsiPH<prevRsiPH and phSpan>0 and phSpan<=i_divMaxBars
divHidBear = not na(dvPH) and not na(prevPricePH) and not na(prevRsiPH) and currPricePH<prevPricePH and currRsiPH>prevRsiPH and phSpan>0 and phSpan<=i_divMaxBars
anyDivBull = divRegBull or divHidBull, anyDivBear = divRegBear or divHidBear
if i_showDiv and divRegBull and drawOK
    label.new(bar_index-i_divPvtLen,low[i_divPvtLen],"REG DIV▲",color=color.new(#00BCD4,15),textcolor=color.white,style=label.style_label_up,size=size.tiny)
if i_showDiv and divHidBull and drawOK
    label.new(bar_index-i_divPvtLen,low[i_divPvtLen],"HID DIV▲",color=color.new(#00BCD4,40),textcolor=color.white,style=label.style_label_up,size=size.tiny)
if i_showDiv and divRegBear and drawOK
    label.new(bar_index-i_divPvtLen,high[i_divPvtLen],"REG DIV▼",color=color.new(#E040FB,15),textcolor=color.white,style=label.style_label_down,size=size.tiny)
if i_showDiv and divHidBear and drawOK
    label.new(bar_index-i_divPvtLen,high[i_divPvtLen],"HID DIV▼",color=color.new(#E040FB,40),textcolor=color.white,style=label.style_label_down,size=size.tiny)

viType = volR>=i_vol_climax?"CLIMAX":volR>=i_vol_vhigh?"VERY HIGH":volR>=i_vol_high?"HIGH":volR>=i_vol_above?"ABOVE AVG":"LOW"
viBull = close>open and cloc>i_vi_bullCloc and body>prng*i_vi_bullBody
viBear = close<open and cloc<i_vi_bearCloc and body>prng*i_vi_bullBody
viDoji = body < prng * i_vi_dojiBody
viConvBull = viBull and volR>=i_vi_convVol, viConvBear = viBear and volR>=i_vi_convVol
sHL = math.max(prng, syminfo.mintick)
bPress = volume * (close - low) / sHL, sPress = volume * (high - close) / sHL
delta = bPress - sPress
cumD14 = ta.sma(delta, i_of_pressLen)
pressR = ta.sma((bPress+sPress)>0?bPress/(bPress+sPress)*100:50.0, i_of_pressLen)
strongBP = pressR>i_of_strongBP and cumD14>0, strongSP = pressR<i_of_strongSP and cumD14<0
pressR5 = ta.sma(pressR, i_of_press5Len)
pressShiftBull = pressR>i_of_shiftHi and pressR5[1]<i_of_shiftLo, pressShiftBear = pressR<i_of_shiftLo and pressR5[1]>i_of_shiftHi
flowBull = pressR>i_of_flowBull and cumD14>0 and volR>=i_of_flowVolR, flowBear = pressR<i_of_flowBear and cumD14<0 and volR>=i_of_flowVolR
var float sessCumDelta = 0.0
if isNewDay
    sessCumDelta := 0.0
sessCumDelta += delta
var float sessDeltaHi=na, var float sessPriceHi=na, var float sessDeltaLo=na, var float sessPriceLo=na
if isNewDay
    sessDeltaHi:=na, sessPriceHi:=na, sessDeltaLo:=na, sessPriceLo:=na
if high>=nz(sessPriceHi,high)
    sessPriceHi:=high, sessDeltaHi:=sessCumDelta
if low<=nz(sessPriceLo,low)
    sessPriceLo:=low, sessDeltaLo:=sessCumDelta
cumDeltaDivBear = not na(sessPriceHi) and high>=sessPriceHi and sessCumDelta<nz(sessDeltaHi)*i_of_cumDivR
cumDeltaDivBull = not na(sessPriceLo) and low<=sessPriceLo and sessCumDelta>nz(sessDeltaLo)*i_of_cumDivR

zrs_absorbBull() =>
    s = 0.0
    s += bodyRatio < i_zrs_absorb_body_strict ? 3.0 : bodyRatio < i_zrs_absorb_body_loose ? 1.5 : 0.0
    s += lowerWickR > i_zrs_absorb_wick_strict ? 2.5 : lowerWickR > i_zrs_absorb_wick_loose ? 1.5 : 0.0
    s += math.min(volR / i_zrs_absorb_vol_div, 1.0) * 2.5
    s += cloc > i_zrs_absorb_cloc ? 1.5 : 0.0
    s += (delta > 0 and delta[1] <= 0) ? 1.0 : delta > 0 ? 0.5 : 0.0
    s
zrs_absorbBear() =>
    s = 0.0
    s += bodyRatio < i_zrs_absorb_body_strict ? 3.0 : bodyRatio < i_zrs_absorb_body_loose ? 1.5 : 0.0
    s += upperWickR > i_zrs_absorb_wick_strict ? 2.5 : upperWickR > i_zrs_absorb_wick_loose ? 1.5 : 0.0
    s += math.min(volR / i_zrs_absorb_vol_div, 1.0) * 2.5
    s += cloc < (100 - i_zrs_absorb_cloc) ? 1.5 : 0.0
    s += (delta < 0 and delta[1] >= 0) ? 1.0 : delta < 0 ? 0.5 : 0.0
    s
zrs_rejectBull() =>
    wickDom = lowerWick / math.max(upperWick, syminfo.mintick)
    s = 0.0
    s += (bodyRatio >= i_zrs_reject_body_lo and bodyRatio <= i_zrs_reject_body_hi) ? 2.0 : 0.0
    s += wickDom > i_zrs_reject_wdom_strict ? 3.0 : wickDom > i_zrs_reject_wdom_loose ? 2.0 : 0.0
    s += close > open ? 2.0 : 0.0
    s += volR >= i_zrs_reject_vol ? 1.5 : 0.0
    s += cloc > i_zrs_reject_cloc ? 1.5 : 0.0
    s
zrs_rejectBear() =>
    wickDom = upperWick / math.max(lowerWick, syminfo.mintick)
    s = 0.0
    s += (bodyRatio >= i_zrs_reject_body_lo and bodyRatio <= i_zrs_reject_body_hi) ? 2.0 : 0.0
    s += wickDom > i_zrs_reject_wdom_strict ? 3.0 : wickDom > i_zrs_reject_wdom_loose ? 2.0 : 0.0
    s += close < open ? 2.0 : 0.0
    s += volR >= i_zrs_reject_vol ? 1.5 : 0.0
    s += cloc < (100 - i_zrs_reject_cloc) ? 1.5 : 0.0
    s
zrs_engulfBull() =>
    s = 0.0
    s += (close > open and body > prng * i_zrs_eng_body) ? 3.0 : 0.0
    s += (close > open[1] and close[1] < open[1]) ? 3.0 : 0.0
    s += volR >= i_zrs_eng_vol_strict ? 2.0 : volR >= i_zrs_eng_vol_loose ? 1.0 : 0.0
    s += cloc > i_zrs_eng_cloc ? 1.5 : 0.0
    s
zrs_engulfBear() =>
    s = 0.0
    s += (close < open and body > prng * i_zrs_eng_body) ? 3.0 : 0.0
    s += (close < open[1] and close[1] > open[1]) ? 3.0 : 0.0
    s += volR >= i_zrs_eng_vol_strict ? 2.0 : volR >= i_zrs_eng_vol_loose ? 1.0 : 0.0
    s += cloc < (100 - i_zrs_eng_cloc) ? 1.5 : 0.0
    s
twoBarBullRev = close[1] < open[1] and close > open and close > open[1]
twoBarBearRev = close[1] > open[1] and close < open and close < open[1]
twoBarBonusBull = twoBarBullRev ? i_zrs_twoBarBonus : 0.0
twoBarBonusBear = twoBarBearRev ? i_zrs_twoBarBonus : 0.0
climaxBonus = volR >= i_zrs_climax_hi ? i_zrs_climax_bonus_hi : volR >= i_zrs_climax_mid ? i_zrs_climax_bonus_mid : 0.0
ZRS_bull = math.max(zrs_absorbBull(), zrs_rejectBull(), zrs_engulfBull()) + twoBarBonusBull + climaxBonus
ZRS_bear = math.max(zrs_absorbBear(), zrs_rejectBear(), zrs_engulfBear()) + twoBarBonusBear + climaxBonus

[diP, diM, adx] = ta.dmi(14, 14)
bbB = ta.sma(close,20), bbD = 2.0*ta.stdev(close,20)
bbW = bbB>0?((bbB+bbD)-(bbB-bbD))/bbB*100:0.0, bbWS = ta.sma(bbW, 50)
chopI = 100.0*math.log10(ta.sma(ta.atr(1),14)*14/(ta.highest(high,14)-ta.lowest(low,14)))/math.log10(14)
dir14 = math.abs(close-close[14]), vol14 = ta.sma(math.abs(close-close[1]),14)*14
effR = vol14>0?dir14/vol14:0.0
isTrend = adx>i_reg_adx_trend and effR>i_reg_eff_trend
isChopBase = chopI>i_reg_chop_idx and adx<i_reg_chop_adx_lt
bbSqueeze = bbW < bbWS * i_reg_squeeze_r
isChop_v17 = isChopBase
isChop = isChop_v17
isRange = adx<i_reg_range_adx
regBull = isTrend and diP>diM, regBear = isTrend and diM>diP
isVolExp = bbW>bbWS*i_reg_volExp, isVolCmp = bbSqueeze
regTxt = adx>i_reg_strongTr?"STRONG TREND":isTrend?"TRENDING":isChop?"CHOPPY":isRange?"RANGING":"DEVELOPING"
sma50 = ta.sma(close, 50), rH20 = ta.highest(high, 20), rL20 = ta.lowest(low, 20)
spring = low<rL20[1] and close>rL20[1] and close>open
utad = high>rH20[1] and close<rH20[1] and close<open
rPct = close>0?(rH20-rL20)/close*100:0.0
tightR = rPct<ta.sma(rPct,50)*0.7, volDecl = volR<0.7
isAccum = tightR and volDecl and close<sma50 and isRange
isDist = tightR and volDecl and close>sma50 and isRange
isManip = spring or utad
wyTxt = spring?"SPRING ▲":utad?"UTAD ▼":isAccum?"ACCUMULATION":isDist?"DISTRIBUTION":regBull?"MARKUP ▲":regBear?"MARKDOWN ▼":"DEVELOPING"

pdh = request.security(syminfo.tickerid,"D",high[1],lookahead=barmerge.lookahead_off)
pdl = request.security(syminfo.tickerid,"D",low[1],lookahead=barmerge.lookahead_off)
dOpen = request.security(syminfo.tickerid,"D",open,lookahead=barmerge.lookahead_off)
wOpen = request.security(syminfo.tickerid,"W",open,lookahead=barmerge.lookahead_off)
dATR = request.security(syminfo.tickerid,"D",ta.atr(14),lookahead=barmerge.lookahead_off)
pdLookback = tfSec<=300?i_tf_pdlb_ltf:tfSec<=900?i_tf_pdlb_mid:tfSec<=3600?i_tf_pdlb_hr:i_tf_pdlb_def
swH_fb = ta.highest(high, pdLookback), swL_fb = ta.lowest(low, pdLookback)
var float swH_deal = na, var float swL_deal = na

dayF = ":123456"
showBox = not i_autoHide or tfSec <= 3600
inTK = not na(time(timeframe.period, i_tokyoTime+dayF, i_sessZone)) and timeframe.isintraday
inLN = not na(time(timeframe.period, i_londonTime+dayF, i_sessZone)) and timeframe.isintraday
inNY = not na(time(timeframe.period, i_nyTime+dayF, i_sessZone)) and timeframe.isintraday
tkSt = inTK and not inTK[1], tkEn = not inTK and inTK[1]
lnSt = inLN and not inLN[1], lnEn = not inLN and inLN[1]
nySt = inNY and not inNY[1], nyEn = not inNY and inNY[1]
inOvlp = inLN and inNY, inKZ = inOvlp, inActive = inTK or inLN or inNY
inSBLN = not na(time(timeframe.period,i_sbLN+dayF,i_sessZone)) and timeframe.isintraday
inSBNA = not na(time(timeframe.period,i_sbNYAM+dayF,i_sessZone)) and timeframe.isintraday
inSBNP = not na(time(timeframe.period,i_sbNYPM+dayF,i_sessZone)) and timeframe.isintraday
inSB = inSBLN or inSBNA or inSBNP
barMin = minute(time, i_sessZone), barHour = hour(time, i_sessZone)
isQuarterHour = barMin==0 or barMin==15 or barMin==30 or barMin==45
isMacroTime = (barHour==2 and barMin>=33) or (barHour==3 and barMin<=0) or (barHour==4 and barMin>=3 and barMin<=30) or (barHour==8 and barMin>=50) or (barHour==9 and barMin<=10) or (barHour==9 and barMin>=50) or (barHour==10 and barMin<=10) or (barHour==10 and barMin>=50) or (barHour==11 and barMin<=10) or (barHour==13 and barMin>=10 and barMin<=40) or (barHour==15 and barMin>=15 and barMin<=45)
timeScore = (inSB?3:inKZ?2:inActive?1:0)+(isQuarterHour?1:0)+(isMacroTime?2:0)
var int sessBarsIn = 0
if tkSt or lnSt or nySt
    sessBarsIn := 0
if inActive
    sessBarsIn += 1
sessEstablished = sessBarsIn > i_sessDelay
nyAM_window = barHour >= 13 and barHour < 17
nyPM_window = barHour >= 17 and barHour < 22
sessionPhase = inTK ? "BUILD" : inLN and not inNY ? "PENDING" : nyAM_window ? "HUNT" : nyPM_window ? "RIDE" : "DEAD"
phaseAllowsBuy_v17  = true
phaseAllowsSell_v17 = true

var float cTH=na,var float cTL=na,var float cLH=na,var float cLL=na,var float cNH=na,var float cNL=na
if tkSt
    cTH:=high, cTL:=low
else if inTK
    cTH:=math.max(nz(cTH,high),high), cTL:=math.min(nz(cTL,low),low)
if lnSt
    cLH:=high, cLL:=low
else if inLN
    cLH:=math.max(nz(cLH,high),high), cLL:=math.min(nz(cLL,low),low)
if nySt
    cNH:=high, cNL:=low
else if inNY
    cNH:=math.max(nz(cNH,high),high), cNL:=math.min(nz(cNL,low),low)
var float pTH1=na,var float pTL1=na,var float pTH2=na,var float pTL2=na,var float pTH3=na,var float pTL3=na
var float pLH1=na,var float pLL1=na,var float pLH2=na,var float pLL2=na,var float pLH3=na,var float pLL3=na
var float pNH1=na,var float pNL1=na,var float pNH2=na,var float pNL2=na,var float pNH3=na,var float pNL3=na
if tkEn and not na(cTH)
    pTH3:=pTH2,pTL3:=pTL2,pTH2:=pTH1,pTL2:=pTL1,pTH1:=cTH,pTL1:=cTL
if lnEn and not na(cLH)
    pLH3:=pLH2,pLL3:=pLL2,pLH2:=pLH1,pLL2:=pLL1,pLH1:=cLH,pLL1:=cLL
if nyEn and not na(cNH)
    pNH3:=pNH2,pNL3:=pNL2,pNH2:=pNH1,pNL2:=pNL1,pNH1:=cNH,pNL1:=cNL
ibSession = isGold?"0800-0830":(isNQ or isES)?"1430-1500":"0800-0830"
inIB = not na(time(timeframe.period, ibSession+dayF, i_sessZone)) and timeframe.isintraday
ibSt = inIB and not inIB[1]
var float ibHi=na, var float ibLo=na, var bool ibSet=false
if ibSt
    ibHi:=high, ibLo:=low, ibSet:=false
else if inIB
    ibHi:=math.max(nz(ibHi,high),high), ibLo:=math.min(nz(ibLo,low),low)
else if not inIB and inIB[1] and not na(ibHi)
    ibSet:=true
ibBrokenUp = ibSet and close>nz(ibHi), ibBrokenDn = ibSet and close<nz(ibLo)
MSD = 86400000
dLeft = math.abs(math.floor((last_bar_time-time)/MSD)), sIR = dLeft<60 and showBox
var box tkB=na, var box lnB=na, var box nyB=na
if tkSt and i_showTokyo and sIR
    tkB:=box.new(bar_index,high,bar_index+1,low,border_color=color.new(i_tokyoCol,30),bgcolor=i_tokyoCol,border_width=1,border_style=line.style_dashed)
else if inTK and i_showTokyo and sIR and not na(tkB)
    box.set_top(tkB,math.max(nz(cTH,high),high)), box.set_bottom(tkB,math.min(nz(cTL,low),low)), box.set_right(tkB,bar_index+1)
if lnSt and i_showLondon and sIR
    lnB:=box.new(bar_index,high,bar_index+1,low,border_color=color.new(i_londonCol,30),bgcolor=i_londonCol,border_width=1,border_style=line.style_dashed)
else if inLN and i_showLondon and sIR and not na(lnB)
    box.set_top(lnB,math.max(nz(cLH,high),high)), box.set_bottom(lnB,math.min(nz(cLL,low),low)), box.set_right(lnB,bar_index+1)
if nySt and i_showNY and sIR
    nyB:=box.new(bar_index,high,bar_index+1,low,border_color=color.new(i_nyCol,30),bgcolor=i_nyCol,border_width=1,border_style=line.style_dashed)
else if inNY and i_showNY and sIR and not na(nyB)
    box.set_top(nyB,math.max(nz(cNH,high),high)), box.set_bottom(nyB,math.min(nz(cNL,low),low)), box.set_right(nyB,bar_index+1)
pLS = i_prevStyle=="Solid"?line.style_solid:i_prevStyle=="Dashed"?line.style_dashed:line.style_dotted
var line lTH1=na,var line lTL1=na,var line lLH1=na,var line lLL1=na,var line lNH1=na,var line lNL1=na
if i_showPrevLines and barstate.islast
    line.delete(lTH1),line.delete(lTL1),line.delete(lLH1),line.delete(lLL1),line.delete(lNH1),line.delete(lNL1)
    ext = bar_index+50
    if not na(pTH1)
        lTH1:=line.new(bar_index-100,pTH1,ext,pTH1,color=color.new(#FF9800,30),style=pLS,width=1)
        lTL1:=line.new(bar_index-100,pTL1,ext,pTL1,color=color.new(#FF9800,30),style=pLS,width=1)
    if not na(pLH1)
        lLH1:=line.new(bar_index-100,pLH1,ext,pLH1,color=color.new(#4CAF50,30),style=pLS,width=1)
        lLL1:=line.new(bar_index-100,pLL1,ext,pLL1,color=color.new(#4CAF50,30),style=pLS,width=1)
    if not na(pNH1)
        lNH1:=line.new(bar_index-100,pNH1,ext,pNH1,color=color.new(#2196F3,30),style=pLS,width=1)
        lNL1:=line.new(bar_index-100,pNL1,ext,pNL1,color=color.new(#2196F3,30),style=pLS,width=1)

sTol = atr14 * rSweepTol
cSH(l) => not na(l) and high > l + sTol and close < l
cSL(l) => not na(l) and low < l - sTol and close > l
swpBear=false, swpBull=false
var string swpSource="", var float sweepDepth=0.0
if cSH(pTH1)
    swpBear:=true, swpSource:="Prev TK Hi", sweepDepth:=high-pTH1
else if cSH(pLH1)
    swpBear:=true, swpSource:="Prev LN Hi", sweepDepth:=high-pLH1
else if cSH(pNH1)
    swpBear:=true, swpSource:="Prev NY Hi", sweepDepth:=high-pNH1
else if i_prevDays>=2 and (cSH(pTH2) or cSH(pLH2) or cSH(pNH2))
    swpBear:=true, swpSource:="Prev D2 Hi"
else if i_prevDays>=3 and (cSH(pTH3) or cSH(pLH3) or cSH(pNH3))
    swpBear:=true, swpSource:="Prev D3 Hi"
if cSL(pTL1)
    swpBull:=true, swpSource:="Prev TK Lo", sweepDepth:=pTL1-low
else if cSL(pLL1)
    swpBull:=true, swpSource:="Prev LN Lo", sweepDepth:=pLL1-low
else if cSL(pNL1)
    swpBull:=true, swpSource:="Prev NY Lo", sweepDepth:=pNL1-low
else if i_prevDays>=2 and (cSL(pTL2) or cSL(pLL2) or cSL(pNL2))
    swpBull:=true, swpSource:="Prev D2 Lo"
else if i_prevDays>=3 and (cSL(pTL3) or cSL(pLL3) or cSL(pNL3))
    swpBull:=true, swpSource:="Prev D3 Lo"
tkLoSwept = inLN and not na(cTL) and low<cTL-sTol and close>cTL
tkHiSwept = inLN and not na(cTH) and high>cTH+sTol and close<cTH
if tkLoSwept
    swpBull:=true, swpSource:="TK Lows"
if tkHiSwept
    swpBear:=true, swpSource:="TK Highs"
lnLoSwept = inNY and not na(cLL) and low<cLL-sTol and close>cLL
lnHiSwept = inNY and not na(cLH) and high>cLH+sTol and close<cLH
if lnLoSwept
    swpBull:=true, swpSource:="LN Lows"
if lnHiSwept
    swpBear:=true, swpSource:="LN Highs"
if not na(pdh) and cSH(pdh)
    swpBear:=true, swpSource:="PDH"
if not na(pdl) and cSL(pdl)
    swpBull:=true, swpSource:="PDL"
sweepRejBull = cloc>i_swp_rejCloc_bull and lowerWickR>i_swp_rejWickR
sweepRejBear = cloc<i_swp_rejCloc_bear and upperWickR>i_swp_rejWickR
swpBullValid = swpBull and (not i_sweepReject or sweepRejBull)
swpBearValid = swpBear and (not i_sweepReject or sweepRejBear)
prox = atr14 * i_swp_proxATR
cNr(l) => not na(l) and math.abs(close-l) < prox
nearHi = cNr(pTH1) or cNr(pLH1) or cNr(pNH1) or cNr(pTH2) or cNr(pLH2) or cNr(pNH2)
nearLo = cNr(pTL1) or cNr(pLL1) or cNr(pNL1) or cNr(pTL2) or cNr(pLL2) or cNr(pNL2)

var pivotPoint swingHi=pivotPoint.new(na,na,false), var pivotPoint swingLo=pivotPoint.new(na,na,false)
var pivotPoint intHi=pivotPoint.new(na,na,false), var pivotPoint intLo=pivotPoint.new(na,na,false)
var pivotPoint eqHi=pivotPoint.new(na,na,false), var pivotPoint eqLo=pivotPoint.new(na,na,false)
var trendBias swingTrend=trendBias.new(0), var trendBias intTrend=trendBias.new(0)
var trailExt trailing=trailExt.new()
_swgHighest=ta.highest(high,i_swingLen), _swgLowest=ta.lowest(low,i_swingLen)
_intHighest=ta.highest(high,i_intLen), _intLowest=ta.lowest(low,i_intLen)
_eqHighest=ta.highest(high,i_eqlBars), _eqLowest=ta.lowest(low,i_eqlBars)
var int _swgLeg=0
if high[i_swingLen]>_swgHighest
    _swgLeg:=0
else if low[i_swingLen]<_swgLowest
    _swgLeg:=1
var int _intLeg=0
if high[i_intLen]>_intHighest
    _intLeg:=0
else if low[i_intLen]<_intLowest
    _intLeg:=1
var int _eqLeg=0
if high[i_eqlBars]>_eqHighest
    _eqLeg:=0
else if low[i_eqlBars]<_eqLowest
    _eqLeg:=1
_swgLegChg=ta.change(_swgLeg), _intLegChg=ta.change(_intLeg), _eqLegChg=ta.change(_eqLeg)
_xoIntHi=ta.crossover(close,nz(intHi.currentLevel)), _xuIntLo=ta.crossunder(close,nz(intLo.currentLevel))
_xoSwgHi=ta.crossover(close,nz(swingHi.currentLevel)), _xuSwgLo=ta.crossunder(close,nz(swingLo.currentLevel))
isDispBull = body > avgBodyRef * rDisplMult and cloc > 55 and close > open
isDispBear = body > avgBodyRef * rDisplMult and cloc < 45 and close < open

getStructure(int sz, int legChg, bool eqMode=false, bool intMode=false) =>
    newPiv=legChg!=0, pivLow=legChg==1, pivHigh=legChg==-1
    float _retBot=na,int _retBotTime=na,int _retBotIdx=na,float _retTop=na,int _retTopTime=na,int _retTopIdx=na
    string _retTag=""
    if newPiv
        if pivLow
            pivotPoint pp = eqMode?eqLo:intMode?intLo:swingLo
            if eqMode and not na(pp.currentLevel) and math.abs(pp.currentLevel-low[sz])<i_eqlThresh*atr200
                if i_showEQL and drawOK
                    line.new(chart.point.new(pp.barTime,na,pp.currentLevel),chart.point.new(time[sz],na,low[sz]),xloc=xloc.bar_time,color=i_swgBullCol,style=line.style_dotted)
                    midIdx=math.round(0.5*(pp.barIdx+bar_index-sz))
                    label.new(chart.point.new(na,midIdx,low[sz]),"EQL",xloc.bar_index,color=color(na),textcolor=i_swgBullCol,style=label.style_label_up,size=i_eqlSize)
            pp.lastLevel:=pp.currentLevel, pp.currentLevel:=low[sz], pp.crossed:=false, pp.barTime:=time[sz], pp.barIdx:=bar_index[sz]
            if not eqMode and not intMode
                _retBot:=pp.currentLevel,_retBotTime:=pp.barTime,_retBotIdx:=pp.barIdx
                _retTag:=pp.currentLevel<pp.lastLevel?"LL":"HL"
        else
            pivotPoint pp = eqMode?eqHi:intMode?intHi:swingHi
            if eqMode and not na(pp.currentLevel) and math.abs(pp.currentLevel-high[sz])<i_eqlThresh*atr200
                if i_showEQL and drawOK
                    line.new(chart.point.new(pp.barTime,na,pp.currentLevel),chart.point.new(time[sz],na,high[sz]),xloc=xloc.bar_time,color=i_swgBearCol,style=line.style_dotted)
                    midIdx=math.round(0.5*(pp.barIdx+bar_index-sz))
                    label.new(chart.point.new(na,midIdx,high[sz]),"EQH",xloc.bar_index,color=color(na),textcolor=i_swgBearCol,style=label.style_label_down,size=i_eqlSize)
            pp.lastLevel:=pp.currentLevel, pp.currentLevel:=high[sz], pp.crossed:=false, pp.barTime:=time[sz], pp.barIdx:=bar_index[sz]
            if not eqMode and not intMode
                _retTop:=pp.currentLevel,_retTopTime:=pp.barTime,_retTopIdx:=pp.barIdx
                _retTag:=pp.currentLevel>pp.lastLevel?"HH":"LH"
    [_retTop,_retTopTime,_retTopIdx,_retBot,_retBotTime,_retBotIdx,_retTag]

var array<obData> swgOBs=array.new<obData>(), var array<obData> intOBs=array.new<obData>()
var array<box> swgOBBoxes=array.new<box>(), var array<box> intOBBoxes=array.new<box>()
var array<breakerBlock> breakers=array.new<breakerBlock>(), var array<box> breakerBoxes=array.new<box>()
if barstate.isfirst
    if i_showSwgOB
        for i=1 to i_swgOBSize
            swgOBBoxes.push(box.new(na,na,na,na,xloc=xloc.bar_time,extend=extend.right))
    if i_showIntOB
        for i=1 to i_intOBSize
            intOBBoxes.push(box.new(na,na,na,na,xloc=xloc.bar_time,extend=extend.right))
    if i_showBreaker
        for i=1 to 5
            breakerBoxes.push(box.new(na,na,na,na,xloc=xloc.bar_time,extend=extend.right))
bearMitigSrc = i_obMitig=="Close"?close:high, bullMitigSrc = i_obMitig=="Close"?close:low

storeOB(pivotPoint pp, bool isInt, int bias) =>
    show = isInt?i_showIntOB:i_showSwgOB
    if show and pp.barIdx>0 and pp.barIdx<bar_index
        startIdx=math.max(pp.barIdx,0), endIdx=math.min(bar_index,arr_highs.size())
        if startIdx < endIdx
            bestIdx = -1
            if bias == BEARISH_C
                float bestVal = na
                for i=startIdx to endIdx-1
                    if i<arr_isBearCandle.size() and not arr_isBearCandle.get(i)
                        if na(bestVal) or arr_highs.get(i)>bestVal
                            bestVal:=arr_highs.get(i), bestIdx:=i
            else
                float bestVal2 = na
                for i=startIdx to endIdx-1
                    if i<arr_isBearCandle.size() and arr_isBearCandle.get(i)
                        if na(bestVal2) or arr_lows.get(i)<bestVal2
                            bestVal2:=arr_lows.get(i), bestIdx:=i
            if bestIdx>=0 and bestIdx<arr_highs.size()
                ob = obData.new(arr_highs.get(bestIdx),arr_lows.get(bestIdx),arr_times.get(bestIdx),bias,arr_isBearCandle.get(bestIdx),0,false)
                obs = isInt?intOBs:swgOBs
                if obs.size()>=i_str_obMaxStored
                    obs.pop()
                obs.unshift(ob)

addBreaker(obData ob) =>
    if i_showBreaker and breakers.size()<i_str_brkStoreCap
        breakers.unshift(breakerBlock.new(ob.bHigh,ob.bLow,ob.bTime,ob.bias==BULLISH_C?BEARISH_C:BULLISH_C,bar_index))

deleteOBs(bool isInt) =>
    obs = isInt?intOBs:swgOBs
    for [idx,ob] in obs
        fullCross = (bearMitigSrc>ob.bHigh and ob.bias==BEARISH_C) or (bullMitigSrc<ob.bLow and ob.bias==BULLISH_C)
        partialBear = ob.bias==BEARISH_C and high>=ob.bLow and high<=ob.bHigh and close<ob.bLow
        partialBull = ob.bias==BULLISH_C and low<=ob.bHigh and low>=ob.bLow and close>ob.bHigh
        if fullCross
            addBreaker(ob)
            obs.remove(idx)
            true
        else if partialBear or partialBull
            ob.partialMitig := true
            true
        else
            false

if i_showBreaker
    for [idx,bb] in breakers
        breakerExpiry = i_useBilateral ? i_str_brkExp_bilat : i_str_brkExp_norm
        mitigated = (bb.bias==BULLISH_C and close<bb.bLow) or (bb.bias==BEARISH_C and close>bb.bHigh)
        if mitigated or (bar_index-bb.birthBar>breakerExpiry)
            breakers.remove(idx)

var int prevSwingBias = 0
swingFlipBull = swingTrend.bias == BULLISH_C and prevSwingBias != BULLISH_C
swingFlipBear = swingTrend.bias == BEARISH_C and prevSwingBias != BEARISH_C
prevSwingBias := swingTrend.bias
if i_structExpire and swingFlipBull
    for [idx, ob] in intOBs
        if ob.bias == BEARISH_C
            intOBs.remove(idx)
    for [idx, ob] in swgOBs
        if ob.bias == BEARISH_C
            swgOBs.remove(idx)
if i_structExpire and swingFlipBear
    for [idx, ob] in intOBs
        if ob.bias == BULLISH_C
            intOBs.remove(idx)
    for [idx, ob] in swgOBs
        if ob.bias == BULLISH_C
            swgOBs.remove(idx)

drawOBs(bool isInt) =>
    obs = isInt?intOBs:swgOBs
    obSz = obs.size()
    if obSz > 0
        maxOB = isInt?i_intOBSize:i_swgOBSize
        parsed = obs.slice(0, math.min(maxOB, obSz))
        boxes = isInt?intOBBoxes:swgOBBoxes
        for [idx,ob] in parsed
            c = isInt?(ob.bias==BEARISH_C?i_intBearOBCol:i_intBullOBCol):(ob.bias==BEARISH_C?i_swgBearOBCol:i_swgBullOBCol)
            cFinal = ob.partialMitig ? color.new(c, 92) : c
            b = boxes.get(idx)
            b.set_top_left_point(chart.point.new(ob.bTime,na,ob.bHigh))
            b.set_bottom_right_point(chart.point.new(last_bar_time,na,ob.bLow))
            b.set_border_color(isInt?na:cFinal), b.set_bgcolor(cFinal)

drawBreakers() =>
    if i_showBreaker and breakers.size()>0
        maxBB = math.min(i_str_brkDispCap, breakers.size())
        for i=0 to maxBB-1
            bb=breakers.get(i), bx=breakerBoxes.get(i)
            c = bb.bias==BULLISH_C?color.new(#00BCD4,75):color.new(#FF5722,75)
            bx.set_top_left_point(chart.point.new(bb.bTime,na,bb.bHigh))
            bx.set_bottom_right_point(chart.point.new(last_bar_time,na,bb.bLow))
            bx.set_border_color(c), bx.set_bgcolor(c)

var bool intOBBullR=false, var bool intOBBearR=false
var bool swgOBBullR=false, var bool swgOBBearR=false
var bool breakerBullR=false, var bool breakerBearR=false
var int obTouchCountBull=0, var int obTouchCountBear=0
var bool obPartialBull=false, var bool obPartialBear=false
intOBBullR:=false, intOBBearR:=false, swgOBBullR:=false, swgOBBearR:=false
breakerBullR:=false, breakerBearR:=false
obTouchCountBull:=0, obTouchCountBear:=0
obPartialBull:=false, obPartialBear:=false
if intOBs.size()>0
    for [idx,ob] in intOBs
        if ob.bias==BULLISH_C and low<=ob.bHigh and low>=ob.bLow
            ob.touchCount += 1
            intOBBullR:=true
            obTouchCountBull:=ob.touchCount
            obPartialBull:=ob.partialMitig
            break
        if ob.bias==BEARISH_C and high>=ob.bLow and high<=ob.bHigh
            ob.touchCount += 1
            intOBBearR:=true
            obTouchCountBear:=ob.touchCount
            obPartialBear:=ob.partialMitig
            break
if swgOBs.size()>0
    for [idx,ob] in swgOBs
        if ob.bias==BULLISH_C and low<=ob.bHigh and low>=ob.bLow
            ob.touchCount += 1
            swgOBBullR:=true
            obTouchCountBull:=math.max(obTouchCountBull, ob.touchCount)
            obPartialBull:=obPartialBull or ob.partialMitig
            break
        if ob.bias==BEARISH_C and high>=ob.bLow and high<=ob.bHigh
            ob.touchCount += 1
            swgOBBearR:=true
            obTouchCountBear:=math.max(obTouchCountBear, ob.touchCount)
            obPartialBear:=obPartialBear or ob.partialMitig
            break
if i_showBreaker and breakers.size()>0
    for [idx,bb] in breakers
        if bb.bias==BULLISH_C and low<=bb.bHigh and low>=bb.bLow
            breakerBullR:=true
        else if bb.bias==BEARISH_C and high>=bb.bLow and high<=bb.bHigh
            breakerBearR:=true

displayStruct(bool isInt, bool xoHi, bool xuLo) =>
    pivotPoint pp = isInt?intHi:swingHi
    trendBias tr = isInt?intTrend:swingTrend
    lStyle = isInt?line.style_dashed:line.style_solid, lSize = isInt?i_intLabelSize:i_swgLabelSize
    bullCol = isInt?i_intBullCol:i_swgBullCol, bearCol = isInt?i_intBearCol:i_swgBearCol
    bool _bullBOS=false,bool _bullCH=false,bool _bearBOS=false,bool _bearCH=false,bool _posBuy=false,bool _posSell=false
    float _brokenLevelBull = na, float _brokenLevelBear = na
    extraCond = isInt?(intHi.currentLevel!=swingHi.currentLevel):true
    displOK_bull = isDispBull or (not isInt)
    if xoHi and not pp.crossed and extraCond and displOK_bull
        tag = tr.bias==BEARISH_C?"CHoCH":"BOS"
        if tag=="CHoCH"
            _bullCH:=true
        else
            _bullBOS:=true
        _brokenLevelBull := pp.currentLevel
        pp.crossed:=true, tr.bias:=BULLISH_C
        if isInt and tag=="CHoCH" and swingTrend.bias==BEARISH_C
            _posBuy:=true
        showFilter=isInt?i_showIntBull:i_showSwgBull, showMain=isInt?i_showInternals:i_showSwing
        dispOK = showMain and (showFilter=="All" or (showFilter=="BOS" and tag!="CHoCH") or (showFilter=="CHoCH" and tag=="CHoCH"))
        if dispOK and drawOK
            var line sl=line.new(na,na,na,na,xloc=xloc.bar_time), var label slb=label.new(na,na)
            if i_modeHist=="Present"
                sl.delete(), slb.delete()
            sl:=line.new(chart.point.new(pp.barTime,na,pp.currentLevel),chart.point.new(time,na,pp.currentLevel),xloc.bar_time,color=bullCol,style=lStyle)
            midIdx=math.round(0.5*(pp.barIdx+bar_index))
            slb:=label.new(chart.point.new(na,midIdx,pp.currentLevel),tag,xloc.bar_index,color=color(na),textcolor=bullCol,style=label.style_label_down,size=lSize)
        if (isInt and i_showIntOB) or (not isInt and i_showSwgOB)
            storeOB(pp, isInt, BULLISH_C)
    pp := isInt?intLo:swingLo
    extraCond2 = isInt?(intLo.currentLevel!=swingLo.currentLevel):true
    displOK_bear = isDispBear or (not isInt)
    if xuLo and not pp.crossed and extraCond2 and displOK_bear
        tag2 = tr.bias==BULLISH_C?"CHoCH":"BOS"
        if tag2=="CHoCH"
            _bearCH:=true
        else
            _bearBOS:=true
        _brokenLevelBear := pp.currentLevel
        pp.crossed:=true, tr.bias:=BEARISH_C
        if isInt and tag2=="CHoCH" and swingTrend.bias==BULLISH_C
            _posSell:=true
        showFilter2=isInt?i_showIntBear:i_showSwgBear, showMain2=isInt?i_showInternals:i_showSwing
        dispOK2 = showMain2 and (showFilter2=="All" or (showFilter2=="BOS" and tag2!="CHoCH") or (showFilter2=="CHoCH" and tag2=="CHoCH"))
        if dispOK2 and drawOK
            var line sl2=line.new(na,na,na,na,xloc=xloc.bar_time), var label slb2=label.new(na,na)
            if i_modeHist=="Present"
                sl2.delete(), slb2.delete()
            sl2:=line.new(chart.point.new(pp.barTime,na,pp.currentLevel),chart.point.new(time,na,pp.currentLevel),xloc.bar_time,color=bearCol,style=lStyle)
            midIdx2=math.round(0.5*(pp.barIdx+bar_index))
            slb2:=label.new(chart.point.new(na,midIdx2,pp.currentLevel),tag2,xloc.bar_index,color=color(na),textcolor=bearCol,style=label.style_label_up,size=lSize)
        if (isInt and i_showIntOB) or (not isInt and i_showSwgOB)
            storeOB(pp, isInt, BEARISH_C)
    [_bullBOS,_bullCH,_bearBOS,_bearCH,_posBuy,_posSell,_brokenLevelBull,_brokenLevelBear]

[sNewTop,sNewTopTime,sNewTopIdx,sNewBot,sNewBotTime,sNewBotIdx,sSwgTag] = getStructure(i_swingLen,_swgLegChg,false,false)
[_nt1,_ntt1,_nti1,_nb1,_nbt1,_nbi1,_itag] = getStructure(i_intLen,_intLegChg,false,true)
if i_showEQL
    [_et,_ett,_eti,_eb,_ebt,_ebi,_etag] = getStructure(i_eqlBars,_eqLegChg,true,false)
if i_eqSweep and _eqLegChg != 0
    if _eqLegChg == -1 and not na(eqHi.currentLevel) and not na(eqHi.lastLevel)
        if math.abs(eqHi.currentLevel - eqHi.lastLevel) < i_eqlThresh * atr200
            already = false
            if arr_eqHighs.size() > 0
                for i = 0 to arr_eqHighs.size() - 1
                    if math.abs(arr_eqHighs.get(i) - eqHi.currentLevel) < atr14 * i_swp_eqDedupATR
                        already := true
                        break
            if not already
                arr_eqHighs.unshift(eqHi.currentLevel), arr_eqHighBars.unshift(bar_index), arr_eqHighSwept.unshift(false)
                if arr_eqHighs.size() > i_eq_keepN
                    arr_eqHighs.pop(), arr_eqHighBars.pop(), arr_eqHighSwept.pop()
    if _eqLegChg == 1 and not na(eqLo.currentLevel) and not na(eqLo.lastLevel)
        if math.abs(eqLo.currentLevel - eqLo.lastLevel) < i_eqlThresh * atr200
            already2 = false
            if arr_eqLows.size() > 0
                for i = 0 to arr_eqLows.size() - 1
                    if math.abs(arr_eqLows.get(i) - eqLo.currentLevel) < atr14 * i_swp_eqDedupATR
                        already2 := true
                        break
            if not already2
                arr_eqLows.unshift(eqLo.currentLevel), arr_eqLowBars.unshift(bar_index), arr_eqLowSwept.unshift(false)
                if arr_eqLows.size() > i_eq_keepN
                    arr_eqLows.pop(), arr_eqLowBars.pop(), arr_eqLowSwept.pop()
var bool eqHighSweptNow = false, var bool eqLowSweptNow = false
var float eqHighSweptLevel = na, var float eqLowSweptLevel = na
eqHighSweptNow := false, eqLowSweptNow := false
eqHighSweptLevel := na, eqLowSweptLevel := na
if i_eqSweep and arr_eqHighs.size() > 0
    for i = 0 to arr_eqHighs.size() - 1
        if not arr_eqHighSwept.get(i)
            lvl = arr_eqHighs.get(i)
            if high > lvl + atr14 * profSweepTol and close < lvl
                arr_eqHighSwept.set(i, true), eqHighSweptNow := true, eqHighSweptLevel := lvl
                break
if i_eqSweep and arr_eqLows.size() > 0
    for i = 0 to arr_eqLows.size() - 1
        if not arr_eqLowSwept.get(i)
            lvl = arr_eqLows.get(i)
            if low < lvl - atr14 * profSweepTol and close > lvl
                arr_eqLowSwept.set(i, true), eqLowSweptNow := true, eqLowSweptLevel := lvl
                break

if not na(sNewTop)
    trailing.top:=sNewTop, trailing.topTime:=sNewTopTime, trailing.topIdx:=sNewTopIdx, swH_deal:=sNewTop
    if i_showSwgPts and drawOK
        label.new(chart.point.new(sNewTopTime,na,sNewTop),sSwgTag,xloc.bar_time,color=color(na),textcolor=i_swgBearCol,style=label.style_label_down,size=size.small)
if not na(sNewBot)
    trailing.bottom:=sNewBot, trailing.bottomTime:=sNewBotTime, trailing.bottomIdx:=sNewBotIdx, swL_deal:=sNewBot
    if i_showSwgPts and drawOK
        label.new(chart.point.new(sNewBotTime,na,sNewBot),sSwgTag,xloc.bar_time,color=color(na),textcolor=i_swgBullCol,style=label.style_label_up,size=size.small)
if i_showStrongWeak
    trailing.top:=math.max(high,nz(trailing.top,high)), trailing.topTime:=trailing.top==high?time:trailing.topTime, trailing.topIdx:=trailing.top==high?bar_index:trailing.topIdx
    trailing.bottom:=math.min(low,nz(trailing.bottom,low)), trailing.bottomTime:=trailing.bottom==low?time:trailing.bottomTime, trailing.bottomIdx:=trailing.bottom==low?bar_index:trailing.bottomIdx

[aIntBullBOS,aIntBullCH,aIntBearBOS,aIntBearCH,intPosBuy,intPosSell,intBrokenBull,intBrokenBear] = displayStruct(true,_xoIntHi,_xuIntLo)
[aSwgBullBOS,aSwgBullCH,aSwgBearBOS,aSwgBearCH,swgPosBuy,swgPosSell,swgBrokenBull,swgBrokenBear] = displayStruct(false,_xoSwgHi,_xuSwgLo)
if i_showIntOB
    deleteOBs(true)
if i_showSwgOB
    deleteOBs(false)

var array<retestZone> retestZones = array.new<retestZone>()
if i_bosRetest
    if not na(intBrokenBull)
        retestZones.unshift(retestZone.new(intBrokenBull, 1, bar_index, false))
    if not na(intBrokenBear)
        retestZones.unshift(retestZone.new(intBrokenBear, -1, bar_index, false))
    if not na(swgBrokenBull)
        retestZones.unshift(retestZone.new(swgBrokenBull, 1, bar_index, false))
    if not na(swgBrokenBear)
        retestZones.unshift(retestZone.new(swgBrokenBear, -1, bar_index, false))
    if retestZones.size() > i_str_retest_max_arr
        while retestZones.size() > i_str_retest_keep
            retestZones.pop()
var bool retestBullR = false, var bool retestBearR = false
retestBullR := false, retestBearR := false
if i_bosRetest and retestZones.size() > 0
    rTol = atr14 * i_str_retest_tol
    for [idx, rz] in retestZones
        if not rz.tested and (bar_index - rz.birthBar) >= i_str_retest_min and (bar_index - rz.birthBar) <= i_str_retest_max
            if rz.bias == 1 and math.abs(low - rz.level) < rTol
                retestBullR := true, rz.tested := true
            else if rz.bias == -1 and math.abs(high - rz.level) < rTol
                retestBearR := true, rz.tested := true
        if (bar_index - rz.birthBar) > i_str_retest_max
            retestZones.remove(idx)

var int intBullCHCount=0, var int intBearCHCount=0
if aSwgBullBOS or aSwgBullCH
    intBearCHCount:=0
if aSwgBearBOS or aSwgBearCH
    intBullCHCount:=0
if aIntBullCH and swingTrend.bias==BEARISH_C
    intBullCHCount+=1
if aIntBearCH and swingTrend.bias==BULLISH_C
    intBearCHCount+=1
possibilityBuy = (intBullCHCount>=i_sh_chCount_strong) or (intBullCHCount>=i_sh_chCount_pressure and strongBP)
possibilitySell = (intBearCHCount>=i_sh_chCount_strong) or (intBearCHCount>=i_sh_chCount_pressure and strongSP)
anyBosB = aSwgBullBOS or aSwgBullCH or aIntBullBOS or aIntBullCH
anyBosS = aSwgBearBOS or aSwgBearCH or aIntBearBOS or aIntBearCH
var bool prevPossB=false, var bool prevPossS=false
var int lastPossBuyBar = 0, var int lastPossSellBar = 0
int possCooldownBars = math.max(i_sh_cool_min, math.round(adaptCD * i_sh_cool_mult))
possNewB = possibilityBuy and not prevPossB and (bar_index - lastPossBuyBar) >= possCooldownBars
possNewS = possibilitySell and not prevPossS and (bar_index - lastPossSellBar) >= possCooldownBars
prevPossB:=possibilityBuy, prevPossS:=possibilitySell
if i_showPossibility and possNewB and drawOK
    label.new(bar_index,low,"⚠ BUY SHIFT POSSIBLE",style=label.style_label_up,color=color.new(#00BCD4,20),textcolor=color.white,size=size.small,yloc=yloc.belowbar)
    lastPossBuyBar := bar_index
if i_showPossibility and possNewS and drawOK
    label.new(bar_index,high,"⚠ SELL SHIFT POSSIBLE",style=label.style_label_down,color=color.new(#E040FB,20),textcolor=color.white,size=size.small,yloc=yloc.abovebar)
    lastPossSellBar := bar_index

if i_showStrongWeak and barstate.islast
    var line swHL=line.new(na,na,na,na,xloc=xloc.bar_time,color=i_swgBearCol), var line swLL=line.new(na,na,na,na,xloc=xloc.bar_time,color=i_swgBullCol)
    var label swHLb=label.new(na,na,color=color(na),textcolor=i_swgBearCol,xloc=xloc.bar_time,style=label.style_label_down,size=size.tiny)
    var label swLLb=label.new(na,na,color=color(na),textcolor=i_swgBullCol,xloc=xloc.bar_time,style=label.style_label_up,size=size.tiny)
    rtb = last_bar_time+20*(time-time[1])
    if not na(trailing.topTime)
        swHL.set_first_point(chart.point.new(trailing.topTime,na,trailing.top)), swHL.set_second_point(chart.point.new(rtb,na,trailing.top))
        swHLb.set_point(chart.point.new(rtb,na,trailing.top)), swHLb.set_text(swingTrend.bias==BEARISH_C?"Strong High":"Weak High")
    if not na(trailing.bottomTime)
        swLL.set_first_point(chart.point.new(trailing.bottomTime,na,trailing.bottom)), swLL.set_second_point(chart.point.new(rtb,na,trailing.bottom))
        swLLb.set_point(chart.point.new(rtb,na,trailing.bottom)), swLLb.set_text(swingTrend.bias==BULLISH_C?"Strong Low":"Weak Low")

if barstate.islastconfirmedhistory or barstate.islast
    if i_showIntOB
        drawOBs(true)
    if i_showSwgOB
        drawOBs(false)
    drawBreakers()

swH100 = not na(swH_deal)?math.max(swH_deal,swH_fb):swH_fb
swL100 = not na(swL_deal)?math.min(swL_deal,swL_fb):swL_fb
swMid = (swH100+swL100)/2.0
pdPct = swH100!=swL100?(close-swL100)/(swH100-swL100)*100:50.0
pdPctClamped = math.max(-50,math.min(200,pdPct))
extPrem  = pdPctClamped >= i_extPrem
extDisc  = pdPctClamped <= i_extDisc
hyperPrem_v17 = false
hyperDisc_v17 = false
inDisc = close<swMid, inPrem = close>swMid
pdModBull_v17 = pdPct<40 ? -1 : pdPct>60 ? 2 : 0
pdModBear_v17 = pdPct>60 ? -1 : pdPct<40 ? 2 : 0
pdModBull_v17 += extDisc ? -1 : 0
pdModBear_v17 += extPrem ? -1 : 0
pdModBull = pdModBull_v17, pdModBear = pdModBear_v17
var float dayHi=na, var float dayLo=na
if isNewDay
    dayHi:=high, dayLo:=low
else
    dayHi:=math.max(nz(dayHi,high),high), dayLo:=math.min(nz(dayLo,low),low)
dayRange = nz(dayHi)-nz(dayLo)
adrPct = not na(dATR) and dATR>0?dayRange/dATR*100:0
adrExhausted = adrPct>=i_adr_exhPct
adrTxt = adrPct>=i_adr_exhTxtPct?"EXHAUSTED":adrPct>=i_adr_maturePct?"MATURE":adrPct<i_adr_freshPct?"FRESH":"DEVELOPING"
adrHardBlock = adrPct>=i_adr_hardBlock
adrBlockSell = adrHardBlock and not na(dayLo) and close<=nz(dayLo)+dayRange*(i_adr_zonePct/100.0)
adrBlockBuy  = adrHardBlock and not na(dayHi) and close>=nz(dayHi)-dayRange*(i_adr_zonePct/100.0)

var box[] fvB=array.new_box(0), var box[] fvS=array.new_box(0)
var box[] ifvB=array.new_box(0), var box[] ifvS=array.new_box(0)
var int[] fvBTouch=array.new_int(0), var int[] fvSTouch=array.new_int(0)
fvMin = atr14 * i_fvg_minMult
fBG = low-high[2], fSG = low[2]-high
var float newBullTop=na,var float newBullBot=na,var float newBearTop=na,var float newBearBot=na
newBullTop:=na, newBullBot:=na, newBearTop:=na, newBearBot:=na
if fBG>0 and fBG>=fvMin and i_showFVG
    newBullTop:=low, newBullBot:=high[2]
    array.push(fvB,box.new(bar_index-2,low,bar_index+40,high[2],bgcolor=color.new(i_fvgBullCol,90),border_color=color.new(i_fvgBullCol,60),border_width=1,text="FVG",text_color=color.new(i_fvgBullCol,25),text_size=size.tiny,extend=extend.right))
    array.push(fvBTouch, 0)
    if i_showCE and drawOK
        line.new(bar_index-2,(low+high[2])/2,bar_index+40,(low+high[2])/2,color=color.new(i_fvgBullCol,40),style=line.style_dotted,width=1,extend=extend.right)
    if array.size(fvB)>i_maxFVG
        box.delete(array.shift(fvB))
        array.shift(fvBTouch)
if fSG>0 and fSG>=fvMin and i_showFVG
    newBearTop:=low[2], newBearBot:=high
    array.push(fvS,box.new(bar_index-2,low[2],bar_index+40,high,bgcolor=color.new(i_fvgBearCol,90),border_color=color.new(i_fvgBearCol,60),border_width=1,text="FVG",text_color=color.new(i_fvgBearCol,25),text_size=size.tiny,extend=extend.right))
    array.push(fvSTouch, 0)
    if i_showCE and drawOK
        line.new(bar_index-2,(low[2]+high)/2,bar_index+40,(low[2]+high)/2,color=color.new(i_fvgBearCol,40),style=line.style_dotted,width=1,extend=extend.right)
    if array.size(fvS)>i_maxFVG
        box.delete(array.shift(fvS))
        array.shift(fvSTouch)
if not na(newBearTop) and i_showIFVG and array.size(fvB)>0
    for i=array.size(fvB)-1 to 0
        bx=array.get(fvB,i), bTop=box.get_top(bx), bBot=box.get_bottom(bx)
        oTop=math.min(bTop,newBearTop), oBot=math.max(bBot,newBearBot)
        if oTop>oBot
            if array.size(ifvS)<i_maxFVG
                array.push(ifvS,box.new(bar_index,oTop,bar_index+40,oBot,bgcolor=color.new(#FF5722,85),border_color=color.new(#FF5722,40),border_width=2,text="IFVG",text_color=color.new(#FF5722,10),text_size=size.tiny,extend=extend.right))
            box.delete(bx), array.remove(fvB,i)
            if i < array.size(fvBTouch)
                array.remove(fvBTouch, i)
            break
if not na(newBullTop) and i_showIFVG and array.size(fvS)>0
    for i=array.size(fvS)-1 to 0
        bx=array.get(fvS,i), bTop=box.get_top(bx), bBot=box.get_bottom(bx)
        oTop=math.min(bTop,newBullTop), oBot=math.max(bBot,newBullBot)
        if oTop>oBot
            if array.size(ifvB)<i_maxFVG
                array.push(ifvB,box.new(bar_index,oTop,bar_index+40,oBot,bgcolor=color.new(#00BCD4,85),border_color=color.new(#00BCD4,40),border_width=2,text="IFVG",text_color=color.new(#00BCD4,10),text_size=size.tiny,extend=extend.right))
            box.delete(bx), array.remove(fvS,i)
            if i < array.size(fvSTouch)
                array.remove(fvSTouch, i)
            break
if anyBosB and fBG>0 and fBG>=fvMin and close[1]>open[1] and array.size(fvB)>0
    bx=array.get(fvB,array.size(fvB)-1)
    box.set_text(bx,"BOS-FVG ★"), box.set_border_color(bx,color.new(#FFD700,20)), box.set_border_width(bx,i_fvg_bosStarW)
if anyBosS and fSG>0 and fSG>=fvMin and close[1]<open[1] and array.size(fvS)>0
    bx=array.get(fvS,array.size(fvS)-1)
    box.set_text(bx,"BOS-FVG ★"), box.set_border_color(bx,color.new(#FFD700,20)), box.set_border_width(bx,i_fvg_bosStarW)
var bool zBullFVM=false, var bool zBearFVM=false
var int fvgTouchBull=0, var int fvgTouchBear=0
zBullFVM:=false, zBearFVM:=false, fvgTouchBull:=0, fvgTouchBear:=0
if array.size(fvB)>0
    for i=array.size(fvB)-1 to 0
        bx=array.get(fvB,i), bT=box.get_top(bx), bB=box.get_bottom(bx), fM=(bT+bB)/2
        if close<bB
            box.delete(bx), array.remove(fvB,i)
            if i < array.size(fvBTouch)
                array.remove(fvBTouch, i)
        else if low<=fM and close>bB
            zBullFVM:=true
            if i < array.size(fvBTouch)
                curTouch = array.get(fvBTouch, i) + 1
                array.set(fvBTouch, i, curTouch)
                fvgTouchBull := curTouch
            box.set_text(bx, "FVG CE✓")
if array.size(fvS)>0
    for i=array.size(fvS)-1 to 0
        bx=array.get(fvS,i), bT=box.get_top(bx), bB=box.get_bottom(bx), fM=(bT+bB)/2
        if close>bT
            box.delete(bx), array.remove(fvS,i)
            if i < array.size(fvSTouch)
                array.remove(fvSTouch, i)
        else if high>=fM and close<bT
            zBearFVM:=true
            if i < array.size(fvSTouch)
                curTouch = array.get(fvSTouch, i) + 1
                array.set(fvSTouch, i, curTouch)
                fvgTouchBear := curTouch
            box.set_text(bx, "FVG CE✓")
var bool ifvBullR=false, var bool ifvBearR=false
ifvBullR:=false, ifvBearR:=false
if array.size(ifvB)>0
    for i=array.size(ifvB)-1 to 0
        bx=array.get(ifvB,i), bT=box.get_top(bx), bB=box.get_bottom(bx)
        if low<bB
            box.delete(bx), array.remove(ifvB,i)
        else if low<=bT and low>=bB
            ifvBullR:=true
if array.size(ifvS)>0
    for i=array.size(ifvS)-1 to 0
        bx=array.get(ifvS,i), bT=box.get_top(bx), bB=box.get_bottom(bx)
        if high>bT
            box.delete(bx), array.remove(ifvS,i)
        else if high>=bB and high<=bT
            ifvBearR:=true

[h1BC,h1BT,h1BB]=request.security(syminfo.tickerid,"60",[close[2]<open[2] and close[1]>open[1] and close[1]>high[2] and math.abs(close[2]-open[2])/(high[2]-low[2]+syminfo.mintick)>0.6,high[2],low[2]],lookahead=barmerge.lookahead_off)
[h1SC,h1ST,h1SB]=request.security(syminfo.tickerid,"60",[close[2]>open[2] and close[1]<open[1] and close[1]<low[2] and math.abs(close[2]-open[2])/(high[2]-low[2]+syminfo.mintick)>0.6,high[2],low[2]],lookahead=barmerge.lookahead_off)
var box[] h1OBB=array.new_box(0), var box[] h1OBS=array.new_box(0)
if h1BC and not h1BC[1]
    array.push(h1OBB,box.new(bar_index,h1BT,bar_index+55,h1BB,bgcolor=color.new(#7C4DFF,78),border_color=color.new(#7C4DFF,25),border_width=2,text="1H OB",text_color=color.new(#7C4DFF,10),text_size=size.tiny,extend=extend.right))
    if array.size(h1OBB)>i_h1_obKeep
        box.delete(array.shift(h1OBB))
if h1SC and not h1SC[1]
    array.push(h1OBS,box.new(bar_index,h1ST,bar_index+55,h1SB,bgcolor=color.new(#FF6D00,78),border_color=color.new(#FF6D00,25),border_width=2,text="1H OB",text_color=color.new(#FF6D00,10),text_size=size.tiny,extend=extend.right))
    if array.size(h1OBS)>i_h1_obKeep
        box.delete(array.shift(h1OBS))
var bool h1BR=false, var bool h1SR=false
h1BR:=false, h1SR:=false
if array.size(h1OBB)>0
    for i=array.size(h1OBB)-1 to 0
        bx=array.get(h1OBB,i), bT=box.get_top(bx), bB=box.get_bottom(bx)
        if low<bB
            box.delete(bx), array.remove(h1OBB,i)
        else if low<=bT and low>=bB
            h1BR:=true
if array.size(h1OBS)>0
    for i=array.size(h1OBS)-1 to 0
        bx=array.get(h1OBS,i), bT=box.get_top(bx), bB=box.get_bottom(bx)
        if high>bT
            box.delete(bx), array.remove(h1OBS,i)
        else if high>=bB and high<=bT
            h1SR:=true

bool htfZoneBullR = false, bool htfZoneBearR = false
string htfZoneSource = ""

liqPH = ta.pivothigh(high,i_liqPvtLen,i_liqPvtLen), liqPL = ta.pivotlow(low,i_liqPvtLen,i_liqPvtLen)
var array<liqPool> liqPools = array.new<liqPool>()
var array<line> liqLines=array.new<line>(), var array<label> liqLabels=array.new<label>()
if not na(liqPH) and i_showLiqMap
    exists=false
    for [idx,pool] in liqPools
        if pool.isHigh and math.abs(pool.level-high[i_liqPvtLen])<atr14*i_liq_dedupATR
            pool.touches+=1, pool.lastBar:=bar_index-i_liqPvtLen, exists:=true
            break
    if not exists
        liqPools.unshift(liqPool.new(high[i_liqPvtLen],1,bar_index-i_liqPvtLen,bar_index-i_liqPvtLen,time[i_liqPvtLen],true,false))
if not na(liqPL) and i_showLiqMap
    exists2=false
    for [idx,pool] in liqPools
        if not pool.isHigh and math.abs(pool.level-low[i_liqPvtLen])<atr14*i_liq_dedupATR
            pool.touches+=1, pool.lastBar:=bar_index-i_liqPvtLen, exists2:=true
            break
    if not exists2
        liqPools.unshift(liqPool.new(low[i_liqPvtLen],1,bar_index-i_liqPvtLen,bar_index-i_liqPvtLen,time[i_liqPvtLen],false,false))
if i_showLiqMap
    for [idx,pool] in liqPools
        if not pool.swept
            if pool.isHigh and high>pool.level+sTol
                pool.swept:=true
            else if not pool.isHigh and low<pool.level-sTol
                pool.swept:=true
if i_showLiqMap and liqPools.size()>i_liqMaxPools*3
    while liqPools.size()>i_liqMaxPools*2
        liqPools.pop()
var float bsl1=na, var float bsl2=na, var float bsl3=na
var float ssl1=na, var float ssl2=na, var float ssl3=na
bsl1:=na, bsl2:=na, bsl3:=na, ssl1:=na, ssl2:=na, ssl3:=na
if i_showLiqMap and liqPools.size() > 0
    var array<float> bslList = array.new<float>()
    var array<float> sslList = array.new<float>()
    bslList.clear()
    sslList.clear()
    for [idx, pool] in liqPools
        if not pool.swept
            if pool.isHigh and pool.level > close
                bslList.push(pool.level)
            else if not pool.isHigh and pool.level < close
                sslList.push(pool.level)
    if bslList.size() > 0
        bslList.sort()
        bsl1 := bslList.get(0)
        if bslList.size() > 1
            bsl2 := bslList.get(1)
        if bslList.size() > 2
            bsl3 := bslList.get(2)
    if sslList.size() > 0
        sslList.sort(order.descending)
        ssl1 := sslList.get(0)
        if sslList.size() > 1
            ssl2 := sslList.get(1)
        if sslList.size() > 2
            ssl3 := sslList.get(2)
nearestBSL = bsl1
nearestSSL = ssl1
if i_showLiqMap and barstate.islast
    for ln in liqLines
        line.delete(ln)
    liqLines.clear()
    for lb in liqLabels
        label.delete(lb)
    liqLabels.clear()
    drawn=0
    for [idx,pool] in liqPools
        if not pool.swept and drawn<i_liqMaxPools
            c=pool.isHigh?i_liqBullCol:i_liqBearCol, w=math.min(pool.touches,4)
            liqX1 = math.max(pool.firstBar, bar_index - i_lookbk_max)
            liqLines.push(line.new(liqX1,pool.level,bar_index+30,pool.level,color=c,style=line.style_dotted,width=w))
            liqLabels.push(label.new(bar_index+31,pool.level,(pool.isHigh?"BSL":"SSL")+" ×"+str.tostring(pool.touches),color=color(na),textcolor=c,style=label.style_label_left,size=size.tiny))
            drawn+=1

smH = request.security(smtSym,timeframe.period,high,lookahead=barmerge.lookahead_off)
smL = request.security(smtSym,timeframe.period,low,lookahead=barmerge.lookahead_off)
goldRet = close!=0 and close[1]!=0?math.log(close/close[1]):0
smtRet = smH!=0 and smH[1]!=0?math.log(((smH+smL)/2)/((smH[1]+smL[1])/2)):0
smtCorr = ta.correlation(goldRet, smtRet, i_smt_corr_len)
smtCorrValid = smtCorr < i_smt_corr_max
gPH=ta.pivothigh(high,i_smtLen,i_smtLen), gPL=ta.pivotlow(low,i_smtLen,i_smtLen)
currGoldPH=ta.valuewhen(not na(gPH),high[i_smtLen],0), prevGoldPH=ta.valuewhen(not na(gPH),high[i_smtLen],1)
currDxyAtGPH=ta.valuewhen(not na(gPH),smL[i_smtLen],0), prevDxyAtGPH=ta.valuewhen(not na(gPH),smL[i_smtLen],1)
currGoldPL=ta.valuewhen(not na(gPL),low[i_smtLen],0), prevGoldPL=ta.valuewhen(not na(gPL),low[i_smtLen],1)
currDxyAtGPL=ta.valuewhen(not na(gPL),smH[i_smtLen],0), prevDxyAtGPL=ta.valuewhen(not na(gPL),smH[i_smtLen],1)
var bool smtB=false, var bool smtS=false
smtB:=false, smtS:=false
if not na(gPH) and not na(prevGoldPH) and not na(prevDxyAtGPH) and smtCorrValid
    if currGoldPH>prevGoldPH and currDxyAtGPH>=prevDxyAtGPH
        smtS:=true
if not na(gPL) and not na(prevGoldPL) and not na(prevDxyAtGPL) and smtCorrValid
    if currGoldPL<prevGoldPL and currDxyAtGPL<=prevDxyAtGPL
        smtB:=true
if i_showSMT and smtB and drawOK
    label.new(bar_index-i_smtLen,low[i_smtLen],"SMT▲",color=color.new(#00BCD4,15),textcolor=color.white,style=label.style_label_up,size=size.small)
if i_showSMT and smtS and drawOK
    label.new(bar_index-i_smtLen,high[i_smtLen],"SMT▼",color=color.new(#E040FB,15),textcolor=color.white,style=label.style_label_down,size=size.small)

var float oteBullHi=na,var float oteBullLo=na,var float oteBearHi=na,var float oteBearLo=na
var int oteBar=na, var int oteBias=0
if isDispBull and anyBosB
    dispLo=low[1]<low?low[1]:math.min(low,nz(low[2],low))
    oteBullHi:=high-(high-dispLo)*i_ote_hi, oteBullLo:=high-(high-dispLo)*i_ote_lo
    oteBar:=bar_index, oteBias:=1
if isDispBear and anyBosS
    dispHi=high[1]>high?high[1]:math.max(high,nz(high[2],high))
    oteBearLo:=low+(dispHi-low)*i_ote_hi, oteBearHi:=low+(dispHi-low)*i_ote_lo
    oteBar:=bar_index, oteBias:=-1
oteActive = not na(oteBar) and (bar_index-oteBar)<i_ote_window
oteReaction = (oteActive and oteBias==1 and not na(oteBullHi) and low<=oteBullHi and low>=oteBullLo) or (oteActive and oteBias==-1 and not na(oteBearHi) and high>=oteBearLo and high<=oteBearHi)
var box oteBox=na
if i_showOTE and barstate.islast and oteActive
    box.delete(oteBox)
    if oteBias==1 and not na(oteBullHi)
        oteBox:=box.new(nz(oteBar,bar_index),oteBullHi,bar_index+10,oteBullLo,bgcolor=color.new(#00E5FF,88),border_color=color.new(#00E5FF,40),border_width=2,text="OTE",text_color=color.new(#00E5FF,20),text_size=size.tiny)
    else if oteBias==-1 and not na(oteBearHi)
        oteBox:=box.new(nz(oteBar,bar_index),oteBearHi,bar_index+10,oteBearLo,bgcolor=color.new(#FF5722,88),border_color=color.new(#FF5722,40),border_width=2,text="OTE",text_color=color.new(#FF5722,20),text_size=size.tiny)

var array<reactiveLevel> hrsStore = array.new<reactiveLevel>()
addOrUpdateHRSLevel(float price, int dir) =>
    if i_useHRS and not na(price) and price > 0
        hrsTol = atr14 * i_hrsTolATR
        foundIdx = -1
        if hrsStore.size() > 0
            for i = 0 to hrsStore.size() - 1
                rl = hrsStore.get(i)
                if math.abs(rl.price - price) < hrsTol
                    foundIdx := i
                    break
        if foundIdx >= 0
            rl = hrsStore.get(foundIdx)
            rl.touchCount += 1
            rl.lastTouchBar := bar_index
            rl.lastDirection := dir
            rl.isActive := true
            0
        else
            newLevel = reactiveLevel.new(price, bar_index, 1, 0, 0, 0.0, 1, false, bar_index, dir, dir, true)
            hrsStore.unshift(newLevel)
            if hrsStore.size() > i_hrsMaxLevels
                worstIdx = hrsStore.size() - 1
                worstScore = 9999.0
                for j = 0 to hrsStore.size() - 1
                    rl2 = hrsStore.get(j)
                    age = bar_index - rl2.lastTouchBar
                    score = age * 1.0 / math.max(rl2.touchCount, 1)
                    if score < worstScore and not rl2.isMagnet
                        worstScore := score
                        worstIdx := j
                hrsStore.remove(worstIdx)
