GRP_T_MISC = "═══ v19 TUNE: Misc ═══"
i_st_factor   = input.float(3.0,  "Supertrend factor", group=GRP_T_MISC, minval=1.0,maxval=10.0,step=0.5)
i_st_atr      = input.int(10,     "Supertrend ATR",    group=GRP_T_MISC, minval=5, maxval=30)
