    hasSweepBear = swpBearValid
    hasZoneBear = anyBearZone
    hasDivBear = anyDivBear or (divRegBear[1] or divHidBear[1] or divRegBear[2] or divHidBear[2])
    hasSMTBear = smtS or smtS[1] or smtS[2] or smtS[3]
    [csH, csT] = calcBearConf(hasSweepBear, hasZoneBear, hasDivBear, hasSMTBear)
    confBearHP := csH, confBearTag := csT

var float zcBullPrice = na, var int zcBullBar = 0, var bool zcBullActive = false, var string zcBullName = ""
var float zcBullZRS = 0.0
var float zcBearPrice = na, var int zcBearBar = 0, var bool zcBearActive = false, var string zcBearName = ""
var float zcBearZRS = 0.0
var int zcBullConf = 0, var string zcBullConfTag = ""
var int zcBearConf = 0, var string zcBearConfTag = ""
if anyBullZone and not zcBullActive
    zcBullPrice := close, zcBullBar := bar_index, zcBullActive := true, zcBullName := zName
    zcBullZRS := ZRS_bull, zcBullConf := confBullHP, zcBullConfTag := confBullTag
if anyBearZone and not zcBearActive
    zcBearPrice := close, zcBearBar := bar_index, zcBearActive := true, zcBearName := zName
    zcBearZRS := ZRS_bear, zcBearConf := confBearHP, zcBearConfTag := confBearTag
if zcBullActive and (bar_index - zcBullBar) > i_zoneMemBars
