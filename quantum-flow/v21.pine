if zcBearActive and (bar_index - zcBearBar) > i_zoneMemBars
    zcBearActive := false
decayBull = zcBullActive ? math.pow(i_dec_zoneRate, bar_index - zcBullBar) : 1.0
decayBear = zcBearActive ? math.pow(i_dec_zoneRate, bar_index - zcBearBar) : 1.0
effectiveZRS_bull = zcBullActive ? math.max(ZRS_bull, zcBullZRS * decayBull) : (anyBullZone ? ZRS_bull : 0.0)
effectiveZRS_bear = zcBearActive ? math.max(ZRS_bear, zcBearZRS * decayBear) : (anyBearZone ? ZRS_bear : 0.0)
effThreshBull = math.max(1, i_zrsThresh + pdModBull + stackModBull + (isChop ? 2 : 0) + (not sessEstablished ? 2 : 0))
effThreshBear = math.max(1, i_zrsThresh + pdModBear + stackModBear + (isChop ? 2 : 0) + (not sessEstablished ? 2 : 0))

var float moveAnchorPrice=na, var int moveAnchorDir=0, var int moveSignalCount=0
staleMoveDistance = not na(moveAnchorPrice) and not na(atr14) and atr14>0 ? math.abs(close-moveAnchorPrice)/atr14 : 0.0
staleAnchor = staleMoveDistance > i_moveATRLimit * i_move_staleMult
trendFlip = ta.change(swingTrend.bias) != 0
if staleAnchor or trendFlip
    moveAnchorPrice := close, moveAnchorDir := 0, moveSignalCount := 0
moveDistance = not na(moveAnchorPrice)?math.abs(close-moveAnchorPrice):0.0
moveATRs = (not na(atr14) and atr14>0)?moveDistance/atr14:0.0
moveExhausted = i_moveExhaust and (moveATRs>i_moveATRLimit or moveSignalCount>i_move_signalMax)
structAligned_bull = swingTrend.bias == BULLISH_C or (swingTrend.bias == BEARISH_C and intBullCHCount >= i_sh_chCount_strong)
structAligned_bear = swingTrend.bias == BEARISH_C or (swingTrend.bias == BULLISH_C and intBearCHCount >= i_sh_chCount_strong)
structPenaltyBull = structAligned_bull ? 0 : (swingTrend.bias == BEARISH_C and intBullCHCount == 1) ? i_pen_structFull : i_pen_structHalf
structPenaltyBear = structAligned_bear ? 0 : (swingTrend.bias == BULLISH_C and intBearCHCount == 1) ? i_pen_structFull : i_pen_structHalf
setupHPModBull = magnetBullR ? i_sm_magnet : retestBullR ? i_sm_retest : (swpBullValid and anyBullZone) ? i_sm_swpZone : (oteReaction and oteBias==1) ? i_sm_ote : breakerBullR ? i_sm_breaker : htfZoneBullR ? i_sm_htfZone : 0
setupHPModBear = magnetBearR ? i_sm_magnet : retestBearR ? i_sm_retest : (swpBearValid and anyBearZone) ? i_sm_swpZone : (oteReaction and oteBias==-1) ? i_sm_ote : breakerBearR ? i_sm_breaker : htfZoneBearR ? i_sm_htfZone : 0

posGroupBull = math.max(nearLo?i_hp_nearHL:0, extDisc?i_hp_extPD:0, hyperDisc_v17?i_hp_hyperPD:0, inDisc and pdPct<i_hp_midDiscMax?i_hp_midDisc:0)
posGroupBear = math.max(nearHi?i_hp_nearHL:0, extPrem?i_hp_extPD:0, hyperPrem_v17?i_hp_hyperPD:0, inPrem and pdPct>(100-i_hp_midDiscMax)?i_hp_midDisc:0)
flowGroupBull = math.max(pressShiftBull?i_hp_pressShift:0, viConvBull?i_hp_viConv:0, flowBull?i_hp_flowConf:0)
flowGroupBear = math.max(pressShiftBear?i_hp_pressShift:0, viConvBear?i_hp_viConv:0, flowBear?i_hp_flowConf:0)
timeGroupBull = math.max(inSB?i_hp_SB:0, timeScore>=i_hp_timeHiT?i_hp_timeHi:timeScore>=i_hp_timeMidT?i_hp_timeMid:0)
timeGroupBear = timeGroupBull
indepBull = (arsiBull?i_hp_arsi:0)+(smtB?i_hp_smt:0)+(possibilityBuy?i_hp_poss:0)+(anyDivBull?i_hp_div:0)+(dqBull>=i_hp_dqHiT?i_hp_dqHi:dqBull>=i_hp_dqMidT?i_hp_dqMid:0)+(ibBrokenUp?i_hp_ibBroken:0)+(breakerBullR?i_hp_brkInd:0)+((oteReaction and oteBias==1)?i_hp_oteInd:0)+(volR>=i_hp_volIndT?i_hp_volInd:0)
indepBear = (arsiBear?i_hp_arsi:0)+(smtS?i_hp_smt:0)+(possibilitySell?i_hp_poss:0)+(anyDivBear?i_hp_div:0)+(dqBear>=i_hp_dqHiT?i_hp_dqHi:dqBear>=i_hp_dqMidT?i_hp_dqMid:0)+(ibBrokenDn?i_hp_ibBroken:0)+(breakerBearR?i_hp_brkInd:0)+((oteReaction and oteBias==-1)?i_hp_oteInd:0)+(volR>=i_hp_volIndT?i_hp_volInd:0)
zrsBonusBull = math.round(ZRS_bull >= i_zrs_bonus_t3 ? i_zrs_bonus_v3 : ZRS_bull >= i_zrs_bonus_t2 ? i_zrs_bonus_v2 : ZRS_bull >= i_zrs_bonus_t1 ? i_zrs_bonus_v1 : 0)
zrsBonusBear = math.round(ZRS_bear >= i_zrs_bonus_t3 ? i_zrs_bonus_v3 : ZRS_bear >= i_zrs_bonus_t2 ? i_zrs_bonus_v2 : ZRS_bear >= i_zrs_bonus_t1 ? i_zrs_bonus_v1 : 0)
freshBonusBull = freshBull + partialPenBull
freshBonusBear = freshBear + partialPenBear
stackBonusBull = i_confluenceV2 ? confBullHP : (zoneStackBull >= 3 ? i_stackBonus_t3 : zoneStackBull >= 2 ? i_stackBonus_t2 : 0)
stackBonusBear = i_confluenceV2 ? confBearHP : (zoneStackBear >= 3 ? i_stackBonus_t3 : zoneStackBear >= 2 ? i_stackBonus_t2 : 0)
calcHPBull() =>
    h = posGroupBull + flowGroupBull + timeGroupBull + indepBull + zrsBonusBull + freshBonusBull + stackBonusBull + setupHPModBull + (retestBullR?i_sm_retest_extra:0)
    h -= isChop ? i_pen_chop : 0
    h -= strongSP ? i_pen_oppPress : 0
    h -= arsiBear ? i_pen_arsiOpp : 0
    h -= adrExhausted ? i_pen_adrExh : 0
    h -= cumDeltaDivBear ? i_pen_cumDelta : 0
    h -= moveExhausted and moveAnchorDir==1 ? i_pen_moveExh : 0
    h -= softBlockBuy ? i_pen_softBlock : 0
    h -= structPenaltyBull
    h
calcHPBear() =>
    h = posGroupBear + flowGroupBear + timeGroupBear + indepBear + zrsBonusBear + freshBonusBear + stackBonusBear + setupHPModBear + (retestBearR?i_sm_retest_extra:0)
    h -= isChop ? i_pen_chop : 0
    h -= strongBP ? i_pen_oppPress : 0
    h -= arsiBull ? i_pen_arsiOpp : 0
    h -= adrExhausted ? i_pen_adrExh : 0
    h -= cumDeltaDivBull ? i_pen_cumDelta : 0
    h -= moveExhausted and moveAnchorDir==-1 ? i_pen_moveExh : 0
    h -= softBlockSell ? i_pen_softBlock : 0
    h -= structPenaltyBear
    h
hpBullC = calcHPBull()
hpBearC = calcHPBear()
chopHardGate = i_chopHardGate and isChop and adx < i_reg_chopHard_adx
var tradeStats stats = tradeStats.new()

scanPrevDayOBBull() =>
    int touch = 0
    if intOBs.size() > 0
        for [idx, ob] in intOBs
            if ob.bias == BULLISH_C and low <= ob.bHigh and low >= ob.bLow
                daysOld = math.floor((time - ob.bTime) / 86400000.0)
                touch := daysOld >= 1 ? 2 : 1
                break
    if touch == 0 and swgOBs.size() > 0
        for [idx, ob] in swgOBs
            if ob.bias == BULLISH_C and low <= ob.bHigh and low >= ob.bLow
                daysOld = math.floor((time - ob.bTime) / 86400000.0)
                touch := daysOld >= 1 ? 2 : 1
                break
    touch
scanPrevDayOBBear() =>
    int touch = 0
    if intOBs.size() > 0
        for [idx, ob] in intOBs
            if ob.bias == BEARISH_C and high >= ob.bLow and high <= ob.bHigh
                daysOld = math.floor((time - ob.bTime) / 86400000.0)
                touch := daysOld >= 1 ? 2 : 1
                break
    if touch == 0 and swgOBs.size() > 0
        for [idx, ob] in swgOBs
            if ob.bias == BEARISH_C and high >= ob.bLow and high <= ob.bHigh
                daysOld = math.floor((time - ob.bTime) / 86400000.0)
                touch := daysOld >= 1 ? 2 : 1
                break
    touch
var int prevDayOBTouchBull = 0, var int prevDayOBTouchBear = 0
prevDayOBTouchBull := 0, prevDayOBTouchBear := 0
if i_prevDayOB and (intOBBullR or swgOBBullR)
    prevDayOBTouchBull := scanPrevDayOBBull()
if i_prevDayOB and (intOBBearR or swgOBBearR)
    prevDayOBTouchBear := scanPrevDayOBBear()
prevDayOBBullHP = i_prevDayOB and prevDayOBTouchBull == 2 ? i_hp_prevOB_old : prevDayOBTouchBull == 1 ? i_hp_prevOB_same : 0
prevDayOBBearHP = i_prevDayOB and prevDayOBTouchBear == 2 ? i_hp_prevOB_old : prevDayOBTouchBear == 1 ? i_hp_prevOB_same : 0
ny830Window = (barHour == i_kz_ny830_h1 and barMin >= i_kz_ny830_mLo and barMin <= i_kz_ny830_mHi) or (barHour == i_kz_ny830_h2 and barMin >= i_kz_ny830_mLo and barMin <= i_kz_ny830_mHi)
ldn800Window = (barHour == i_kz_ldn_h1 and barMin >= i_kz_ldn_m1) or (barHour == i_kz_ldn_h2 and barMin <= i_kz_ldn_m2)
inKillzoneSweep = i_killzoneBoost and (ny830Window or ldn800Window)
kzSweepHPBull = inKillzoneSweep and swpBullValid ? i_hp_kz_sweep : inKillzoneSweep ? i_hp_kz_alone : 0
kzSweepHPBear = inKillzoneSweep and swpBearValid ? i_hp_kz_sweep : inKillzoneSweep ? i_hp_kz_alone : 0
kzThreshRelief = inKillzoneSweep ? i_kz_relief : 0
eqSweepHPBull = i_eqSweep and eqLowSweptNow ? i_hp_eq_sweep : 0
eqSweepHPBear = i_eqSweep and eqHighSweptNow ? i_hp_eq_sweep : 0
var int lastBreakerBar = 0
var bool breakerJustFired = false
breakerJustFired := false
if breakers.size() > 0
    newestBB = breakers.get(0)
    if newestBB.birthBar == bar_index or newestBB.birthBar == bar_index - 1
        breakerJustFired := true, lastBreakerBar := bar_index
inBreakerVolWindow = i_breakerVol and (bar_index - lastBreakerBar) < i_brk_vol_window and (bar_index - lastBreakerBar) > 0 and (tkSt or lnSt or nySt or (bar_index - lastBreakerBar) < i_brk_vol_open)
breakerVolHPBull = inBreakerVolWindow and anyBullZone ? i_hp_brk_vol : 0
breakerVolHPBear = inBreakerVolWindow and anyBearZone ? i_hp_brk_vol : 0
v162HPBull = prevDayOBBullHP + kzSweepHPBull + eqSweepHPBull + breakerVolHPBull
v162HPBear = prevDayOBBearHP + kzSweepHPBear + eqSweepHPBear + breakerVolHPBear
hpBullC := hpBullC + v162HPBull
hpBearC := hpBearC + v162HPBear
effThreshBull := math.max(1, effThreshBull - kzThreshRelief)
effThreshBear := math.max(1, effThreshBear - kzThreshRelief)
// SIGNAL ENGINE
var int lastBuyBar=0, var int lastSellBar=0, var float lastBuyPrice=na, var float lastSellPrice=na
confirmedBar = barstate.isconfirmed
sessOK = not i_sessFilter or inActive
cdBuyBase = i_dirCooldown ? adaptCD*3 : adaptCD, cdSellBase = i_dirCooldown ? adaptCD*3 : adaptCD
cdBuyOK = (bar_index-lastBuyBar)>=cdBuyBase and (bar_index-lastSellBar)>=adaptCD
cdSellOK = (bar_index-lastSellBar)>=cdSellBase and (bar_index-lastBuyBar)>=adaptCD
distBuyOK = na(lastBuyPrice) or math.abs(close-lastBuyPrice)>atr14*i_swp_distBuyATR
distSellOK = na(lastSellPrice) or math.abs(close-lastSellPrice)>atr14*i_swp_distSellATR
sweepIntoZoneBull = swpBullValid and anyBullZone
sweepIntoZoneBear = swpBearValid and anyBearZone
confOverrideBull = i_confluenceV2 and confBullHP >= 6
confOverrideBear = i_confluenceV2 and confBearHP >= 6
zoneActive_bull = anyBullZone or zcBullActive
zoneActive_bear = anyBearZone or zcBearActive
zoneEntryBuy  = i_useZoneEntry and zoneActive_bull and biasAllowBuy and sessOK and confirmedBar and cdBuyOK and distBuyOK and not adrBlockBuy and not chopHardGate and (effectiveZRS_bull >= effThreshBull or sweepIntoZoneBull or confOverrideBull or magnetBullR)
zoneEntrySell = i_useZoneEntry and zoneActive_bear and biasAllowSell and sessOK and confirmedBar and cdSellOK and distSellOK and not adrBlockSell and not chopHardGate and (effectiveZRS_bear >= effThreshBear or sweepIntoZoneBear or confOverrideBear or magnetBearR)
classicBuy  = not i_useZoneEntry and anyBullZone and biasAllowBuy and shiftBull and cdBuyOK and distBuyOK and sessOK and confirmedBar and not adrBlockBuy and not chopHardGate
classicSell = not i_useZoneEntry and anyBearZone and biasAllowSell and shiftBear and cdSellOK and distSellOK and sessOK and confirmedBar and not adrBlockSell and not chopHardGate
var float pendBuyPrice=na, var int pendBuyBar=0, var bool pendBuyActive=false, var int pendBuyHP=0
var float pendSellPrice=na, var int pendSellBar=0, var bool pendSellActive=false, var int pendSellHP=0
var string pendBuyZone="", var string pendSellZone=""
var int pendBuyConf=0, var string pendBuyConfTag=""
var int pendSellConf=0, var string pendSellConfTag=""
if zoneEntryBuy and not pendBuyActive
    pendBuyPrice:=zcBullActive?nz(zcBullPrice,close):close
    pendBuyBar:=bar_index, pendBuyActive:=true, pendBuyHP:=hpBullC
    pendBuyZone:=zcBullActive?zcBullName:zName
    pendBuyConf:=zcBullActive?zcBullConf:confBullHP
    pendBuyConfTag:=zcBullActive?zcBullConfTag:confBullTag
    zcBullActive:=false
    if drawOK
        cTag = pendBuyConfTag != "" ? " "+pendBuyConfTag : ""
        label.new(bar_index,low,"◆ PENDING BUY\n"+pendBuyZone+" ZRS:"+str.tostring(effectiveZRS_bull,"#")+cTag+"\nEntry: "+str.tostring(pendBuyPrice,"#.#"),style=label.style_label_up,color=color.new(#00E5FF,20),textcolor=color.white,size=size.small,yloc=yloc.belowbar)
if zoneEntrySell and not pendSellActive
    pendSellPrice:=zcBearActive?nz(zcBearPrice,close):close
    pendSellBar:=bar_index, pendSellActive:=true, pendSellHP:=hpBearC
    pendSellZone:=zcBearActive?zcBearName:zName
    pendSellConf:=zcBearActive?zcBearConf:confBearHP
    pendSellConfTag:=zcBearActive?zcBearConfTag:confBearTag
    zcBearActive:=false
    if drawOK
        cTag2 = pendSellConfTag != "" ? " "+pendSellConfTag : ""
        label.new(bar_index,high,"◆ PENDING SELL\n"+pendSellZone+" ZRS:"+str.tostring(effectiveZRS_bear,"#")+cTag2+"\nEntry: "+str.tostring(pendSellPrice,"#.#"),style=label.style_label_down,color=color.new(#FF6D00,20),textcolor=color.white,size=size.small,yloc=yloc.abovebar)
var bool validatedBuy=false, var bool validatedSell=false
var bool invalidatedBuy=false, var bool invalidatedSell=false
validatedBuy:=false, validatedSell:=false, invalidatedBuy:=false, invalidatedSell:=false

// ═══ AI APPROVAL ENGINE ═══
var bool aiApprovedBuy = false, var bool aiApprovedSell = false
var int  aiBuyScore = 0,        var int  aiSellScore = 0
var int  aiBuyApprovedBar = 0,  var int  aiSellApprovedBar = 0
var float aiBuyApprovedPrice = na, var float aiSellApprovedPrice = na
aiApprovedBuy := false, aiApprovedSell := false

aiBuyApprovalScore() =>
    s = 0
    s += (volR >= i_ai_t_vol) ? i_ai_w_vol : 0
    s += (delta > 0 and delta[1] <= 0) ? i_ai_w_delta : 0
    s += (lowerWickR > i_ai_t_wick and close > open) ? i_ai_w_wick : 0
    s += (bullEngulf or morningStar) ? i_ai_w_pat : 0
    s += (aIntBullBOS or aIntBullCH or aSwgBullBOS or aSwgBullCH) ? i_ai_w_bos : 0
    s += (ZRS_bull >= i_zrsThresh) ? i_ai_w_zrs : 0
    s += swpBullValid ? i_ai_w_swp : 0
    s += (not na(htfCur) and not na(htfCurO) and htfCur > htfCurO) ? i_ai_w_htf : 0
    s += arsiBull ? i_ai_w_arsi : 0
    s += inKZ ? i_ai_w_kz : 0
    s += flowBull ? i_ai_w_flow : 0
    s += (not na(pendBuyPrice) and close > pendBuyPrice) ? i_ai_w_close : 0
    s

aiSellApprovalScore() =>
    s = 0
    s += (volR >= i_ai_t_vol) ? i_ai_w_vol : 0
    s += (delta < 0 and delta[1] >= 0) ? i_ai_w_delta : 0
    s += (upperWickR > i_ai_t_wick and close < open) ? i_ai_w_wick : 0
    s += (bearEngulf or eveningStar) ? i_ai_w_pat : 0
    s += (aIntBearBOS or aIntBearCH or aSwgBearBOS or aSwgBearCH) ? i_ai_w_bos : 0
    s += (ZRS_bear >= i_zrsThresh) ? i_ai_w_zrs : 0
    s += swpBearValid ? i_ai_w_swp : 0
    s += (not na(htfCur) and not na(htfCurO) and htfCur < htfCurO) ? i_ai_w_htf : 0
    s += arsiBear ? i_ai_w_arsi : 0
    s += inKZ ? i_ai_w_kz : 0
    s += flowBear ? i_ai_w_flow : 0
    s += (not na(pendSellPrice) and close < pendSellPrice) ? i_ai_w_close : 0
    s

var bool aiBuyFired = false,  var bool aiSellFired = false

if pendBuyActive
    elapsed=bar_index-pendBuyBar
    // AI APPROVAL — runs each bar while pending is active
    if i_useAI and elapsed > 0 and elapsed <= i_ai_window and not aiBuyFired
        score = aiBuyApprovalScore()
        aiBuyScore := score
        if score >= i_ai_min
            aiApprovedBuy := true, aiBuyFired := true
            aiBuyApprovedBar := bar_index
            aiBuyApprovedPrice := nz(pendBuyPrice, close)
    if elapsed>0 and elapsed<=adaptPendBars
        strictBull = isDispBull and close > nz(pendBuyPrice, close)
        if i_ai_runValid and strictBull
            validatedBuy:=true, pendBuyActive:=false
            pendBuyHP:=pendBuyHP+(shiftBull?i_val_pend_hpShift:0)+(dqBull>=i_hp_dqMidT?i_val_pend_hpDQ:0)+(strictBull?i_val_pend_hpStrict:0)
        else if not na(pendBuyPrice) and close<pendBuyPrice-atr14*i_val_invalATR
            invalidatedBuy:=true, pendBuyActive:=false, aiBuyFired := false
    else if elapsed>adaptPendBars
        invalidatedBuy:=true, pendBuyActive:=false, aiBuyFired := false
else
    aiBuyFired := false

if pendSellActive
    elapsed2=bar_index-pendSellBar
    if i_useAI and elapsed2 > 0 and elapsed2 <= i_ai_window and not aiSellFired
        score2 = aiSellApprovalScore()
        aiSellScore := score2
        if score2 >= i_ai_min
            aiApprovedSell := true, aiSellFired := true
            aiSellApprovedBar := bar_index
            aiSellApprovedPrice := nz(pendSellPrice, close)
    if elapsed2>0 and elapsed2<=adaptPendBars
        strictBear = isDispBear and close < nz(pendSellPrice, close)
        if i_ai_runValid and strictBear
            validatedSell:=true, pendSellActive:=false
            pendSellHP:=pendSellHP+(shiftBear?i_val_pend_hpShift:0)+(dqBear>=i_hp_dqMidT?i_val_pend_hpDQ:0)+(strictBear?i_val_pend_hpStrict:0)
        else if not na(pendSellPrice) and close>pendSellPrice+atr14*i_val_invalATR
            invalidatedSell:=true, pendSellActive:=false, aiSellFired := false
    else if elapsed2>adaptPendBars
        invalidatedSell:=true, pendSellActive:=false, aiSellFired := false
else
    aiSellFired := false

// Draw the AI APPROVED label
if i_ai_label and aiApprovedBuy and drawOK
    label.new(bar_index, low, "✓ AI APPROVED BUY\nScore: "+str.tostring(aiBuyScore)+"/"+str.tostring(i_ai_min)+"\n@ "+str.tostring(close,"#.#"), style=label.style_label_up, color=color.new(#FFD700,10), textcolor=color.black, size=size.normal, yloc=yloc.belowbar)
if i_ai_label and aiApprovedSell and drawOK
    label.new(bar_index, high, "✓ AI APPROVED SELL\nScore: "+str.tostring(aiSellScore)+"/"+str.tostring(i_ai_min)+"\n@ "+str.tostring(close,"#.#"), style=label.style_label_down, color=color.new(#FFD700,10), textcolor=color.black, size=size.normal, yloc=yloc.abovebar)

BUY  = validatedBuy or classicBuy or (i_ai_actAsBUY and aiApprovedBuy)
SELL = validatedSell or classicSell or (i_ai_actAsBUY and aiApprovedSell)

finalHPBull = validatedBuy?pendBuyHP:hpBullC, finalHPBear = validatedSell?pendSellHP:hpBearC
HP_BUY = BUY and finalHPBull>=rHPThresh, HP_SELL = SELL and finalHPBear>=rHPThresh
tierBuy  = magnetBullR ? "S" : (confBullHP >= 6 and finalHPBull >= rHPThresh + 3) ? "A+" : (confBullHP >= 4 and finalHPBull >= rHPThresh) ? "A" : finalHPBull >= rHPThresh ? "B" : "C"
tierSell = magnetBearR ? "S" : (confBearHP >= 6 and finalHPBear >= rHPThresh + 3) ? "A+" : (confBearHP >= 4 and finalHPBear >= rHPThresh) ? "A" : finalHPBear >= rHPThresh ? "B" : "C"
grade = BUY?tierBuy:SELL?tierSell:""
float entryPrice = BUY?(validatedBuy and not na(pendBuyPrice)?pendBuyPrice:close):SELL?(validatedSell and not na(pendSellPrice)?pendSellPrice:close):na
setupName = magnetBullR or magnetBearR ? "★ MAGNET" : validatedBuy or validatedSell ? "ZONE ENTRY ✓" : retestBullR or retestBearR ? "BOS RETEST" : sweepIntoZoneBull or sweepIntoZoneBear ? "SWEEP+ZONE" : htfZoneBullR or htfZoneBearR ? "HTF ZONE" : breakerBullR or breakerBearR ? "BREAKER" : "ZONE TAP"
hasFlow = (BUY and flowBull) or (SELL and flowBear)
flowTag = hasFlow?" +FLOW":""
confTagFinal = validatedBuy and pendBuyConfTag!="" ? " "+pendBuyConfTag : validatedSell and pendSellConfTag!="" ? " "+pendSellConfTag : confBullTag!="" and BUY ? " "+confBullTag : confBearTag!="" and SELL ? " "+confBearTag : ""
zrsTag = validatedBuy?" ZRS:"+str.tostring(ZRS_bull,"#"):validatedSell?" ZRS:"+str.tostring(ZRS_bear,"#"):""
entTxt = not na(entryPrice)?"\nEntry: "+str.tostring(entryPrice,"#.#"):""
dqTxt = BUY?"\nDQ:"+str.tostring(dqBull):SELL?"\nDQ:"+str.tostring(dqBear):""
usedZoneName = validatedBuy?pendBuyZone:validatedSell?pendSellZone:zName
freshTag = (BUY and (intOBBullR or swgOBBullR)) ? " T"+str.tostring(obTouchCountBull) : (SELL and (intOBBearR or swgOBBearR)) ? " T"+str.tostring(obTouchCountBear) : ""
magTag = (BUY and magnetBullR) or (SELL and magnetBearR) ? " ★MAG×"+str.tostring(magnetTouchCount) : ""
patTag = (BUY and breakerBullR and bullPatternOK) ? " +"+patternTag : (SELL and breakerBearR and bearPatternOK) ? " +"+patternTag : ""

if BUY
    lastBuyBar:=bar_index, lastBuyPrice:=nz(entryPrice,close)
    if moveAnchorDir!=1
        moveAnchorPrice:=nz(entryPrice,close), moveAnchorDir:=1, moveSignalCount:=1
    else
        moveSignalCount+=1
if SELL
    lastSellBar:=bar_index, lastSellPrice:=nz(entryPrice,close)
    if moveAnchorDir!=-1
        moveAnchorPrice:=nz(entryPrice,close), moveAnchorDir:=-1, moveSignalCount:=1
    else
        moveSignalCount+=1

drawBuyLabel() =>
    if HP_BUY
        label.new(bar_index,low,"★ "+grade+" BUY"+flowTag+zrsTag+confTagFinal+freshTag+magTag+patTag+"\n"+setupName+" | "+usedZoneName+entTxt+dqTxt,style=label.style_label_up,color=color.green,textcolor=color.white,size=size.normal,yloc=yloc.belowbar)
    else if BUY
        label.new(bar_index,low,grade+" BUY"+flowTag+freshTag+magTag+patTag+"\n"+setupName+" | "+usedZoneName+entTxt,style=label.style_label_up,color=color.new(color.green,40),textcolor=color.white,size=size.small,yloc=yloc.belowbar)
    0
drawSellLabel() =>
    if HP_SELL
        label.new(bar_index,high,"★ "+grade+" SELL"+flowTag+zrsTag+confTagFinal+freshTag+magTag+patTag+"\n"+setupName+" | "+usedZoneName+entTxt+dqTxt,style=label.style_label_down,color=color.red,textcolor=color.white,size=size.normal,yloc=yloc.abovebar)
    else if SELL
        label.new(bar_index,high,grade+" SELL"+flowTag+freshTag+magTag+patTag+"\n"+setupName+" | "+usedZoneName+entTxt,style=label.style_label_down,color=color.new(color.red,40),textcolor=color.white,size=size.small,yloc=yloc.abovebar)
    0
if drawOK and (BUY or HP_BUY)
    drawBuyLabel()
if drawOK and (SELL or HP_SELL)
    drawSellLabel()

// ═══ TP/SL DISPLAY with v18 FIXED $ override for gold ═══
var array<box>   buyTpB  = array.new<box>(),   var array<box>   sellTpB  = array.new<box>()
var array<line>  buyTpL  = array.new<line>(),  var array<line>  sellTpL  = array.new<line>()
var array<label> buyTpLb = array.new<label>(), var array<label> sellTpLb = array.new<label>()

clearTpslSide(array<box> bArr, array<line> lArr, array<label> lbArr) =>
    while bArr.size() > 0
        box.delete(bArr.shift())
    while lArr.size() > 0
        line.delete(lArr.shift())
    while lbArr.size() > 0
        label.delete(lbArr.shift())
    0

calcBuyLevels(float entry) =>
    sl     = entry - atr14 * i_fb_slATR
    tp1    = entry + atr14 * i_tp1ATRMult
    tp2    = entry + atr14 * i_tp2ATRMult
    runner = entry + atr14 * i_tpHardCap
    [sl, tp1, tp2, runner]

calcSellLevels(float entry) =>
    sl     = entry + atr14 * i_fb_slATR
    tp1    = entry - atr14 * i_tp1ATRMult
    tp2    = entry - atr14 * i_tp2ATRMult
    runner = entry - atr14 * i_tpHardCap
    [sl, tp1, tp2, runner]

drawBuyTpsl(float entry, float sl, float tp1, float tp2, float runner) =>
    clearTpslSide(buyTpB, buyTpL, buyTpLb)
    buyTpB.push(box.new(bar_index, entry, bar_index+20, runner, bgcolor=color.new(color.green,90), border_color=color.new(color.green,50), border_width=1))
    buyTpB.push(box.new(bar_index, entry, bar_index+20, sl,     bgcolor=color.new(color.red,90),   border_color=color.new(color.red,50),   border_width=1))
    buyTpL.push(line.new(bar_index, tp1,    bar_index+20, tp1,    color=color.new(color.green,40), style=line.style_dashed, width=1))
    buyTpL.push(line.new(bar_index, tp2,    bar_index+20, tp2,    color=color.new(color.green,30), style=line.style_dashed, width=1))
    buyTpL.push(line.new(bar_index, runner, bar_index+20, runner, color=color.new(color.green,10), style=line.style_solid,  width=2))
    buyTpLb.push(label.new(bar_index+21, tp1,    "TP1 "+str.tostring(tp1,"#.#"),       color=color(na), textcolor=color.green, style=label.style_label_left, size=size.tiny))
    buyTpLb.push(label.new(bar_index+21, tp2,    "TP2 "+str.tostring(tp2,"#.#"),       color=color(na), textcolor=color.green, style=label.style_label_left, size=size.tiny))
    buyTpLb.push(label.new(bar_index+21, runner, "RUN★ "+str.tostring(runner,"#.#"),   color=color(na), textcolor=color.green, style=label.style_label_left, size=size.small))
    0

drawSellTpsl(float entry, float sl, float tp1, float tp2, float runner) =>
    clearTpslSide(sellTpB, sellTpL, sellTpLb)
    sellTpB.push(box.new(bar_index, entry, bar_index+20, runner, bgcolor=color.new(color.red,90),   border_color=color.new(color.red,50),   border_width=1))
    sellTpB.push(box.new(bar_index, entry, bar_index+20, sl,     bgcolor=color.new(color.green,90), border_color=color.new(color.green,50), border_width=1))
    sellTpL.push(line.new(bar_index, tp1,    bar_index+20, tp1,    color=color.new(color.red,40), style=line.style_dashed, width=1))
    sellTpL.push(line.new(bar_index, tp2,    bar_index+20, tp2,    color=color.new(color.red,30), style=line.style_dashed, width=1))
    sellTpL.push(line.new(bar_index, runner, bar_index+20, runner, color=color.new(color.red,10), style=line.style_solid,  width=2))
    sellTpLb.push(label.new(bar_index+21, tp1,    "TP1 "+str.tostring(tp1,"#.#"),     color=color(na), textcolor=color.red, style=label.style_label_left, size=size.tiny))
    sellTpLb.push(label.new(bar_index+21, tp2,    "TP2 "+str.tostring(tp2,"#.#"),     color=color(na), textcolor=color.red, style=label.style_label_left, size=size.tiny))
    sellTpLb.push(label.new(bar_index+21, runner, "RUN★ "+str.tostring(runner,"#.#"), color=color(na), textcolor=color.red, style=label.style_label_left, size=size.small))
    0

if i_showTPSL and BUY and not na(entryPrice) and drawOK
    [bSL, bTP1, bTP2, bRun] = calcBuyLevels(entryPrice)
    drawBuyTpsl(entryPrice, bSL, bTP1, bTP2, bRun)
if i_showTPSL and SELL and not na(entryPrice) and drawOK
    [sSL, sTP1, sTP2, sRun] = calcSellLevels(entryPrice)
    drawSellTpsl(entryPrice, sSL, sTP1, sTP2, sRun)

// ═══ PRE-SIGNAL ENGINE ═══
preSignalBuy = i_usePreSignal and not BUY and anyBullZone and biasAllowBuy and (effectiveZRS_bull >= effThreshBull - i_ps_zrsRelax or confBullHP >= i_ps_confMin) and not chopHardGate and not adrBlockBuy and (bar_index - lastBuyBar) >= adaptCD
preSignalSell = i_usePreSignal and not SELL and anyBearZone and biasAllowSell and (effectiveZRS_bear >= effThreshBear - i_ps_zrsRelax or confBearHP >= i_ps_confMin) and not chopHardGate and not adrBlockSell and (bar_index - lastSellBar) >= adaptCD
drawPreSignals() =>
    if preSignalBuy
        label.new(bar_index, low, "▲", style=label.style_label_up, color=color.new(#00BCD4, 60), textcolor=color.white, size=size.tiny, yloc=yloc.belowbar, tooltip="PRE-SIG BUY  HP:"+str.tostring(hpBullC)+" ZRS:"+str.tostring(effectiveZRS_bull,"#"))
    if preSignalSell
        label.new(bar_index, high, "▼", style=label.style_label_down, color=color.new(#E040FB, 60), textcolor=color.white, size=size.tiny, yloc=yloc.abovebar, tooltip="PRE-SIG SELL  HP:"+str.tostring(hpBearC)+" ZRS:"+str.tostring(effectiveZRS_bear,"#"))
    0
if drawOK and (preSignalBuy or preSignalSell)
    drawPreSignals()

// ═══ WR TRACKER with REAL $ TRACKING ═══
var activeTrade aBuy  = activeTrade.new()
var activeTrade aSell = activeTrade.new()
bumpSetup(string setup, bool isWin) =>
    if setup == "★ MAGNET"
        stats.magnetT += 1
        stats.magnetW += isWin ? 1 : 0
    else if setup == "BOS RETEST"
        stats.bosRetestT += 1
        stats.bosRetestW += isWin ? 1 : 0
    else if setup == "SWEEP+ZONE"
        stats.sweepZoneT += 1
        stats.sweepZoneW += isWin ? 1 : 0
    else if setup == "ZONE ENTRY ✓"
        stats.zoneEntryT += 1
        stats.zoneEntryW += isWin ? 1 : 0
    else
        stats.zoneTapT += 1
        stats.zoneTapW += isWin ? 1 : 0
    0
openBuy() =>
    aBuy.entry := entryPrice, aBuy.bar := bar_index, aBuy.setup := setupName
    aBuy.sl := entryPrice - atr14 * i_fb_slATR
    aBuy.tp := entryPrice + atr14 * i_fb_tpATR_wr
    0
openSell() =>
    aSell.entry := entryPrice, aSell.bar := bar_index, aSell.setup := setupName
    aSell.sl := entryPrice + atr14 * i_fb_slATR
    aSell.tp := entryPrice - atr14 * i_fb_tpATR_wr
    0
updateBuy() =>
    hitTP = high >= aBuy.tp
    hitSL = low  <= aBuy.sl
    stale = (bar_index - aBuy.bar) > i_fb_staleBars
    if hitTP
        stats.totalBuy += 1, stats.winBuy += 1
        pnlD = aBuy.tp - aBuy.entry
        stats.totalPnL += pnlD, stats.winSumDollars += pnlD
        stats.largestWin := math.max(stats.largestWin, pnlD)
        risk = aBuy.entry - aBuy.sl
        rMult = risk > 0 ? pnlD / risk : 0
        stats.rSumWin += rMult, stats.rWinCount += 1
        bumpSetup(aBuy.setup, true)
        aBuy.entry := na, stats.consecLosses := 0
    else if hitSL
        stats.totalBuy += 1
        pnlD2 = aBuy.sl - aBuy.entry
        stats.totalPnL += pnlD2, stats.lossSumDollars += math.abs(pnlD2)
        stats.largestLoss := math.max(stats.largestLoss, math.abs(pnlD2))
        stats.rSumLoss += 1, stats.rLossCount += 1
        bumpSetup(aBuy.setup, false)
        aBuy.entry := na, stats.consecLosses += 1
    else if stale
        aBuy.entry := na
    0
updateSell() =>
    hitTPs = low  <= aSell.tp
    hitSLs = high >= aSell.sl
    stales = (bar_index - aSell.bar) > i_fb_staleBars
    if hitTPs
        stats.totalSell += 1, stats.winSell += 1
        pnlDs = aSell.entry - aSell.tp
        stats.totalPnL += pnlDs, stats.winSumDollars += pnlDs
        stats.largestWin := math.max(stats.largestWin, pnlDs)
        risks = aSell.sl - aSell.entry
        rMults = risks > 0 ? pnlDs / risks : 0
        stats.rSumWin += rMults, stats.rWinCount += 1
        bumpSetup(aSell.setup, true)
        aSell.entry := na, stats.consecLosses := 0
    else if hitSLs
        stats.totalSell += 1
        pnlDs2 = aSell.entry - aSell.sl
        stats.totalPnL += pnlDs2, stats.lossSumDollars += math.abs(pnlDs2)
        stats.largestLoss := math.max(stats.largestLoss, math.abs(pnlDs2))
        stats.rSumLoss += 1, stats.rLossCount += 1
        bumpSetup(aSell.setup, false)
        aSell.entry := na, stats.consecLosses += 1
    else if stales
        aSell.entry := na
    0
if HP_BUY and na(aBuy.entry)
    openBuy()
if HP_SELL and na(aSell.entry)
    openSell()
if not na(aBuy.entry)
    updateBuy()
if not na(aSell.entry)
    updateSell()

wrTotal = stats.totalBuy + stats.totalSell
wrWin = stats.winBuy + stats.winSell
wrPct = wrTotal > 0 ? wrWin * 100.0 / wrTotal : 0
avgWinR = stats.rWinCount > 0 ? stats.rSumWin / stats.rWinCount : 0
avgLossR = stats.rLossCount > 0 ? stats.rSumLoss / stats.rLossCount : 0
expectancy = stats.rWinCount + stats.rLossCount > 0 ? (stats.rSumWin - stats.rSumLoss) / (stats.rWinCount + stats.rLossCount) : 0
avgWinD = stats.rWinCount > 0 ? stats.winSumDollars / stats.rWinCount : 0
avgLossD = stats.rLossCount > 0 ? stats.lossSumDollars / stats.rLossCount : 0
profitFactor = stats.lossSumDollars > 0 ? stats.winSumDollars / stats.lossSumDollars : 0

// ═══ LIVE TRADE QUALITY MONITOR ═══
tradeWarnExitBuy = i_useTradeQual and not na(aBuy.entry) and (cumDeltaDivBear or anyBearZone or (atr14 > atr200 * 1.5))
tradeWarnExitSell = i_useTradeQual and not na(aSell.entry) and (cumDeltaDivBull or anyBullZone or (atr14 > atr200 * 1.5))
if tradeWarnExitBuy and drawOK and barstate.isconfirmed
    label.new(bar_index, high, "⚠ TRADE WARN", style=label.style_label_down, color=color.new(#FF9800, 30), textcolor=color.white, size=size.tiny, yloc=yloc.abovebar)
if tradeWarnExitSell and drawOK and barstate.isconfirmed
    label.new(bar_index, low, "⚠ TRADE WARN", style=label.style_label_up, color=color.new(#FF9800, 30), textcolor=color.white, size=size.tiny, yloc=yloc.belowbar)

// ═══ PLOTS ═══
plot(i_showEMA?eF:na, "EMA 9", color.new(#FFEB3B, 30))
plot(i_showEMA?eM:na, "EMA 21", color.new(#FF9800, 30))
plot(i_showEMA?eS:na, "EMA 50", color.new(#9C27B0, 30))
plot(i_showEMA?e200:na, "EMA 200", color.new(#F44336, 30), linewidth=2)
plot(i_showVWAP?vwap:na, "VWAP", color.new(#00BCD4, 20), linewidth=2)
plot(i_showPDHL?pdh:na, "PDH", color.new(#4CAF50, 30), style=plot.style_circles)
plot(i_showPDHL?pdl:na, "PDL", color.new(#F44336, 30), style=plot.style_circles)
plotshape(stBull and not stBull[1]?stV:na, "ST▲", shape.triangleup, location.belowbar, color.new(#4CAF50, 30), size=size.tiny)
plotshape(not stBull and stBull[1]?stV:na, "ST▼", shape.triangledown, location.abovebar, color.new(#F44336, 30), size=size.tiny)
plotshape(HP_BUY, "HP BUY", shape.labelup, location.belowbar, color.new(color.green, 0), text="HP", textcolor=color.white, size=size.tiny)
plotshape(HP_SELL, "HP SELL", shape.labeldown, location.abovebar, color.new(color.red, 0), text="HP", textcolor=color.white, size=size.tiny)
plotshape(magnetBullR, "MAG B", shape.circle, location.belowbar, color.new(#FFD700, 20), size=size.tiny)
plotshape(magnetBearR, "MAG S", shape.circle, location.abovebar, color.new(#FFD700, 20), size=size.tiny)
bgcolor(i_showSessBG and inTK?color.new(i_tokyoCol,i_sessBGTransp):na)
bgcolor(i_showSessBG and inLN?color.new(i_londonCol,i_sessBGTransp):na)
bgcolor(i_showSessBG and inNY?color.new(i_nyCol,i_sessBGTransp):na)
bgcolor(i_showPDZ and hyperPrem_v17?color.new(#B71C1C,85):i_showPDZ and extPrem?color.new(i_premCol,80):na)
bgcolor(i_showPDZ and hyperDisc_v17?color.new(#1B5E20,85):i_showPDZ and extDisc?color.new(i_discCol,80):na)
barcolor(HP_BUY?color.green:HP_SELL?color.red:na)

// ═══ DASHBOARD (split functions to stay within Pine 254-element limit) ═══
var table dash = table.new(position.top_right, 4, 18, frame_color=color.gray, frame_width=1, border_color=color.new(color.gray,70), border_width=1)
drawDashTop() =>
    biasCol = biasIsBull?color.new(#4CAF50,15):biasIsBear?color.new(#F44336,15):color.new(color.gray,15)
    structCol = swingTrend.bias==BULLISH_C?color.new(#4CAF50,30):swingTrend.bias==BEARISH_C?color.new(#F44336,30):color.new(color.gray,30)
    zoneCol = (anyBullZone or zcBullActive)?color.new(#4CAF50,30):(anyBearZone or zcBearActive)?color.new(#F44336,30):color.new(color.gray,40)
    table.cell(dash, 0, 0, "QUANTUM FLOW v18.0", text_color=color.white, bgcolor=color.new(#1A237E, 0), text_size=size.small, text_halign=text.align_center)
    table.merge_cells(dash, 0, 0, 3, 0)
    table.cell(dash, 0, 1, "BIAS", text_color=color.white, bgcolor=biasCol, text_size=size.tiny)
    table.cell(dash, 1, 1, biasTxt, text_color=color.white, bgcolor=biasCol, text_size=size.tiny)
    table.cell(dash, 2, 1, str.tostring(combBias), text_color=color.white, bgcolor=biasCol, text_size=size.tiny)
    table.cell(dash, 3, 1, htfLabel+"/"+ltfLabel, text_color=color.white, bgcolor=biasCol, text_size=size.tiny)
    table.cell(dash, 0, 2, "STRUCT", text_color=color.white, bgcolor=structCol, text_size=size.tiny)
    structTxt = swingTrend.bias==BULLISH_C?"BULL":swingTrend.bias==BEARISH_C?"BEAR":"NEUT"
    table.cell(dash, 1, 2, structTxt, text_color=color.white, bgcolor=structCol, text_size=size.tiny)
    table.cell(dash, 2, 2, "CH:"+str.tostring(intBullCHCount)+"/"+str.tostring(intBearCHCount), text_color=color.white, bgcolor=structCol, text_size=size.tiny)
    table.cell(dash, 3, 2, possibilityBuy?"⚠B":possibilitySell?"⚠S":"—", text_color=color.white, bgcolor=structCol, text_size=size.tiny)
    table.cell(dash, 0, 3, "ZONES", text_color=color.white, bgcolor=zoneCol, text_size=size.tiny)
    table.cell(dash, 1, 3, zName, text_color=color.white, bgcolor=zoneCol, text_size=size.tiny)
    table.cell(dash, 2, 3, "STK:"+str.tostring(math.max(zoneStackBull,zoneStackBear)), text_color=color.white, bgcolor=zoneCol, text_size=size.tiny)
    table.cell(dash, 3, 3, "F:"+str.tostring(math.max(freshBull,freshBear)), text_color=color.white, bgcolor=zoneCol, text_size=size.tiny)
drawDashMid() =>
    magCol = (magnetBullR or magnetBearR)?color.new(#FFD700,15):color.new(color.gray,50)
    confCol = (confBullHP>=4 or confBearHP>=4)?color.new(#9C27B0,20):color.new(color.gray,50)
    moveCol = moveExhausted?color.new(#F44336,30):color.new(color.gray,50)
    regCol = isChop?color.new(#FF9800,20):isTrend?color.new(#4CAF50,30):color.new(color.gray,50)
    volCol = volR>=1.5?color.new(#9C27B0,20):color.new(color.gray,50)
    table.cell(dash, 0, 4, "MAGNET", text_color=color.white, bgcolor=magCol, text_size=size.tiny)
    magTxt = (magnetBullR or magnetBearR)?"HIT ×"+str.tostring(magnetTouchCount):"—"
    table.cell(dash, 1, 4, magTxt, text_color=color.white, bgcolor=magCol, text_size=size.tiny)
    magWR = (magnetWins+magnetLosses)>0?str.tostring(math.round(magnetBayesWR*100))+"%":"—"
    table.cell(dash, 2, 4, "WR:"+magWR, text_color=color.white, bgcolor=magCol, text_size=size.tiny)
    table.cell(dash, 3, 4, "Bayes", text_color=color.white, bgcolor=magCol, text_size=size.tiny)
    table.cell(dash, 0, 5, "CONF", text_color=color.white, bgcolor=confCol, text_size=size.tiny)
    confTxt = confBullHP>0?confBullTag+" "+str.tostring(confBullHP):confBearHP>0?confBearTag+" "+str.tostring(confBearHP):"—"
    table.cell(dash, 1, 5, confTxt, text_color=color.white, bgcolor=confCol, text_size=size.tiny)
    zrsTxt2 = "B:"+str.tostring(effectiveZRS_bull,"#")+"/"+str.tostring(effThreshBull)+" S:"+str.tostring(effectiveZRS_bear,"#")+"/"+str.tostring(effThreshBear)
    table.cell(dash, 2, 5, zrsTxt2, text_color=color.white, bgcolor=confCol, text_size=size.tiny)
    pendTxt = pendBuyActive?"◆B "+str.tostring(adaptPendBars-(bar_index-pendBuyBar)):pendSellActive?"◆S "+str.tostring(adaptPendBars-(bar_index-pendSellBar)):"—"
    table.cell(dash, 3, 5, pendTxt, text_color=color.white, bgcolor=confCol, text_size=size.tiny)
    table.cell(dash, 0, 6, "MOVE", text_color=color.white, bgcolor=moveCol, text_size=size.tiny)
    table.cell(dash, 1, 6, str.tostring(moveATRs,"#.#")+" ATR", text_color=color.white, bgcolor=moveCol, text_size=size.tiny)
    table.cell(dash, 2, 6, "Sig:"+str.tostring(moveSignalCount)+"/"+(moveAnchorDir==1?"▲":moveAnchorDir==-1?"▼":"—"), text_color=color.white, bgcolor=moveCol, text_size=size.tiny)
    table.cell(dash, 3, 6, "LSS:"+str.tostring(stats.consecLosses), text_color=color.white, bgcolor=moveCol, text_size=size.tiny)
    table.cell(dash, 0, 7, "REGIME", text_color=color.white, bgcolor=regCol, text_size=size.tiny)
    table.cell(dash, 1, 7, regTxt, text_color=color.white, bgcolor=regCol, text_size=size.tiny)
    table.cell(dash, 2, 7, "ADX:"+str.tostring(adx,"#"), text_color=color.white, bgcolor=regCol, text_size=size.tiny)
    table.cell(dash, 3, 7, wyTxt, text_color=color.white, bgcolor=regCol, text_size=size.tiny)
    table.cell(dash, 0, 8, "VOL", text_color=color.white, bgcolor=volCol, text_size=size.tiny)
    table.cell(dash, 1, 8, viType, text_color=color.white, bgcolor=volCol, text_size=size.tiny)
    table.cell(dash, 2, 8, str.tostring(volR,"#.#")+"x", text_color=color.white, bgcolor=volCol, text_size=size.tiny)
    table.cell(dash, 3, 8, strongBP?"BP↑":strongSP?"SP↓":"—", text_color=color.white, bgcolor=volCol, text_size=size.tiny)
drawDashState() =>
    sessCol = inSB?color.new(#FFD700,20):inActive?color.new(#2196F3,30):color.new(color.gray,50)
    smtCol = (smtB or smtS)?color.new(#E91E63,20):color.new(color.gray,50)
    readCol = HP_BUY?color.new(#4CAF50,10):HP_SELL?color.new(#F44336,10):BUY?color.new(#4CAF50,30):SELL?color.new(#F44336,30):color.new(color.gray,40)
    table.cell(dash, 0, 9, "SESS", text_color=color.white, bgcolor=sessCol, text_size=size.tiny)
    sessTxt = inSB?"SILVER BULLET":inTK?"TOKYO":inLN and inNY?"LDN+NY":inLN?"LONDON":inNY?"NEW YORK":"OFF"
    table.cell(dash, 1, 9, sessTxt, text_color=color.white, bgcolor=sessCol, text_size=size.tiny)
    table.cell(dash, 2, 9, sessionPhase, text_color=color.white, bgcolor=sessCol, text_size=size.tiny)
    table.cell(dash, 3, 9, "T:"+str.tostring(timeScore), text_color=color.white, bgcolor=sessCol, text_size=size.tiny)
    table.cell(dash, 0, 10, "CORR", text_color=color.white, bgcolor=smtCol, text_size=size.tiny)
    table.cell(dash, 1, 10, smtSym, text_color=color.white, bgcolor=smtCol, text_size=size.tiny)
    table.cell(dash, 2, 10, str.tostring(smtCorr,"#.##"), text_color=color.white, bgcolor=smtCol, text_size=size.tiny)
    table.cell(dash, 3, 10, smtB?"SMT▲":smtS?"SMT▼":"—", text_color=color.white, bgcolor=smtCol, text_size=size.tiny)
    table.cell(dash, 0, 11, "READ", text_color=color.white, bgcolor=readCol, text_size=size.small, text_halign=text.align_center)
    readTxt = HP_BUY?"★ "+tierBuy+" BUY":HP_SELL?"★ "+tierSell+" SELL":aiApprovedBuy?"✓ AI BUY":aiApprovedSell?"✓ AI SELL":BUY?tierBuy+" BUY":SELL?tierSell+" SELL":pendBuyActive?"◆ PEND B (AI:"+str.tostring(aiBuyScore)+"/"+str.tostring(i_ai_min)+")":pendSellActive?"◆ PEND S (AI:"+str.tostring(aiSellScore)+"/"+str.tostring(i_ai_min)+")":preSignalBuy?"PRE▲":preSignalSell?"PRE▼":"NEUTRAL"
    table.cell(dash, 1, 11, readTxt, text_color=color.white, bgcolor=readCol, text_size=size.small, text_halign=text.align_center)
    table.merge_cells(dash, 1, 11, 3, 11)
drawDashFoot() =>
    wrCol = wrPct>=60?color.new(#4CAF50,20):wrPct>=45?color.new(#FF9800,30):color.new(#F44336,30)
    pnlCol = stats.totalPnL>=0?color.new(#4CAF50,15):color.new(#F44336,15)
    table.cell(dash, 0, 12, "TRACK", text_color=color.white, bgcolor=wrCol, text_size=size.tiny)
    table.cell(dash, 1, 12, "WR:"+str.tostring(math.round(wrPct))+"%", text_color=color.white, bgcolor=wrCol, text_size=size.tiny)
    table.cell(dash, 2, 12, "W:"+str.tostring(wrWin)+"/"+str.tostring(wrTotal), text_color=color.white, bgcolor=wrCol, text_size=size.tiny)
    table.cell(dash, 3, 12, "B:"+str.tostring(stats.winBuy)+"/"+str.tostring(stats.totalBuy)+" S:"+str.tostring(stats.winSell)+"/"+str.tostring(stats.totalSell), text_color=color.white, bgcolor=wrCol, text_size=size.tiny)
    table.cell(dash, 0, 13, "R:R", text_color=color.white, bgcolor=color.new(color.gray,50), text_size=size.tiny)
    table.cell(dash, 1, 13, "Avg W:"+str.tostring(avgWinR,"#.#")+"R", text_color=color.white, bgcolor=color.new(color.gray,50), text_size=size.tiny)
    table.cell(dash, 2, 13, "Avg L:"+str.tostring(avgLossR,"#.#")+"R", text_color=color.white, bgcolor=color.new(color.gray,50), text_size=size.tiny)
    table.cell(dash, 3, 13, "Exp:"+str.tostring(expectancy,"#.##")+"R", text_color=color.white, bgcolor=color.new(color.gray,50), text_size=size.tiny)
    table.cell(dash, 0, 14, "$ P&L", text_color=color.white, bgcolor=pnlCol, text_size=size.tiny)
    table.cell(dash, 1, 14, (stats.totalPnL>=0?"+$":"-$")+str.tostring(math.abs(stats.totalPnL),"#.#"), text_color=color.white, bgcolor=pnlCol, text_size=size.tiny)
    table.cell(dash, 2, 14, "AvgW:$"+str.tostring(avgWinD,"#.#"), text_color=color.white, bgcolor=pnlCol, text_size=size.tiny)
    table.cell(dash, 3, 14, "PF:"+str.tostring(profitFactor,"#.##"), text_color=color.white, bgcolor=pnlCol, text_size=size.tiny)
    table.cell(dash, 0, 15, "SETUPS", text_color=color.white, bgcolor=color.new(color.gray,50), text_size=size.tiny)
    setupTxt1 = "MAG:"+str.tostring(stats.magnetW)+"/"+str.tostring(stats.magnetT)
    setupTxt2 = "BOS:"+str.tostring(stats.bosRetestW)+"/"+str.tostring(stats.bosRetestT)
    setupTxt3 = "SWP:"+str.tostring(stats.sweepZoneW)+"/"+str.tostring(stats.sweepZoneT)+" Z:"+str.tostring(stats.zoneEntryW+stats.zoneTapW)+"/"+str.tostring(stats.zoneEntryT+stats.zoneTapT)
    table.cell(dash, 1, 15, setupTxt1, text_color=color.white, bgcolor=color.new(color.gray,50), text_size=size.tiny)
    table.cell(dash, 2, 15, setupTxt2, text_color=color.white, bgcolor=color.new(color.gray,50), text_size=size.tiny)
    table.cell(dash, 3, 15, setupTxt3, text_color=color.white, bgcolor=color.new(color.gray,50), text_size=size.tiny)
    table.cell(dash, 0, 16, "THRESH", text_color=color.white, bgcolor=color.new(color.gray,60), text_size=size.tiny)
    table.cell(dash, 1, 16, "HP:"+str.tostring(rHPThresh), text_color=color.white, bgcolor=color.new(color.gray,60), text_size=size.tiny)
    table.cell(dash, 2, 16, "ZRS:"+str.tostring(i_zrsThresh), text_color=color.white, bgcolor=color.new(color.gray,60), text_size=size.tiny)
    table.cell(dash, 3, 16, "CD:"+str.tostring(i_cooldown), text_color=color.white, bgcolor=color.new(color.gray,60), text_size=size.tiny)
    table.cell(dash, 0, 17, "INSTR", text_color=color.white, bgcolor=color.new(#1A237E,20), text_size=size.tiny)
    table.cell(dash, 1, 17, rProfName, text_color=color.white, bgcolor=color.new(#1A237E,20), text_size=size.tiny)
    table.cell(dash, 2, 17, "ADR:"+str.tostring(math.round(adrPct))+"%", text_color=color.white, bgcolor=color.new(#1A237E,20), text_size=size.tiny)
    table.cell(dash, 3, 17, adrTxt, text_color=color.white, bgcolor=color.new(#1A237E,20), text_size=size.tiny)
if i_showDash and barstate.islast
    drawDashTop()
    drawDashMid()
    drawDashState()
    drawDashFoot()

// MARKET INTEL (small bottom-left)
var table mi = table.new(position.bottom_left, 3, 7, frame_color=color.gray, frame_width=1)
if i_showMI and barstate.islast
    table.cell(mi, 0, 0, "MARKET INTEL", text_color=color.white, bgcolor=color.new(#1A237E,0), text_size=size.tiny, text_halign=text.align_center)
    table.merge_cells(mi, 0, 0, 2, 0)
    table.cell(mi, 0, 1, "P/D", text_color=color.white, bgcolor=color.new(color.gray,60), text_size=size.tiny)
    table.cell(mi, 1, 1, str.tostring(math.round(pdPctClamped))+"%", text_color=color.white, bgcolor=color.new(color.gray,60), text_size=size.tiny)
    pdLabel = hyperPrem_v17?"HYPER↑":extPrem?"EXT↑":hyperDisc_v17?"HYPER↓":extDisc?"EXT↓":inPrem?"PREM":inDisc?"DISC":"EQ"
    table.cell(mi, 2, 1, pdLabel, text_color=color.white, bgcolor=color.new(color.gray,60), text_size=size.tiny)
    table.cell(mi, 0, 2, "RSI", text_color=color.white, bgcolor=color.new(color.gray,60), text_size=size.tiny)
    table.cell(mi, 1, 2, str.tostring(arsi,"#.#"), text_color=color.white, bgcolor=color.new(color.gray,60), text_size=size.tiny)
    table.cell(mi, 2, 2, arsiRegime, text_color=color.white, bgcolor=color.new(color.gray,60), text_size=size.tiny)
    table.cell(mi, 0, 3, "DIV", text_color=color.white, bgcolor=color.new(color.gray,60), text_size=size.tiny)
    divTxt = anyDivBull?"BULL":anyDivBear?"BEAR":"—"
    table.cell(mi, 1, 3, divTxt, text_color=color.white, bgcolor=color.new(color.gray,60), text_size=size.tiny)
    table.cell(mi, 2, 3, divRegBull?"REG":divHidBull?"HID":divRegBear?"REG":divHidBear?"HID":"—", text_color=color.white, bgcolor=color.new(color.gray,60), text_size=size.tiny)
    table.cell(mi, 0, 4, "ATR", text_color=color.white, bgcolor=color.new(color.gray,60), text_size=size.tiny)
    table.cell(mi, 1, 4, str.tostring(atr14,"#.#"), text_color=color.white, bgcolor=color.new(color.gray,60), text_size=size.tiny)
    table.cell(mi, 2, 4, atr14>atr200?"HIGH":"NORM", text_color=color.white, bgcolor=color.new(color.gray,60), text_size=size.tiny)
    table.cell(mi, 0, 5, "DELTA", text_color=color.white, bgcolor=color.new(color.gray,60), text_size=size.tiny)
    table.cell(mi, 1, 5, str.tostring(math.round(pressR))+"%", text_color=color.white, bgcolor=color.new(color.gray,60), text_size=size.tiny)
    table.cell(mi, 2, 5, cumDeltaDivBull?"BULL DIV":cumDeltaDivBear?"BEAR DIV":"—", text_color=color.white, bgcolor=color.new(color.gray,60), text_size=size.tiny)
    table.cell(mi, 0, 6, "BIAS PROB", text_color=color.white, bgcolor=color.new(color.gray,60), text_size=size.tiny)
    table.cell(mi, 1, 6, "B:"+str.tostring(math.round(biasProbBuy_v17*100))+"%", text_color=color.white, bgcolor=color.new(color.gray,60), text_size=size.tiny)
    table.cell(mi, 2, 6, "S:"+str.tostring(math.round(biasProbSell_v17*100))+"%", text_color=color.white, bgcolor=color.new(color.gray,60), text_size=size.tiny)

// ═══════════════════════════════════════════════════════════════════════════
// CANDLE VOLUME LABELS — one per bar, rolling window
// ═══════════════════════════════════════════════════════════════════════════
fmtVolNum(float v) =>
    av = math.abs(v)
    av >= 1e9 ? str.tostring(v/1e9, "#.##")+"B"
     : av >= 1e6 ? str.tostring(v/1e6, "#.##")+"M"
     : av >= 1e3 ? str.tostring(v/1e3, "#.#")+"K"
     : str.tostring(math.round(v))

var array<label> cvLbls = array.new<label>()
addCandleVolLabel() =>
    string cvTxt = i_cv_format == "Raw"        ? str.tostring(math.round(volume))
                 : i_cv_format == "Ratio ×"     ? str.tostring(volR, "#.#")+"×"
                 : i_cv_format == "Volume + Ratio" ? fmtVolNum(volume)+" ("+str.tostring(volR,"#.#")+"×)"
                 : fmtVolNum(volume)
    color cvBg = not i_cv_colorByR ? i_cv_normalCol
               : volR >= i_vol_climax ? i_cv_climaxCol
               : volR >= i_vol_vhigh  ? i_cv_vhighCol
               : volR >= i_vol_high   ? i_cv_highCol
               : i_cv_normalCol
    cvSize = i_cv_size == "tiny" ? size.tiny : i_cv_size == "small" ? size.small : size.normal
    bool placeAbove = i_cv_position == "Above" or (i_cv_position == "Auto" and close < open)
    label newLbl = placeAbove
       ? label.new(bar_index, high, cvTxt, style=label.style_label_down, color=cvBg, textcolor=i_cv_textCol, size=cvSize, yloc=yloc.abovebar)
       : label.new(bar_index, low,  cvTxt, style=label.style_label_up,   color=cvBg, textcolor=i_cv_textCol, size=cvSize, yloc=yloc.belowbar)
    cvLbls.push(newLbl)
    if cvLbls.size() > i_cv_lastBars
        label.delete(cvLbls.shift())
    0
clearCandleVolLabels() =>
    while cvLbls.size() > 0
        label.delete(cvLbls.shift())
    0
if i_cv_show and barstate.isconfirmed and volR >= i_cv_minVolR and not na(volume) and volume > 0
    addCandleVolLabel()
if not i_cv_show and cvLbls.size() > 0
    clearCandleVolLabels()

// ═══ ALERTS ═══
alertcondition(BUY, "QF v21 BUY", "QF v21 BUY {{ticker}} @ {{close}}")
alertcondition(SELL, "QF v21 SELL", "QF v21 SELL {{ticker}} @ {{close}}")
alertcondition(HP_BUY, "QF v21 HP BUY", "QF v21 HP★ BUY {{ticker}} @ {{close}}")
alertcondition(HP_SELL, "QF v21 HP SELL", "QF v21 HP★ SELL {{ticker}} @ {{close}}")
alertcondition(magnetBullR, "QF v21 MAGNET BUY", "QF v21 MAGNET HIT BUY {{ticker}}")
alertcondition(magnetBearR, "QF v21 MAGNET SELL", "QF v21 MAGNET HIT SELL {{ticker}}")
alertcondition(zoneEntryBuy, "QF v21 PENDING BUY", "QF v21 PENDING BUY {{ticker}}")
alertcondition(zoneEntrySell, "QF v21 PENDING SELL", "QF v21 PENDING SELL {{ticker}}")
alertcondition(aiApprovedBuy, "QF v21 AI APPROVED BUY", "QF v21 ✓ AI APPROVED BUY {{ticker}} @ {{close}}")
alertcondition(aiApprovedSell, "QF v21 AI APPROVED SELL", "QF v21 ✓ AI APPROVED SELL {{ticker}} @ {{close}}")
alertcondition(possNewB, "QF v21 SHIFT BUY", "QF v21 BUY SHIFT POSSIBLE {{ticker}}")
alertcondition(possNewS, "QF v21 SHIFT SELL", "QF v21 SELL SHIFT POSSIBLE {{ticker}}")
alertcondition(preSignalBuy, "QF v21 PRE BUY", "QF v21 PRE-SIGNAL BUY {{ticker}}")
alertcondition(preSignalSell, "QF v21 PRE SELL", "QF v21 PRE-SIGNAL SELL {{ticker}}")
alertcondition(tradeWarnExitBuy or tradeWarnExitSell, "QF v21 TRADE WARN", "QF v21 TRADE QUALITY WARN {{ticker}}")
if BUY and barstate.isconfirmed
    alert("QF v21 "+grade+" BUY "+syminfo.ticker+" @ "+str.tostring(close,"#.#")+" | "+setupName+" | "+usedZoneName+" HP:"+str.tostring(finalHPBull), alert.freq_once_per_bar_close)
if SELL and barstate.isconfirmed
    alert("QF v21 "+grade+" SELL "+syminfo.ticker+" @ "+str.tostring(close,"#.#")+" | "+setupName+" | "+usedZoneName+" HP:"+str.tostring(finalHPBear), alert.freq_once_per_bar_close)
if i_ai_alertOn and aiApprovedBuy and barstate.isconfirmed
    alert("QF v21 ✓ AI APPROVED BUY "+syminfo.ticker+" @ "+str.tostring(close,"#.#")+" | Score:"+str.tostring(aiBuyScore)+"/"+str.tostring(i_ai_min), alert.freq_once_per_bar_close)
if i_ai_alertOn and aiApprovedSell and barstate.isconfirmed
    alert("QF v21 ✓ AI APPROVED SELL "+syminfo.ticker+" @ "+str.tostring(close,"#.#")+" | Score:"+str.tostring(aiSellScore)+"/"+str.tostring(i_ai_min), alert.freq_once_per_bar_close)
