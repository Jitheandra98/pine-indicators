if i_useHRS
    if intOBBullR or swgOBBullR or h1BR or zBullFVM or breakerBullR or htfZoneBullR
        addOrUpdateHRSLevel(low, 1)
    if intOBBearR or swgOBBearR or h1SR or zBearFVM or breakerBearR or htfZoneBearR
        addOrUpdateHRSLevel(high, -1)
if i_useHRS and hrsStore.size() > 0
    for [idx, rl] in hrsStore
        barsAgo = bar_index - rl.lastTouchBar
        if barsAgo == i_mag_reactBar and rl.lastTouchBar > 0
            reactionDist = i_hrsReactionATR * atr14
            if rl.lastDirection == 1
                moved = high - rl.price
                if moved >= reactionDist
                    rl.reactionWins += 1
                    rl.avgReactionPips := (rl.avgReactionPips * (rl.reactionWins - 1) + moved) / rl.reactionWins
                else
                    rl.reactionLosses += 1
            else if rl.lastDirection == -1
                moved = rl.price - low
                if moved >= reactionDist
                    rl.reactionWins += 1
                    rl.avgReactionPips := (rl.avgReactionPips * (rl.reactionWins - 1) + moved) / rl.reactionWins
                else
                    rl.reactionLosses += 1
if i_useMagnet and i_useHRS and hrsStore.size() > 0
    for [idx, rl] in hrsStore
        rl.htfAgreement := 1
        agreementCount = 1
        if intOBs.size() > 0
            for [idx3, ob] in intOBs
                obMid = (ob.bHigh + ob.bLow) / 2
                if math.abs(obMid - rl.price) < atr14 * i_hrsTolATR
                    agreementCount += 1
                    break
        if swgOBs.size() > 0
            for [idx4, ob] in swgOBs
                obMid = (ob.bHigh + ob.bLow) / 2
                if math.abs(obMid - rl.price) < atr14 * i_hrsTolATR
                    agreementCount += 1
                    break
        rl.htfAgreement := agreementCount
        rl.isMagnet := agreementCount >= i_mag_agreeMin
var bool magnetBullR = false, var bool magnetBearR = false
var float magnetLevelHit = na
var int magnetTouchCount = 0
var int magnetWins = 0
var int magnetLosses = 0
magnetBullR := false, magnetBearR := false, magnetLevelHit := na
magnetTouchCount := 0, magnetWins := 0, magnetLosses := 0
if i_useMagnet and hrsStore.size() > 0
    for [idx, rl] in hrsStore
        if rl.isMagnet
            tol = atr14 * i_hrsTolATR
            if low <= rl.price + tol and low >= rl.price - tol and close > rl.price
                magnetBullR := true
                magnetLevelHit := rl.price
                magnetTouchCount := rl.touchCount
                magnetWins := rl.reactionWins
                magnetLosses := rl.reactionLosses
                break
            else if high >= rl.price - tol and high <= rl.price + tol and close < rl.price
                magnetBearR := true
                magnetLevelHit := rl.price
                magnetTouchCount := rl.touchCount
                magnetWins := rl.reactionWins
                magnetLosses := rl.reactionLosses
                break
var array<line> magnetLines = array.new<line>()
var array<label> magnetLabels = array.new<label>()
if i_useMagnet and barstate.islast
    for ln in magnetLines
        line.delete(ln)
    magnetLines.clear()
    for lb in magnetLabels
        label.delete(lb)
    magnetLabels.clear()
    if hrsStore.size() > 0
        magnetCount = 0
        for [idx, rl] in hrsStore
            if rl.isMagnet and magnetCount < i_mag_displayCap
                magnetX1 = math.max(rl.firstTouchBar, bar_index - i_lookbk_max)
                magnetLines.push(line.new(magnetX1, rl.price, bar_index + 50, rl.price, color=color.new(#FFD700, 10), style=line.style_solid, width=3))
                wrTxt = (rl.reactionWins + rl.reactionLosses) > 0 ? str.tostring(math.round(rl.reactionWins * 100.0 / (rl.reactionWins + rl.reactionLosses))) + "%" : "—"
                magnetLabels.push(label.new(bar_index + 51, rl.price, "★ MAGNET ×" + str.tostring(rl.touchCount) + " (" + str.tostring(rl.htfAgreement) + "TF) WR:" + wrTxt, color=color(na), textcolor=#FFD700, style=label.style_label_left, size=size.small))
                magnetCount += 1
magnetBayesWR = (magnetWins + magnetLosses) > 0 ? magnetWins * 1.0 / (magnetWins + magnetLosses) : 0.65

anyBullZone = h1BR or zBullFVM or ifvBullR or breakerBullR or oteReaction or intOBBullR or swgOBBullR or retestBullR or htfZoneBullR or magnetBullR
anyBearZone = h1SR or zBearFVM or ifvBearR or breakerBearR or oteReaction or intOBBearR or swgOBBearR or retestBearR or htfZoneBearR or magnetBearR
zoneStackBull = (h1BR?1:0)+(zBullFVM?1:0)+(ifvBullR?1:0)+(breakerBullR?1:0)+((oteReaction and oteBias==1)?1:0)+(intOBBullR?1:0)+(swgOBBullR?1:0)+(retestBullR?1:0)+(htfZoneBullR?1:0)+(magnetBullR?i_stack_magnetW:0)
zoneStackBear = (h1SR?1:0)+(zBearFVM?1:0)+(ifvBearR?1:0)+(breakerBearR?1:0)+((oteReaction and oteBias==-1)?1:0)+(intOBBearR?1:0)+(swgOBBearR?1:0)+(retestBearR?1:0)+(htfZoneBearR?1:0)+(magnetBearR?i_stack_magnetW:0)
stackModBull = zoneStackBull>=4 ? i_stack_t4plus : zoneStackBull>=3 ? i_stack_t3 : zoneStackBull>=2 ? i_stack_t2 : 0
stackModBear = zoneStackBear>=4 ? i_stack_t4plus : zoneStackBear>=3 ? i_stack_t3 : zoneStackBear>=2 ? i_stack_t2 : 0
freshBull = (intOBBullR or swgOBBullR) ? (obTouchCountBull <= 1 ? i_fresh_ob_t1 : obTouchCountBull == 2 ? i_fresh_ob_t2 : obTouchCountBull == 3 ? i_fresh_ob_t3 : i_fresh_ob_t4) : zBullFVM ? (fvgTouchBull <= 1 ? i_fresh_fvg_t1 : fvgTouchBull == 2 ? i_fresh_fvg_t2 : i_fresh_fvg_t3) : 0
freshBear = (intOBBearR or swgOBBearR) ? (obTouchCountBear <= 1 ? i_fresh_ob_t1 : obTouchCountBear == 2 ? i_fresh_ob_t2 : obTouchCountBear == 3 ? i_fresh_ob_t3 : i_fresh_ob_t4) : zBearFVM ? (fvgTouchBear <= 1 ? i_fresh_fvg_t1 : fvgTouchBear == 2 ? i_fresh_fvg_t2 : i_fresh_fvg_t3) : 0
partialPenBull = obPartialBull ? i_fresh_partialPen : 0
partialPenBear = obPartialBear ? i_fresh_partialPen : 0
shiftBull = close>open and body>avgBodyRef*rDisplMult and cloc>60
shiftBear = close<open and body>avgBodyRef*rDisplMult and cloc<40
dqBull = (shiftBull?i_dq_shift:0)+((fBG>0 and fBG>=fvMin)?i_dq_fvg:0)+(volR>=i_dq_volT?i_dq_vol:0)+(inActive?i_dq_sess:0)+(anyBosB?i_dq_bos:0)+(swpBullValid?i_dq_swp:0)+(cloc>i_dq_clocBull?i_dq_cloc:0)
dqBull := math.min(dqBull, i_dq_max)
dqBear = (shiftBear?i_dq_shift:0)+((fSG>0 and fSG>=fvMin)?i_dq_fvg:0)+(volR>=i_dq_volT?i_dq_vol:0)+(inActive?i_dq_sess:0)+(anyBosS?i_dq_bos:0)+(swpBearValid?i_dq_swp:0)+(cloc<i_dq_clocBear?i_dq_cloc:0)
dqBear := math.min(dqBear, i_dq_max)
zName = magnetBullR or magnetBearR ? "★ MAGNET" : htfZoneBullR or htfZoneBearR ? htfZoneSource : retestBullR or retestBearR ? "BOS RETEST" : h1BR or h1SR ? "1H OB" : intOBBullR or intOBBearR ? "INT OB" : swgOBBullR or swgOBBearR ? "SWG OB" : zBullFVM or zBearFVM ? "FVG" : ifvBullR or ifvBearR ? "IFVG" : breakerBullR or breakerBearR ? "BREAKER" : oteReaction ? "OTE" : swpBullValid or swpBearValid ? swpSource : "Zone"
calcBullConf(bool hSwp, bool hZ, bool hDiv, bool hSMT) =>
    int hp = 0
    string tag = ""
    if magnetBullR
        hp := i_hp_magnet, tag := "MAGNET"
    else if hSwp and hZ and hDiv
        hp := i_hp_swpZdiv, tag := "SWP+Z+DIV"
    else if hSwp and hZ and hSMT
        hp := i_hp_swpZsmt, tag := "SWP+Z+SMT"
    else if hZ and hDiv
        hp := i_hp_zdiv, tag := "Z+DIV"
    else if hZ and hSMT
        hp := i_hp_zsmt, tag := "Z+SMT"
    else if hSwp and hZ
        hp := i_hp_swpZ, tag := "SWP+ZONE"
    else if zoneStackBull >= i_hp_stack_min
        hp := i_hp_stack, tag := "STK×" + str.tostring(zoneStackBull)
    else if hZ and flowBull
        hp := i_hp_zflow, tag := "Z+FLOW"
    [hp, tag]
calcBearConf(bool hSwp, bool hZ, bool hDiv, bool hSMT) =>
    int hp = 0
    string tag = ""
    if magnetBearR
        hp := i_hp_magnet, tag := "MAGNET"
    else if hSwp and hZ and hDiv
        hp := i_hp_swpZdiv, tag := "SWP+Z+DIV"
    else if hSwp and hZ and hSMT
        hp := i_hp_swpZsmt, tag := "SWP+Z+SMT"
    else if hZ and hDiv
        hp := i_hp_zdiv, tag := "Z+DIV"
    else if hZ and hSMT
        hp := i_hp_zsmt, tag := "Z+SMT"
    else if hSwp and hZ
        hp := i_hp_swpZ, tag := "SWP+ZONE"
    else if zoneStackBear >= i_hp_stack_min
        hp := i_hp_stack, tag := "STK×" + str.tostring(zoneStackBear)
    else if hZ and flowBear
        hp := i_hp_zflow, tag := "Z+FLOW"
    [hp, tag]
var int confBullHP = 0, var int confBearHP = 0
var string confBullTag = "", var string confBearTag = ""
confBullHP := 0, confBearHP := 0, confBullTag := "", confBearTag := ""
if i_confluenceV2
    hasSweepBull = swpBullValid
    hasZoneBull = anyBullZone
    hasDivBull = anyDivBull or (divRegBull[1] or divHidBull[1] or divRegBull[2] or divHidBull[2])
    hasSMTBull = smtB or smtB[1] or smtB[2] or smtB[3]
    [cbH, cbT] = calcBullConf(hasSweepBull, hasZoneBull, hasDivBull, hasSMTBull)
