//@version=6
indicator("QUANTUM FLOW v21.0 — AI APPROVAL ENGINE", overlay=true,
         max_labels_count=500, max_lines_count=500, max_boxes_count=500, max_bars_back=5000)

// ═══════════════════════════════════════════════════════
// v21.0 — Adds AI APPROVAL layer between PENDING and VALIDATED.
// When a PENDING is active, the engine watches for confirmation events
// (volume spike, delta flip, wick rejection, micro-BOS, candle pattern,
// sweep alignment, HTF agreement). When the AI Approval Score (AAS)
// crosses threshold → prints "✓ AI APPROVED BUY/SELL" marker. This is
// the recommended trade trigger — fires earlier than full displacement
// VALIDATION while requiring multiple agreement signals.
// ═══════════════════════════════════════════════════════

type pivotPoint
    float currentLevel
    float lastLevel
    bool crossed
    int barTime = na
    int barIdx = na
type trendBias
    int bias = 0
type trailExt
    float top = na
    float bottom = na
    int topTime = na
    int topIdx = na
    int bottomTime = na
    int bottomIdx = na
type liqPool
    float level
    int touches
    int firstBar
    int lastBar
    int firstTime
    bool isHigh
    bool swept
type breakerBlock
    float bHigh
    float bLow
    int bTime
    int bias
    int birthBar
type obData
    float bHigh
    float bLow
    int bTime
    int bias
    bool isBearishCandle
    int touchCount = 0
    bool partialMitig = false
type retestZone
    float level
    int bias
    int birthBar
    bool tested
type reactiveLevel
    float price
    int firstTouchBar
    int touchCount
    int reactionWins
    int reactionLosses
    float avgReactionPips
    int htfAgreement
    bool isMagnet
    int lastTouchBar
    int direction
    int lastDirection
    bool isActive
type htfZone
    float zHigh
    float zLow
    int bias
    string source
    int birthBar
    bool active
type tradeStats
    int   totalBuy = 0
    int   winBuy = 0
    int   totalSell = 0
    int   winSell = 0
    float rSumWin = 0.0
    float rSumLoss = 0.0
    int   rWinCount = 0
    int   rLossCount = 0
    float totalPnL = 0.0
    float winSumDollars = 0.0
    float lossSumDollars = 0.0
    float largestWin = 0.0
    float largestLoss = 0.0
    int   consecLosses = 0
    int   magnetW = 0
    int   magnetT = 0
    int   bosRetestW = 0
    int   bosRetestT = 0
    int   sweepZoneW = 0
    int   sweepZoneT = 0
    int   zoneEntryW = 0
    int   zoneEntryT = 0
    int   zoneTapW = 0
    int   zoneTapT = 0
type activeTrade
    float entry = na
    float sl    = na
    float tp    = na
    int   bar   = 0
    string setup = ""

BULLISH_C = 1
BEARISH_C = -1
GREEN_C   = #089981
RED_C     = #F23645

isGold = str.contains(str.upper(syminfo.ticker), "XAU") or str.contains(str.upper(syminfo.ticker), "GOLD") or str.contains(str.upper(syminfo.ticker), "GC")
isNQ   = str.contains(str.upper(syminfo.ticker), "NQ") or str.contains(str.upper(syminfo.ticker), "MNQ")
isES   = str.contains(str.upper(syminfo.ticker), "ES") or str.contains(str.upper(syminfo.ticker), "MES") or str.contains(str.upper(syminfo.ticker), "SPX")
isEU   = str.contains(str.upper(syminfo.ticker), "EUR") and str.contains(str.upper(syminfo.ticker), "USD")
isGU   = str.contains(str.upper(syminfo.ticker), "GBP") and str.contains(str.upper(syminfo.ticker), "USD")
isUJ   = str.contains(str.upper(syminfo.ticker), "USD") and str.contains(str.upper(syminfo.ticker), "JPY")
isBTC  = str.contains(str.upper(syminfo.ticker), "BTC") or str.contains(str.upper(syminfo.ticker), "MBT")
isFX   = isEU or isGU or isUJ
float profDisplMult = isGold?1.3:isNQ?1.5:isES?1.2:isFX?1.4:isBTC?1.3:1.3
float profSweepTol  = isGold?0.10:isNQ?0.08:isES?0.06:isFX?0.12:isBTC?0.10:0.10
int   profHPThresh  = isGold?4:isNQ?5:isES?4:isFX?4:isBTC?4:4
string profCorr1    = isGold?"TVC:DXY":isNQ?"CME_MINI:ES1!":isES?"CME_MINI:NQ1!":isEU?"TVC:DXY":isGU?"TVC:DXY":isUJ?"FX:EURUSD":isBTC?"BINANCE:ETHUSD":"TVC:DXY"
string profName     = isGold?"GOLD":isNQ?"NQ":isES?"ES":isEU?"EUR/USD":isGU?"GBP/USD":isUJ?"USD/JPY":isBTC?"BTC":"GENERAL"

// INPUTS
GRP_PROF = "═══ INSTRUMENT ═══"
i_profOverride = input.string("Auto","Profile",group=GRP_PROF,options=["Auto","Gold","NQ","ES","EUR/USD","GBP/USD","USD/JPY","BTC"])

GRP_V17 = "═══ MEMORY & SIGNALING ═══"
