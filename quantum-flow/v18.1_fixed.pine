var array<htfZone> htfZones = array.new<htfZone>()
htfDH = request.security(syminfo.tickerid,"D",ta.pivothigh(high,3,3),lookahead=barmerge.lookahead_off)
htfDL = request.security(syminfo.tickerid,"D",ta.pivotlow(low,3,3),lookahead=barmerge.lookahead_off)
htf4H = request.security(syminfo.tickerid,"240",ta.pivothigh(high,3,3),lookahead=barmerge.lookahead_off)
htf4L = request.security(syminfo.tickerid,"240",ta.pivotlow(low,3,3),lookahead=barmerge.lookahead_off)
if i_useHTFImport
    if not na(htfDH) and htfDH > 0
        already_dh = false
        if htfZones.size() > 0
            for [idx, hz] in htfZones
                if hz.source == "D-High" and math.abs(hz.zHigh - htfDH) < atr14 * i_hrsTolATR
                    already_dh := true
                    break
        if not already_dh
            htfZones.unshift(htfZone.new(htfDH, htfDH - atr14*0.15, BEARISH_C, "D-High", bar_index, true))
            if htfZones.size() > 30
                htfZones.pop()
    if not na(htfDL) and htfDL > 0
        already_dl = false
        if htfZones.size() > 0
            for [idx, hz] in htfZones
                if hz.source == "D-Low" and math.abs(hz.zLow - htfDL) < atr14 * i_hrsTolATR
                    already_dl := true
                    break
        if not already_dl
            htfZones.unshift(htfZone.new(htfDL + atr14*0.15, htfDL, BULLISH_C, "D-Low", bar_index, true))
            if htfZones.size() > 30
                htfZones.pop()
    if not na(htf4H) and htf4H > 0
        already_4h = false
        if htfZones.size() > 0
            for [idx, hz] in htfZones
                if hz.source == "4H-High" and math.abs(hz.zHigh - htf4H) < atr14 * i_hrsTolATR
                    already_4h := true
                    break
        if not already_4h
            htfZones.unshift(htfZone.new(htf4H, htf4H - atr14*0.10, BEARISH_C, "4H-High", bar_index, true))
            if htfZones.size() > 30
                htfZones.pop()
    if not na(htf4L) and htf4L > 0
        already_4l = false
        if htfZones.size() > 0
            for [idx, hz] in htfZones
                if hz.source == "4H-Low" and math.abs(hz.zLow - htf4L) < atr14 * i_hrsTolATR
                    already_4l := true
                    break
        if not already_4l
            htfZones.unshift(htfZone.new(htf4L + atr14*0.10, htf4L, BULLISH_C, "4H-Low", bar_index, true))
            if htfZones.size() > 30
                htfZones.pop()
var bool htfZoneBullR = false, var bool htfZoneBearR = false
var string htfZoneSource = ""
htfZoneBullR := false, htfZoneBearR := false, htfZoneSource := ""
if i_useHTFImport and htfZones.size() > 0
    for [idx, hz] in htfZones
        if hz.active
            if hz.bias == BULLISH_C and low <= hz.zHigh and low >= hz.zLow
                htfZoneBullR := true
                htfZoneSource := hz.source
                break
            else if hz.bias == BEARISH_C and high >= hz.zLow and high <= hz.zHigh
                htfZoneBearR := true
                htfZoneSource := hz.source
                break
var array<line> htfLines = array.new<line>()
var array<label> htfLabels = array.new<label>()
if i_useHTFImport and barstate.islast
    for ln in htfLines
        line.delete(ln)
    htfLines.clear()
    for lb in htfLabels
        label.delete(lb)
    htfLabels.clear()
    drawnH = 0
    for [idx, hz] in htfZones
        if hz.active and drawnH < 8
            mid = (hz.zHigh + hz.zLow) / 2
            cH = hz.bias == BULLISH_C ? color.new(#4CAF50, 50) : color.new(#F44336, 50)
            htfX1 = math.max(hz.birthBar, bar_index - 4500)
            htfLines.push(line.new(htfX1, mid, bar_index + 30, mid, color=cH, style=line.style_dashed, width=1))
            htfLabels.push(label.new(bar_index + 31, mid, hz.source, color=color(na), textcolor=cH, style=label.style_label_left, size=size.tiny))
            drawnH += 1

liqPH = ta.pivothigh(high,i_liqPvtLen,i_liqPvtLen), liqPL = ta.pivotlow(low,i_liqPvtLen,i_liqPvtLen)
var array<liqPool> liqPools = array.new<liqPool>()
var array<line> liqLines=array.new<line>(), var array<label> liqLabels=array.new<label>()
if not na(liqPH) and i_showLiqMap
    exists=false
    for [idx,pool] in liqPools
        if pool.isHigh and math.abs(pool.level-high[i_liqPvtLen])<atr14*0.2
            pool.touches+=1, pool.lastBar:=bar_index-i_liqPvtLen, exists:=true
            break
    if not exists
        liqPools.unshift(liqPool.new(high[i_liqPvtLen],1,bar_index-i_liqPvtLen,bar_index-i_liqPvtLen,time[i_liqPvtLen],true,false))
if not na(liqPL) and i_showLiqMap
    exists2=false
    for [idx,pool] in liqPools
        if not pool.isHigh and math.abs(pool.level-low[i_liqPvtLen])<atr14*0.2
            pool.touches+=1, pool.lastBar:=bar_index-i_liqPvtLen, exists2:=true
            break
    if not exists2
        liqPools.unshift(liqPool.new(low[i_liqPvtLen],1,bar_index-i_liqPvtLen,bar_index-i_liqPvtLen,time[i_liqPvtLen],false,false))
if i_showLiqMap
    for [idx,pool] in liqPools
        if not pool.swept
            if pool.isHigh and high>pool.level+sTol
                pool.swept:=true
            else if not pool.isHigh and low<pool.level-sTol
                pool.swept:=true
if i_showLiqMap and liqPools.size()>i_liqMaxPools*3
    while liqPools.size()>i_liqMaxPools*2
        liqPools.pop()
var float bsl1=na, var float bsl2=na, var float bsl3=na
var float ssl1=na, var float ssl2=na, var float ssl3=na
bsl1:=na, bsl2:=na, bsl3:=na, ssl1:=na, ssl2:=na, ssl3:=na
if i_showLiqMap and liqPools.size() > 0
    var array<float> bslList = array.new<float>()
    var array<float> sslList = array.new<float>()
    bslList.clear()
    sslList.clear()
    for [idx, pool] in liqPools
        if not pool.swept
            if pool.isHigh and pool.level > close
                bslList.push(pool.level)
            else if not pool.isHigh and pool.level < close
                sslList.push(pool.level)
    if bslList.size() > 0
        bslList.sort()
        bsl1 := bslList.get(0)
        if bslList.size() > 1
            bsl2 := bslList.get(1)
        if bslList.size() > 2
            bsl3 := bslList.get(2)
    if sslList.size() > 0
        sslList.sort(order.descending)
        ssl1 := sslList.get(0)
        if sslList.size() > 1
            ssl2 := sslList.get(1)
        if sslList.size() > 2
            ssl3 := sslList.get(2)
nearestBSL = bsl1
nearestSSL = ssl1
if i_showLiqMap and barstate.islast
    for ln in liqLines
        line.delete(ln)
    liqLines.clear()
    for lb in liqLabels
        label.delete(lb)
    liqLabels.clear()
    drawn=0
    for [idx,pool] in liqPools
        if not pool.swept and drawn<i_liqMaxPools
            c=pool.isHigh?i_liqBullCol:i_liqBearCol, w=math.min(pool.touches,4)
            liqX1 = math.max(pool.firstBar, bar_index - 4500)
            liqLines.push(line.new(liqX1,pool.level,bar_index+30,pool.level,color=c,style=line.style_dotted,width=w))
            liqLabels.push(label.new(bar_index+31,pool.level,(pool.isHigh?"BSL":"SSL")+" ×"+str.tostring(pool.touches),color=color(na),textcolor=c,style=label.style_label_left,size=size.tiny))
            drawn+=1

smH = request.security(smtSym,timeframe.period,high,lookahead=barmerge.lookahead_off)
smL = request.security(smtSym,timeframe.period,low,lookahead=barmerge.lookahead_off)
goldRet = close!=0 and close[1]!=0?math.log(close/close[1]):0
smtRet = smH!=0 and smH[1]!=0?math.log(((smH+smL)/2)/((smH[1]+smL[1])/2)):0
smtCorr = ta.correlation(goldRet, smtRet, 20)
smtCorrValid = smtCorr < -0.2
gPH=ta.pivothigh(high,i_smtLen,i_smtLen), gPL=ta.pivotlow(low,i_smtLen,i_smtLen)
currGoldPH=ta.valuewhen(not na(gPH),high[i_smtLen],0), prevGoldPH=ta.valuewhen(not na(gPH),high[i_smtLen],1)
currDxyAtGPH=ta.valuewhen(not na(gPH),smL[i_smtLen],0), prevDxyAtGPH=ta.valuewhen(not na(gPH),smL[i_smtLen],1)
currGoldPL=ta.valuewhen(not na(gPL),low[i_smtLen],0), prevGoldPL=ta.valuewhen(not na(gPL),low[i_smtLen],1)
currDxyAtGPL=ta.valuewhen(not na(gPL),smH[i_smtLen],0), prevDxyAtGPL=ta.valuewhen(not na(gPL),smH[i_smtLen],1)
var bool smtB=false, var bool smtS=false
smtB:=false, smtS:=false
if not na(gPH) and not na(prevGoldPH) and not na(prevDxyAtGPH) and smtCorrValid
    if currGoldPH>prevGoldPH and currDxyAtGPH>=prevDxyAtGPH
        smtS:=true
if not na(gPL) and not na(prevGoldPL) and not na(prevDxyAtGPL) and smtCorrValid
    if currGoldPL<prevGoldPL and currDxyAtGPL<=prevDxyAtGPL
        smtB:=true
if i_showSMT and smtB and drawOK
    label.new(bar_index-i_smtLen,low[i_smtLen],"SMT▲",color=color.new(#00BCD4,15),textcolor=color.white,style=label.style_label_up,size=size.small)
if i_showSMT and smtS and drawOK
    label.new(bar_index-i_smtLen,high[i_smtLen],"SMT▼",color=color.new(#E040FB,15),textcolor=color.white,style=label.style_label_down,size=size.small)

var float oteBullHi=na,var float oteBullLo=na,var float oteBearHi=na,var float oteBearLo=na
var int oteBar=na, var int oteBias=0
if isDispBull and anyBosB
    dispLo=low[1]<low?low[1]:math.min(low,nz(low[2],low))
    oteBullHi:=high-(high-dispLo)*0.62, oteBullLo:=high-(high-dispLo)*0.79
    oteBar:=bar_index, oteBias:=1
if isDispBear and anyBosS
    dispHi=high[1]>high?high[1]:math.max(high,nz(high[2],high))
    oteBearLo:=low+(dispHi-low)*0.62, oteBearHi:=low+(dispHi-low)*0.79
    oteBar:=bar_index, oteBias:=-1
oteActive = not na(oteBar) and (bar_index-oteBar)<30
oteReaction = (oteActive and oteBias==1 and not na(oteBullHi) and low<=oteBullHi and low>=oteBullLo) or (oteActive and oteBias==-1 and not na(oteBearHi) and high>=oteBearLo and high<=oteBearHi)
var box oteBox=na
if i_showOTE and barstate.islast and oteActive
    box.delete(oteBox)
    if oteBias==1 and not na(oteBullHi)
        oteBox:=box.new(nz(oteBar,bar_index),oteBullHi,bar_index+10,oteBullLo,bgcolor=color.new(#00E5FF,88),border_color=color.new(#00E5FF,40),border_width=2,text="OTE",text_color=color.new(#00E5FF,20),text_size=size.tiny)
    else if oteBias==-1 and not na(oteBearHi)
        oteBox:=box.new(nz(oteBar,bar_index),oteBearHi,bar_index+10,oteBearLo,bgcolor=color.new(#FF5722,88),border_color=color.new(#FF5722,40),border_width=2,text="OTE",text_color=color.new(#FF5722,20),text_size=size.tiny)

var array<reactiveLevel> hrsStore = array.new<reactiveLevel>()
addOrUpdateHRSLevel(float price, int dir) =>
    if i_useHRS and not na(price) and price > 0
        hrsTol = atr14 * i_hrsTolATR
        foundIdx = -1
        if hrsStore.size() > 0
            for i = 0 to hrsStore.size() - 1
                rl = hrsStore.get(i)
                if math.abs(rl.price - price) < hrsTol
                    foundIdx := i
                    break
        if foundIdx >= 0
            rl = hrsStore.get(foundIdx)
            rl.touchCount += 1
            rl.lastTouchBar := bar_index
            rl.lastDirection := dir
            rl.isActive := true
            0
        else
            newLevel = reactiveLevel.new(price, bar_index, 1, 0, 0, 0.0, 1, false, bar_index, dir, dir, true)
            hrsStore.unshift(newLevel)
            if hrsStore.size() > i_hrsMaxLevels
                worstIdx = hrsStore.size() - 1
                worstScore = 9999.0
                for j = 0 to hrsStore.size() - 1
                    rl2 = hrsStore.get(j)
                    age = bar_index - rl2.lastTouchBar
                    score = age * 1.0 / math.max(rl2.touchCount, 1)
                    if score < worstScore and not rl2.isMagnet
                        worstScore := score
                        worstIdx := j
                hrsStore.remove(worstIdx)
            0
if i_useHRS
    if intOBBullR or swgOBBullR or h1BR or zBullFVM or breakerBullR or htfZoneBullR
        addOrUpdateHRSLevel(low, 1)
    if intOBBearR or swgOBBearR or h1SR or zBearFVM or breakerBearR or htfZoneBearR
        addOrUpdateHRSLevel(high, -1)
if i_useHRS and hrsStore.size() > 0
    for [idx, rl] in hrsStore
        barsAgo = bar_index - rl.lastTouchBar
        if barsAgo == 10 and rl.lastTouchBar > 0
            reactionDist = i_hrsReactionATR * atr14
            if rl.lastDirection == 1
                moved = high - rl.price
                if moved >= reactionDist
                    rl.reactionWins += 1
                    rl.avgReactionPips := (rl.avgReactionPips * (rl.reactionWins - 1) + moved) / rl.reactionWins
                else
                    rl.reactionLosses += 1
            else if rl.lastDirection == -1
                moved = rl.price - low
                if moved >= reactionDist
                    rl.reactionWins += 1
                    rl.avgReactionPips := (rl.avgReactionPips * (rl.reactionWins - 1) + moved) / rl.reactionWins
                else
                    rl.reactionLosses += 1
if i_useMagnet and i_useHRS and hrsStore.size() > 0
    for [idx, rl] in hrsStore
        rl.htfAgreement := 1
        agreementCount = 1
        if i_useHTFImport and htfZones.size() > 0
            for [idx2, hz] in htfZones
                hzMid = (hz.zHigh + hz.zLow) / 2
                if math.abs(hzMid - rl.price) < atr14 * i_hrsTolATR
                    agreementCount += 1
        if intOBs.size() > 0
            for [idx3, ob] in intOBs
                obMid = (ob.bHigh + ob.bLow) / 2
                if math.abs(obMid - rl.price) < atr14 * i_hrsTolATR
                    agreementCount += 1
                    break
        if swgOBs.size() > 0
            for [idx4, ob] in swgOBs
                obMid = (ob.bHigh + ob.bLow) / 2
                if math.abs(obMid - rl.price) < atr14 * i_hrsTolATR
                    agreementCount += 1
                    break
        rl.htfAgreement := agreementCount
        rl.isMagnet := agreementCount >= 3
var bool magnetBullR = false, var bool magnetBearR = false
var float magnetLevelHit = na
var int magnetTouchCount = 0
var int magnetWins = 0
var int magnetLosses = 0
magnetBullR := false, magnetBearR := false, magnetLevelHit := na
magnetTouchCount := 0, magnetWins := 0, magnetLosses := 0
if i_useMagnet and hrsStore.size() > 0
    for [idx, rl] in hrsStore
        if rl.isMagnet
            tol = atr14 * i_hrsTolATR
            if low <= rl.price + tol and low >= rl.price - tol and close > rl.price
                magnetBullR := true
                magnetLevelHit := rl.price
                magnetTouchCount := rl.touchCount
                magnetWins := rl.reactionWins
                magnetLosses := rl.reactionLosses
                break
            else if high >= rl.price - tol and high <= rl.price + tol and close < rl.price
                magnetBearR := true
                magnetLevelHit := rl.price
                magnetTouchCount := rl.touchCount
                magnetWins := rl.reactionWins
                magnetLosses := rl.reactionLosses
                break
var array<line> magnetLines = array.new<line>()
var array<label> magnetLabels = array.new<label>()
if i_useMagnet and barstate.islast
    for ln in magnetLines
        line.delete(ln)
    magnetLines.clear()
    for lb in magnetLabels
        label.delete(lb)
    magnetLabels.clear()
    if hrsStore.size() > 0
        magnetCount = 0
        for [idx, rl] in hrsStore
            if rl.isMagnet and magnetCount < 6
                magnetX1 = math.max(rl.firstTouchBar, bar_index - 4500)
                magnetLines.push(line.new(magnetX1, rl.price, bar_index + 50, rl.price, color=color.new(#FFD700, 10), style=line.style_solid, width=3))
                wrTxt = (rl.reactionWins + rl.reactionLosses) > 0 ? str.tostring(math.round(rl.reactionWins * 100.0 / (rl.reactionWins + rl.reactionLosses))) + "%" : "—"
                magnetLabels.push(label.new(bar_index + 51, rl.price, "★ MAGNET ×" + str.tostring(rl.touchCount) + " (" + str.tostring(rl.htfAgreement) + "TF) WR:" + wrTxt, color=color(na), textcolor=#FFD700, style=label.style_label_left, size=size.small))
                magnetCount += 1
bayesianWR(int wins, int losses) =>
    n = wins + losses
    posterior = (n * (n > 0 ? wins * 1.0 / n : i_bayesPrior) + i_bayesShrink * i_bayesPrior) / (n + i_bayesShrink)
    posterior
magnetBayesWR = i_useBayesian ? bayesianWR(magnetWins, magnetLosses) : 0.65

anyBullZone = h1BR or zBullFVM or ifvBullR or breakerBullR or oteReaction or intOBBullR or swgOBBullR or retestBullR or htfZoneBullR or magnetBullR
anyBearZone = h1SR or zBearFVM or ifvBearR or breakerBearR or oteReaction or intOBBearR or swgOBBearR or retestBearR or htfZoneBearR or magnetBearR
zoneStackBull = (h1BR?1:0)+(zBullFVM?1:0)+(ifvBullR?1:0)+(breakerBullR?1:0)+((oteReaction and oteBias==1)?1:0)+(intOBBullR?1:0)+(swgOBBullR?1:0)+(retestBullR?1:0)+(htfZoneBullR?1:0)+(magnetBullR?2:0)
zoneStackBear = (h1SR?1:0)+(zBearFVM?1:0)+(ifvBearR?1:0)+(breakerBearR?1:0)+((oteReaction and oteBias==-1)?1:0)+(intOBBearR?1:0)+(swgOBBearR?1:0)+(retestBearR?1:0)+(htfZoneBearR?1:0)+(magnetBearR?2:0)
stackModBull = zoneStackBull>=4 ? -3 : zoneStackBull>=3 ? -2 : zoneStackBull>=2 ? -1 : 0
stackModBear = zoneStackBear>=4 ? -3 : zoneStackBear>=3 ? -2 : zoneStackBear>=2 ? -1 : 0
freshBull = (intOBBullR or swgOBBullR) ? (obTouchCountBull <= 1 ? 1 : obTouchCountBull == 2 ? 3 : obTouchCountBull == 3 ? 4 : 2) : zBullFVM ? (fvgTouchBull <= 1 ? 1 : fvgTouchBull == 2 ? 2 : 3) : 0
freshBear = (intOBBearR or swgOBBearR) ? (obTouchCountBear <= 1 ? 1 : obTouchCountBear == 2 ? 3 : obTouchCountBear == 3 ? 4 : 2) : zBearFVM ? (fvgTouchBear <= 1 ? 1 : fvgTouchBear == 2 ? 2 : 3) : 0
partialPenBull = obPartialBull ? -1 : 0
partialPenBear = obPartialBear ? -1 : 0
shiftBull = close>open and body>avgBodyRef*rDisplMult and cloc>60
shiftBear = close<open and body>avgBodyRef*rDisplMult and cloc<40
dqBull = (shiftBull?2:0)+((fBG>0 and fBG>=fvMin)?2:0)+(volR>=1.5?1:0)+(inActive?1:0)+(anyBosB?2:0)+(swpBullValid?2:0)+(cloc>80?1:0)
dqBull := math.min(dqBull, 10)
dqBear = (shiftBear?2:0)+((fSG>0 and fSG>=fvMin)?2:0)+(volR>=1.5?1:0)+(inActive?1:0)+(anyBosS?2:0)+(swpBearValid?2:0)+(cloc<20?1:0)
dqBear := math.min(dqBear, 10)
zName = magnetBullR or magnetBearR ? "★ MAGNET" : htfZoneBullR or htfZoneBearR ? htfZoneSource : retestBullR or retestBearR ? "BOS RETEST" : h1BR or h1SR ? "1H OB" : intOBBullR or intOBBearR ? "INT OB" : swgOBBullR or swgOBBearR ? "SWG OB" : zBullFVM or zBearFVM ? "FVG" : ifvBullR or ifvBearR ? "IFVG" : breakerBullR or breakerBearR ? "BREAKER" : oteReaction ? "OTE" : swpBullValid or swpBearValid ? swpSource : "Zone"
var int confBullHP = 0, var int confBearHP = 0
var string confBullTag = "", var string confBearTag = ""
confBullHP := 0, confBearHP := 0, confBullTag := "", confBearTag := ""
if i_confluenceV2
    hasSweepBull = swpBullValid
    hasZoneBull = anyBullZone
    hasDivBull = anyDivBull or (divRegBull[1] or divHidBull[1] or divRegBull[2] or divHidBull[2])
    hasSMTBull = smtB or smtB[1] or smtB[2] or smtB[3]
    if magnetBullR
        confBullHP := 8, confBullTag := "MAGNET"
    else if hasSweepBull and hasZoneBull and hasDivBull
        confBullHP := 6, confBullTag := "SWP+Z+DIV"
    else if hasSweepBull and hasZoneBull and hasSMTBull
        confBullHP := 6, confBullTag := "SWP+Z+SMT"
    else if hasZoneBull and hasDivBull
        confBullHP := 4, confBullTag := "Z+DIV"
    else if hasZoneBull and hasSMTBull
        confBullHP := 4, confBullTag := "Z+SMT"
    else if hasSweepBull and hasZoneBull
        confBullHP := 4, confBullTag := "SWP+ZONE"
    else if zoneStackBull >= 2
        confBullHP := 2, confBullTag := "STK×" + str.tostring(zoneStackBull)
    else if hasZoneBull and flowBull
        confBullHP := 2, confBullTag := "Z+FLOW"
    hasSweepBear = swpBearValid
    hasZoneBear = anyBearZone
    hasDivBear = anyDivBear or (divRegBear[1] or divHidBear[1] or divRegBear[2] or divHidBear[2])
    hasSMTBear = smtS or smtS[1] or smtS[2] or smtS[3]
    if magnetBearR
        confBearHP := 8, confBearTag := "MAGNET"
    else if hasSweepBear and hasZoneBear and hasDivBear
        confBearHP := 6, confBearTag := "SWP+Z+DIV"
    else if hasSweepBear and hasZoneBear and hasSMTBear
        confBearHP := 6, confBearTag := "SWP+Z+SMT"
    else if hasZoneBear and hasDivBear
        confBearHP := 4, confBearTag := "Z+DIV"
    else if hasZoneBear and hasSMTBear
        confBearHP := 4, confBearTag := "Z+SMT"
    else if hasSweepBear and hasZoneBear
        confBearHP := 4, confBearTag := "SWP+ZONE"
    else if zoneStackBear >= 2
        confBearHP := 2, confBearTag := "STK×" + str.tostring(zoneStackBear)
    else if hasZoneBear and flowBear
        confBearHP := 2, confBearTag := "Z+FLOW"

var float zcBullPrice = na, var int zcBullBar = 0, var bool zcBullActive = false, var string zcBullName = ""
var float zcBullZRS = 0.0
var float zcBearPrice = na, var int zcBearBar = 0, var bool zcBearActive = false, var string zcBearName = ""
var float zcBearZRS = 0.0
var int zcBullConf = 0, var string zcBullConfTag = ""
var int zcBearConf = 0, var string zcBearConfTag = ""
if anyBullZone and not zcBullActive
    zcBullPrice := close, zcBullBar := bar_index, zcBullActive := true, zcBullName := zName
    zcBullZRS := ZRS_bull, zcBullConf := confBullHP, zcBullConfTag := confBullTag
if anyBearZone and not zcBearActive
    zcBearPrice := close, zcBearBar := bar_index, zcBearActive := true, zcBearName := zName
    zcBearZRS := ZRS_bear, zcBearConf := confBearHP, zcBearConfTag := confBearTag
if zcBullActive and (bar_index - zcBullBar) > i_zoneMemBars
    zcBullActive := false
if zcBearActive and (bar_index - zcBearBar) > i_zoneMemBars
    zcBearActive := false
decayBull = zcBullActive ? math.pow(0.85, bar_index - zcBullBar) : 1.0
decayBear = zcBearActive ? math.pow(0.85, bar_index - zcBearBar) : 1.0
effectiveZRS_bull = zcBullActive ? math.max(ZRS_bull, zcBullZRS * decayBull) : (anyBullZone ? ZRS_bull : 0.0)
effectiveZRS_bear = zcBearActive ? math.max(ZRS_bear, zcBearZRS * decayBear) : (anyBearZone ? ZRS_bear : 0.0)
effThreshBull = math.max(1, i_zrsThresh + pdModBull + stackModBull + (isChop ? 2 : 0) + (not sessEstablished ? 2 : 0))
effThreshBear = math.max(1, i_zrsThresh + pdModBear + stackModBear + (isChop ? 2 : 0) + (not sessEstablished ? 2 : 0))

var float moveAnchorPrice=na, var int moveAnchorDir=0, var int moveSignalCount=0
staleMoveDistance = not na(moveAnchorPrice) and not na(atr14) and atr14>0 ? math.abs(close-moveAnchorPrice)/atr14 : 0.0
staleAnchor = staleMoveDistance > i_moveATRLimit * 2.0
trendFlip = ta.change(swingTrend.bias) != 0
if staleAnchor or trendFlip
    moveAnchorPrice := close, moveAnchorDir := 0, moveSignalCount := 0
moveDistance = not na(moveAnchorPrice)?math.abs(close-moveAnchorPrice):0.0
moveATRs = (not na(atr14) and atr14>0)?moveDistance/atr14:0.0
moveExhausted = i_moveExhaust and (moveATRs>i_moveATRLimit or moveSignalCount>4)
structAligned_bull = swingTrend.bias == BULLISH_C or (swingTrend.bias == BEARISH_C and intBullCHCount >= 2)
structAligned_bear = swingTrend.bias == BEARISH_C or (swingTrend.bias == BULLISH_C and intBearCHCount >= 2)
structPenaltyBull = structAligned_bull ? 0 : (swingTrend.bias == BEARISH_C and intBullCHCount == 1) ? 3 : 1
structPenaltyBear = structAligned_bear ? 0 : (swingTrend.bias == BULLISH_C and intBearCHCount == 1) ? 3 : 1
setupHPModBull = magnetBullR ? 5 : retestBullR ? 3 : (swpBullValid and anyBullZone) ? 2 : (oteReaction and oteBias==1) ? 2 : breakerBullR ? 1 : htfZoneBullR ? 2 : 0
setupHPModBear = magnetBearR ? 5 : retestBearR ? 3 : (swpBearValid and anyBearZone) ? 2 : (oteReaction and oteBias==-1) ? 2 : breakerBearR ? 1 : htfZoneBearR ? 2 : 0

posGroupBull = math.max(nearLo?2:0, extDisc?2:0, hyperDisc_v17?3:0, inDisc and pdPct<30?1:0)
posGroupBear = math.max(nearHi?2:0, extPrem?2:0, hyperPrem_v17?3:0, inPrem and pdPct>70?1:0)
flowGroupBull = math.max(pressShiftBull?2:0, viConvBull?1:0, flowBull?2:0)
flowGroupBear = math.max(pressShiftBear?2:0, viConvBear?1:0, flowBear?2:0)
timeGroupBull = math.max(inSB?3:0, timeScore>=4?2:timeScore>=2?1:0)
timeGroupBear = timeGroupBull
indepBull = (arsiBull?1:0)+(smtB?3:0)+(possibilityBuy?2:0)+(anyDivBull?2:0)+(dqBull>=7?2:dqBull>=5?1:0)+(ibBrokenUp?1:0)+(breakerBullR?2:0)+((oteReaction and oteBias==1)?2:0)+(volR>=1.5?1:0)
indepBear = (arsiBear?1:0)+(smtS?3:0)+(possibilitySell?2:0)+(anyDivBear?2:0)+(dqBear>=7?2:dqBear>=5?1:0)+(ibBrokenDn?1:0)+(breakerBearR?2:0)+((oteReaction and oteBias==-1)?2:0)+(volR>=1.5?1:0)
zrsBonusBull = math.round(ZRS_bull >= 8 ? 3 : ZRS_bull >= 6 ? 2 : ZRS_bull >= 4 ? 1 : 0)
zrsBonusBear = math.round(ZRS_bear >= 8 ? 3 : ZRS_bear >= 6 ? 2 : ZRS_bear >= 4 ? 1 : 0)
freshBonusBull = freshBull + partialPenBull
freshBonusBear = freshBear + partialPenBear
stackBonusBull = i_confluenceV2 ? confBullHP : (zoneStackBull >= 3 ? 4 : zoneStackBull >= 2 ? 2 : 0)
stackBonusBear = i_confluenceV2 ? confBearHP : (zoneStackBear >= 3 ? 4 : zoneStackBear >= 2 ? 2 : 0)
hpBullC = posGroupBull + flowGroupBull + timeGroupBull + indepBull + zrsBonusBull + freshBonusBull + stackBonusBull + setupHPModBull + (retestBullR?2:0)
hpBullC -= isChop ? 3 : 0
hpBullC -= strongSP ? 1 : 0
hpBullC -= arsiBear ? 1 : 0
hpBullC -= adrExhausted ? 3 : 0
hpBullC -= cumDeltaDivBear ? 1 : 0
hpBullC -= moveExhausted and moveAnchorDir==1 ? 4 : 0
hpBullC -= softBlockBuy ? 2 : 0
hpBullC -= structPenaltyBull
hpBearC = posGroupBear + flowGroupBear + timeGroupBear + indepBear + zrsBonusBear + freshBonusBear + stackBonusBear + setupHPModBear + (retestBearR?2:0)
hpBearC -= isChop ? 3 : 0
hpBearC -= strongBP ? 1 : 0
hpBearC -= arsiBull ? 1 : 0
hpBearC -= adrExhausted ? 3 : 0
hpBearC -= cumDeltaDivBull ? 1 : 0
hpBearC -= moveExhausted and moveAnchorDir==-1 ? 4 : 0
hpBearC -= softBlockSell ? 2 : 0
hpBearC -= structPenaltyBear
chopHardGate = i_chopHardGate and isChop and adx < 18
var int consecLosses = 0
var bool streakPause = false
streakPause := i_lossBreaker and consecLosses >= i_lossStreakMax

var int prevDayOBTouchBull = 0, var int prevDayOBTouchBear = 0
prevDayOBTouchBull := 0, prevDayOBTouchBear := 0
if i_prevDayOB and (intOBBullR or swgOBBullR)
    if intOBs.size() > 0
        for [idx, ob] in intOBs
            if ob.bias == BULLISH_C and low <= ob.bHigh and low >= ob.bLow
                daysOld = math.floor((time - ob.bTime) / 86400000.0)
                prevDayOBTouchBull := daysOld >= 1 ? 2 : 1
                break
    if prevDayOBTouchBull == 0 and swgOBs.size() > 0
        for [idx, ob] in swgOBs
            if ob.bias == BULLISH_C and low <= ob.bHigh and low >= ob.bLow
                daysOld = math.floor((time - ob.bTime) / 86400000.0)
                prevDayOBTouchBull := daysOld >= 1 ? 2 : 1
                break
if i_prevDayOB and (intOBBearR or swgOBBearR)
    if intOBs.size() > 0
        for [idx, ob] in intOBs
            if ob.bias == BEARISH_C and high >= ob.bLow and high <= ob.bHigh
                daysOld = math.floor((time - ob.bTime) / 86400000.0)
                prevDayOBTouchBear := daysOld >= 1 ? 2 : 1
                break
    if prevDayOBTouchBear == 0 and swgOBs.size() > 0
        for [idx, ob] in swgOBs
            if ob.bias == BEARISH_C and high >= ob.bLow and high <= ob.bHigh
                daysOld = math.floor((time - ob.bTime) / 86400000.0)
                prevDayOBTouchBear := daysOld >= 1 ? 2 : 1
                break
prevDayOBBullHP = i_prevDayOB and prevDayOBTouchBull == 2 ? 3 : prevDayOBTouchBull == 1 ? 1 : 0
prevDayOBBearHP = i_prevDayOB and prevDayOBTouchBear == 2 ? 3 : prevDayOBTouchBear == 1 ? 1 : 0
ny830Window = (barHour == 13 and barMin >= 25 and barMin <= 45) or (barHour == 14 and barMin >= 25 and barMin <= 45)
ldn800Window = (barHour == 7 and barMin >= 55) or (barHour == 8 and barMin <= 15)
inKillzoneSweep = i_killzoneBoost and (ny830Window or ldn800Window)
kzSweepHPBull = inKillzoneSweep and swpBullValid ? 3 : inKillzoneSweep ? 1 : 0
kzSweepHPBear = inKillzoneSweep and swpBearValid ? 3 : inKillzoneSweep ? 1 : 0
kzThreshRelief = inKillzoneSweep ? 1 : 0
eqSweepHPBull = i_eqSweep and eqLowSweptNow ? 3 : 0
eqSweepHPBear = i_eqSweep and eqHighSweptNow ? 3 : 0
var bool shiftPromoteBullPending = false, var bool shiftPromoteBearPending = false
var int shiftPromoteBullBar = 0, var int shiftPromoteBearBar = 0
if i_shiftPromote and possNewB
    shiftPromoteBullPending := true, shiftPromoteBullBar := bar_index
if i_shiftPromote and possNewS
    shiftPromoteBearPending := true, shiftPromoteBearBar := bar_index
shiftPromoteBull = false, shiftPromoteBear = false
if i_shiftPromote and shiftPromoteBullPending and (bar_index - shiftPromoteBullBar) <= 5
    if (swpBullValid or eqLowSweptNow) and anyBullZone and biasAllowBuy
        shiftPromoteBull := true, shiftPromoteBullPending := false
if i_shiftPromote and shiftPromoteBearPending and (bar_index - shiftPromoteBearBar) <= 5
    if (swpBearValid or eqHighSweptNow) and anyBearZone and biasAllowSell
        shiftPromoteBear := true, shiftPromoteBearPending := false
if shiftPromoteBullPending and (bar_index - shiftPromoteBullBar) > 5
    shiftPromoteBullPending := false
if shiftPromoteBearPending and (bar_index - shiftPromoteBearBar) > 5
    shiftPromoteBearPending := false
obRetestBull = false, obRetestBear = false
deltaFlipBull = delta > 0 and delta[1] <= 0
deltaFlipBear = delta < 0 and delta[1] >= 0
if i_obRetestEntry and (intOBBullR or swgOBBullR) and obTouchCountBull >= 2 and deltaFlipBull and biasAllowBuy
    obRetestBull := true
if i_obRetestEntry and (intOBBearR or swgOBBearR) and obTouchCountBear >= 2 and deltaFlipBear and biasAllowSell
    obRetestBear := true
fvgBullSupportHolding = false, fvgBearResistanceHolding = false
if i_antiCounter and array.size(fvB) > 0
    for i = array.size(fvB) - 1 to 0
        bx = array.get(fvB, i)
        bT = box.get_top(bx), bB = box.get_bottom(bx), fM = (bT + bB) / 2
        if low <= bT and low >= bB and close > fM
            fvgBullSupportHolding := true
            break
        else if low > bT and (low[1] <= bT and low[1] >= bB)
            fvgBullSupportHolding := true
            break
if i_antiCounter and array.size(fvS) > 0
    for i = array.size(fvS) - 1 to 0
        bx = array.get(fvS, i)
        bT = box.get_top(bx), bB = box.get_bottom(bx), fM = (bT + bB) / 2
        if high >= bB and high <= bT and close < fM
            fvgBearResistanceHolding := true
            break
        else if high < bB and (high[1] >= bB and high[1] <= bT)
            fvgBearResistanceHolding := true
            break
antiSellGuard = i_antiCounter and fvgBullSupportHolding
antiBuyGuard = i_antiCounter and fvgBearResistanceHolding
var int lastBreakerBar = 0
var bool breakerJustFired = false
breakerJustFired := false
if breakers.size() > 0
    newestBB = breakers.get(0)
    if newestBB.birthBar == bar_index or newestBB.birthBar == bar_index - 1
        breakerJustFired := true, lastBreakerBar := bar_index
inBreakerVolWindow = i_breakerVol and (bar_index - lastBreakerBar) < 100 and (bar_index - lastBreakerBar) > 0 and (tkSt or lnSt or nySt or (bar_index - lastBreakerBar) < 20)
breakerVolHPBull = inBreakerVolWindow and anyBullZone ? 2 : 0
breakerVolHPBear = inBreakerVolWindow and anyBearZone ? 2 : 0
v162HPBull = prevDayOBBullHP + kzSweepHPBull + eqSweepHPBull + breakerVolHPBull
v162HPBear = prevDayOBBearHP + kzSweepHPBear + eqSweepHPBear + breakerVolHPBear
hpBullC := hpBullC + v162HPBull
hpBearC := hpBearC + v162HPBear
effThreshBull := math.max(1, effThreshBull - kzThreshRelief)
effThreshBear := math.max(1, effThreshBear - kzThreshRelief)
hpBullC := i_useProbBias ? math.round(hpBullC * (0.5 + biasProbBuy_v17 * 0.5)) : hpBullC
hpBearC := i_useProbBias ? math.round(hpBearC * (0.5 + biasProbSell_v17 * 0.5)) : hpBearC

// ═══ v18 DISCIPLINED TRADE GATES ═══
v18DiscountOK  = not i_useDPGate  or pdPctClamped <= i_discMaxPct
v18PremiumOK   = not i_useDPGate  or pdPctClamped >= i_premMinPct
v18BuyOBGuard  = not i_useOBGuard or not nearSellOB
v18SellOBGuard = not i_useOBGuard or not nearBuyOB
sellOBContact  = intOBBearR or swgOBBearR or h1SR or breakerBearR
buyOBContact   = intOBBullR or swgOBBullR or h1BR or breakerBullR
v18SellZoneOK  = not i_reqOBForSell or sellOBContact
v18BreakerBuyOK  = not i_reqPatternBrk or not breakerBullR or bullPatternOK
v18BreakerSellOK = not i_reqPatternBrk or not breakerBearR or bearPatternOK
v18BuyAllOK  = v18DiscountOK and v18BuyOBGuard  and v18BreakerBuyOK
v18SellAllOK = v18PremiumOK  and v18SellOBGuard and v18SellZoneOK and v18BreakerSellOK

// SIGNAL ENGINE
var int lastBuyBar=0, var int lastSellBar=0, var float lastBuyPrice=na, var float lastSellPrice=na
confirmedBar = barstate.isconfirmed
sessOK = not i_sessFilter or inActive
cdBuyBase = i_dirCooldown ? adaptCD*3 : adaptCD, cdSellBase = i_dirCooldown ? adaptCD*3 : adaptCD
cdBuyOK = (bar_index-lastBuyBar)>=cdBuyBase and (bar_index-lastSellBar)>=adaptCD
cdSellOK = (bar_index-lastSellBar)>=cdSellBase and (bar_index-lastBuyBar)>=adaptCD
distBuyOK = na(lastBuyPrice) or math.abs(close-lastBuyPrice)>atr14*1.5
distSellOK = na(lastSellPrice) or math.abs(close-lastSellPrice)>atr14*1.5
sweepIntoZoneBull = swpBullValid and anyBullZone
sweepIntoZoneBear = swpBearValid and anyBearZone
confOverrideBull = i_confluenceV2 and confBullHP >= 6
confOverrideBear = i_confluenceV2 and confBearHP >= 6
zoneActive_bull = anyBullZone or zcBullActive
zoneActive_bear = anyBearZone or zcBearActive
phaseGateBull = not i_useSessPhase or phaseAllowsBuy_v17
phaseGateSell = not i_useSessPhase or phaseAllowsSell_v17
zoneEntryBuy  = i_useZoneEntry and zoneActive_bull and biasAllowBuy and sessOK and confirmedBar and cdBuyOK and distBuyOK and not adrBlockBuy and not chopHardGate and not streakPause and phaseGateBull and (effectiveZRS_bull >= effThreshBull or sweepIntoZoneBull or confOverrideBull or magnetBullR)
zoneEntrySell = i_useZoneEntry and zoneActive_bear and biasAllowSell and sessOK and confirmedBar and cdSellOK and distSellOK and not adrBlockSell and not chopHardGate and not streakPause and phaseGateSell and (effectiveZRS_bear >= effThreshBear or sweepIntoZoneBear or confOverrideBear or magnetBearR)
classicBuy  = not i_useZoneEntry and anyBullZone and biasAllowBuy and shiftBull and cdBuyOK and distBuyOK and sessOK and confirmedBar and not adrBlockBuy and not chopHardGate and not streakPause and phaseGateBull
classicSell = not i_useZoneEntry and anyBearZone and biasAllowSell and shiftBear and cdSellOK and distSellOK and sessOK and confirmedBar and not adrBlockSell and not chopHardGate and not streakPause and phaseGateSell
var float pendBuyPrice=na, var int pendBuyBar=0, var bool pendBuyActive=false, var int pendBuyHP=0
var float pendSellPrice=na, var int pendSellBar=0, var bool pendSellActive=false, var int pendSellHP=0
var string pendBuyZone="", var string pendSellZone=""
var int pendBuyConf=0, var string pendBuyConfTag=""
var int pendSellConf=0, var string pendSellConfTag=""
if zoneEntryBuy and not pendBuyActive
    pendBuyPrice:=zcBullActive?nz(zcBullPrice,close):close
    pendBuyBar:=bar_index, pendBuyActive:=true, pendBuyHP:=hpBullC
    pendBuyZone:=zcBullActive?zcBullName:zName
    pendBuyConf:=zcBullActive?zcBullConf:confBullHP
    pendBuyConfTag:=zcBullActive?zcBullConfTag:confBullTag
    zcBullActive:=false
    if drawOK
        cTag = pendBuyConfTag != "" ? " "+pendBuyConfTag : ""
        label.new(bar_index,low,"◆ PENDING BUY\n"+pendBuyZone+" ZRS:"+str.tostring(effectiveZRS_bull,"#")+cTag+"\nEntry: "+str.tostring(pendBuyPrice,"#.#"),style=label.style_label_up,color=color.new(#00E5FF,20),textcolor=color.white,size=size.small,yloc=yloc.belowbar)
if zoneEntrySell and not pendSellActive
    pendSellPrice:=zcBearActive?nz(zcBearPrice,close):close
    pendSellBar:=bar_index, pendSellActive:=true, pendSellHP:=hpBearC
    pendSellZone:=zcBearActive?zcBearName:zName
    pendSellConf:=zcBearActive?zcBearConf:confBearHP
    pendSellConfTag:=zcBearActive?zcBearConfTag:confBearTag
    zcBearActive:=false
    if drawOK
        cTag2 = pendSellConfTag != "" ? " "+pendSellConfTag : ""
        label.new(bar_index,high,"◆ PENDING SELL\n"+pendSellZone+" ZRS:"+str.tostring(effectiveZRS_bear,"#")+cTag2+"\nEntry: "+str.tostring(pendSellPrice,"#.#"),style=label.style_label_down,color=color.new(#FF6D00,20),textcolor=color.white,size=size.small,yloc=yloc.abovebar)
var bool validatedBuy=false, var bool validatedSell=false
var bool invalidatedBuy=false, var bool invalidatedSell=false
validatedBuy:=false, validatedSell:=false, invalidatedBuy:=false, invalidatedSell:=false
looseBullValid() =>
    wickRej = not na(pendBuyPrice) and low <= pendBuyPrice + atr14 * 0.3 and close > pendBuyPrice and lowerWickR > 0.35
    twoBarRev = twoBarBullRev and close > nz(pendBuyPrice, close)
    deltaFlipL = delta > 0 and delta[1] <= 0 and close > nz(pendBuyPrice, close) and close > open
    wickRej or twoBarRev or deltaFlipL
looseBearValid() =>
    wickRej2 = not na(pendSellPrice) and high >= pendSellPrice - atr14 * 0.3 and close < pendSellPrice and upperWickR > 0.35
    twoBarRev2 = twoBarBearRev and close < nz(pendSellPrice, close)
    deltaFlipL2 = delta < 0 and delta[1] >= 0 and close < nz(pendSellPrice, close) and close < open
    wickRej2 or twoBarRev2 or deltaFlipL2
looseBullValidNow = looseBullValid()
looseBearValidNow = looseBearValid()
if pendBuyActive
    elapsed=bar_index-pendBuyBar
    if elapsed>0 and elapsed<=adaptPendBars
        strictBull = isDispBull and close > nz(pendBuyPrice, close)
        looseOK = i_loosePending and looseBullValidNow
        if strictBull or looseOK
            validatedBuy:=true, pendBuyActive:=false
            pendBuyHP:=pendBuyHP+(shiftBull?2:0)+(dqBull>=5?1:0)+(strictBull?1:0)
        else if not na(pendBuyPrice) and close<pendBuyPrice-atr14*0.5
            invalidatedBuy:=true, pendBuyActive:=false
    else if elapsed>adaptPendBars
        invalidatedBuy:=true, pendBuyActive:=false
if pendSellActive
    elapsed2=bar_index-pendSellBar
    if elapsed2>0 and elapsed2<=adaptPendBars
        strictBear = isDispBear and close < nz(pendSellPrice, close)
        looseOK2 = i_loosePending and looseBearValidNow
        if strictBear or looseOK2
            validatedSell:=true, pendSellActive:=false
            pendSellHP:=pendSellHP+(shiftBear?2:0)+(dqBear>=5?1:0)+(strictBear?1:0)
        else if not na(pendSellPrice) and close>pendSellPrice+atr14*0.5
            invalidatedSell:=true, pendSellActive:=false
    else if elapsed2>adaptPendBars
        invalidatedSell:=true, pendSellActive:=false

BUY_base  = validatedBuy or classicBuy or (i_shiftPromote and shiftPromoteBull and biasAllowBuy and cdBuyOK and distBuyOK and not adrBlockBuy and not chopHardGate and not streakPause and phaseGateBull) or (i_obRetestEntry and obRetestBull and biasAllowBuy and cdBuyOK and distBuyOK and not adrBlockBuy and not chopHardGate and not streakPause and phaseGateBull)
SELL_base = validatedSell or classicSell or (i_shiftPromote and shiftPromoteBear and biasAllowSell and cdSellOK and distSellOK and not adrBlockSell and not chopHardGate and not streakPause and phaseGateSell) or (i_obRetestEntry and obRetestBear and biasAllowSell and cdSellOK and distSellOK and not adrBlockSell and not chopHardGate and not streakPause and phaseGateSell)
BUY_pre_v18  = BUY_base  and not antiBuyGuard
SELL_pre_v18 = SELL_base and not antiSellGuard
BUY  = BUY_pre_v18  and v18BuyAllOK
SELL = SELL_pre_v18 and v18SellAllOK
v18RejectBuy  = BUY_pre_v18  and not v18BuyAllOK
v18RejectSell = SELL_pre_v18 and not v18SellAllOK
v18RejectReason = v18RejectBuy  and not v18DiscountOK  ? "PREMIUM"   : v18RejectBuy  and not v18BuyOBGuard ? "SELL OB"   : v18RejectBuy  and not v18BreakerBuyOK  ? "NO PATTERN" : v18RejectSell and not v18PremiumOK    ? "DISCOUNT"  : v18RejectSell and not v18SellOBGuard ? "BUY OB"  : v18RejectSell and not v18SellZoneOK   ? "NO OB/BRKR" : v18RejectSell and not v18BreakerSellOK ? "NO PATTERN" : ""

finalHPBull = validatedBuy?pendBuyHP:hpBullC, finalHPBear = validatedSell?pendSellHP:hpBearC
HP_BUY = BUY and finalHPBull>=rHPThresh, HP_SELL = SELL and finalHPBear>=rHPThresh
tierBuy  = i_useDecisionWF ? (magnetBullR ? "S" : (confBullHP >= 6 and finalHPBull >= rHPThresh + 3) ? "A+" : (confBullHP >= 4 and finalHPBull >= rHPThresh) ? "A" : finalHPBull >= rHPThresh ? "B" : "C") : (finalHPBull>=rHPThresh+3?"A+":finalHPBull>=rHPThresh?"A":finalHPBull>=rHPThresh-2?"B":"C")
tierSell = i_useDecisionWF ? (magnetBearR ? "S" : (confBearHP >= 6 and finalHPBear >= rHPThresh + 3) ? "A+" : (confBearHP >= 4 and finalHPBear >= rHPThresh) ? "A" : finalHPBear >= rHPThresh ? "B" : "C") : (finalHPBear>=rHPThresh+3?"A+":finalHPBear>=rHPThresh?"A":finalHPBear>=rHPThresh-2?"B":"C")
grade = BUY?tierBuy:SELL?tierSell:""
float entryPrice = BUY?(validatedBuy and not na(pendBuyPrice)?pendBuyPrice:close):SELL?(validatedSell and not na(pendSellPrice)?pendSellPrice:close):na
setupName = magnetBullR or magnetBearR ? "★ MAGNET" : validatedBuy or validatedSell ? "ZONE ENTRY ✓" : retestBullR or retestBearR ? "BOS RETEST" : sweepIntoZoneBull or sweepIntoZoneBear ? "SWEEP+ZONE" : htfZoneBullR or htfZoneBearR ? "HTF ZONE" : breakerBullR or breakerBearR ? "BREAKER" : "ZONE TAP"
hasFlow = (BUY and flowBull) or (SELL and flowBear)
flowTag = hasFlow?" +FLOW":""
confTagFinal = validatedBuy and pendBuyConfTag!="" ? " "+pendBuyConfTag : validatedSell and pendSellConfTag!="" ? " "+pendSellConfTag : confBullTag!="" and BUY ? " "+confBullTag : confBearTag!="" and SELL ? " "+confBearTag : ""
zrsTag = validatedBuy?" ZRS:"+str.tostring(ZRS_bull,"#"):validatedSell?" ZRS:"+str.tostring(ZRS_bear,"#"):""
entTxt = not na(entryPrice)?"\nEntry: "+str.tostring(entryPrice,"#.#"):""
dqTxt = BUY?"\nDQ:"+str.tostring(dqBull):SELL?"\nDQ:"+str.tostring(dqBear):""
usedZoneName = validatedBuy?pendBuyZone:validatedSell?pendSellZone:zName
freshTag = (BUY and (intOBBullR or swgOBBullR)) ? " T"+str.tostring(obTouchCountBull) : (SELL and (intOBBearR or swgOBBearR)) ? " T"+str.tostring(obTouchCountBear) : ""
magTag = (BUY and magnetBullR) or (SELL and magnetBearR) ? " ★MAG×"+str.tostring(magnetTouchCount) : ""
patTag = (BUY and breakerBullR and bullPatternOK) ? " +"+patternTag : (SELL and breakerBearR and bearPatternOK) ? " +"+patternTag : ""

if BUY
    lastBuyBar:=bar_index, lastBuyPrice:=nz(entryPrice,close)
    if moveAnchorDir!=1
        moveAnchorPrice:=nz(entryPrice,close), moveAnchorDir:=1, moveSignalCount:=1
    else
        moveSignalCount+=1
if SELL
    lastSellBar:=bar_index, lastSellPrice:=nz(entryPrice,close)
    if moveAnchorDir!=-1
        moveAnchorPrice:=nz(entryPrice,close), moveAnchorDir:=-1, moveSignalCount:=1
    else
        moveSignalCount+=1

if HP_BUY and drawOK
    label.new(bar_index,low,"★ "+grade+" BUY"+flowTag+zrsTag+confTagFinal+freshTag+magTag+patTag+"\n"+setupName+" | "+usedZoneName+entTxt+dqTxt,style=label.style_label_up,color=color.green,textcolor=color.white,size=size.normal,yloc=yloc.belowbar)
else if BUY and drawOK
    label.new(bar_index,low,grade+" BUY"+flowTag+freshTag+magTag+patTag+"\n"+setupName+" | "+usedZoneName+entTxt,style=label.style_label_up,color=color.new(color.green,40),textcolor=color.white,size=size.small,yloc=yloc.belowbar)
if HP_SELL and drawOK
    label.new(bar_index,high,"★ "+grade+" SELL"+flowTag+zrsTag+confTagFinal+freshTag+magTag+patTag+"\n"+setupName+" | "+usedZoneName+entTxt+dqTxt,style=label.style_label_down,color=color.red,textcolor=color.white,size=size.normal,yloc=yloc.abovebar)
else if SELL and drawOK
    label.new(bar_index,high,grade+" SELL"+flowTag+freshTag+magTag+patTag+"\n"+setupName+" | "+usedZoneName+entTxt,style=label.style_label_down,color=color.new(color.red,40),textcolor=color.white,size=size.small,yloc=yloc.abovebar)

if i_showV18Marks and v18RejectBuy and drawOK
    label.new(bar_index,low,"⊘ "+v18RejectReason,style=label.style_label_up,color=color.new(#9E9E9E,30),textcolor=color.white,size=size.tiny,yloc=yloc.belowbar)
if i_showV18Marks and v18RejectSell and drawOK
    label.new(bar_index,high,"⊘ "+v18RejectReason,style=label.style_label_down,color=color.new(#9E9E9E,30),textcolor=color.white,size=size.tiny,yloc=yloc.abovebar)

// ═══ TP/SL DISPLAY with v18 FIXED $ override for gold ═══
var box buyTPB=na, var box sellTPB=na, var box buySLB=na, var box sellSLB=na
var line buyTP1L=na, var line buyTP2L=na, var line buyRunL=na, var line sellTP1L=na, var line sellTP2L=na, var line sellRunL=na
var label buyTP1Lb=na, var label buyTP2Lb=na, var label buyRunLb=na, var label sellTP1Lb=na, var label sellTP2Lb=na, var label sellRunLb=na
if i_showTPSL and BUY and not na(entryPrice) and drawOK
    box.delete(buyTPB), box.delete(buySLB)
    line.delete(buyTP1L), line.delete(buyTP2L), line.delete(buyRunL)
    label.delete(buyTP1Lb), label.delete(buyTP2Lb), label.delete(buyRunLb)
    float slLevel = na, float runner = na, float tp1 = na, float tp2 = na
    if i_useFixedSLTP and isGold
        slLevel := entryPrice - i_fixedSL
        runner  := entryPrice + i_fixedTP
        tp1     := entryPrice + i_fixedTP * 0.40
        tp2     := entryPrice + i_fixedTP * 0.70
    else
        slRefLo = nz(swL_deal, ta.lowest(low, 20))
        slRaw = math.min(slRefLo, entryPrice - atr14 * i_slATRMult) - atr14 * i_slBuffer
        slLevel := i_useStructSL ? slRaw : entryPrice - atr14 * 1.5
        tpATR1 = atr14 * i_tp1ATRMult
        tpATR2 = atr14 * i_tp2ATRMult
        tpCap = atr14 * i_tpHardCap
        runnerCascade = i_useLiqCascade and not na(bsl2) ? bsl2 : not na(bsl1) ? bsl1 : (entryPrice + tpCap)
        runner := math.min(runnerCascade, entryPrice + tpCap)
        tp1 := entryPrice + tpATR1
        tp2 := entryPrice + tpATR2
    buyTPB := box.new(bar_index, entryPrice, bar_index+20, runner, bgcolor=color.new(color.green,90), border_color=color.new(color.green,50), border_width=1)
    buySLB := box.new(bar_index, entryPrice, bar_index+20, slLevel, bgcolor=color.new(color.red,90), border_color=color.new(color.red,50), border_width=1)
    buyTP1L := line.new(bar_index, tp1, bar_index+20, tp1, color=color.new(color.green,40), style=line.style_dashed, width=1)
    buyTP2L := line.new(bar_index, tp2, bar_index+20, tp2, color=color.new(color.green,30), style=line.style_dashed, width=1)
    buyRunL := line.new(bar_index, runner, bar_index+20, runner, color=color.new(color.green,10), style=line.style_solid, width=2)
    buyTP1Lb := label.new(bar_index+21, tp1, "TP1 "+str.tostring(tp1,"#.#"), color=color(na), textcolor=color.green, style=label.style_label_left, size=size.tiny)
    buyTP2Lb := label.new(bar_index+21, tp2, "TP2 "+str.tostring(tp2,"#.#"), color=color(na), textcolor=color.green, style=label.style_label_left, size=size.tiny)
    buyRunLb := label.new(bar_index+21, runner, "RUN★ "+str.tostring(runner,"#.#"), color=color(na), textcolor=color.green, style=label.style_label_left, size=size.small)
if i_showTPSL and SELL and not na(entryPrice) and drawOK
    box.delete(sellTPB), box.delete(sellSLB)
    line.delete(sellTP1L), line.delete(sellTP2L), line.delete(sellRunL)
    label.delete(sellTP1Lb), label.delete(sellTP2Lb), label.delete(sellRunLb)
    float slLevelS = na, float runnerS = na, float tp1S = na, float tp2S = na
    if i_useFixedSLTP and isGold
        slLevelS := entryPrice + i_fixedSL
        runnerS  := entryPrice - i_fixedTP
        tp1S     := entryPrice - i_fixedTP * 0.40
        tp2S     := entryPrice - i_fixedTP * 0.70
    else
        slRefHi = nz(swH_deal, ta.highest(high, 20))
        slRawS = math.max(slRefHi, entryPrice + atr14 * i_slATRMult) + atr14 * i_slBuffer
        slLevelS := i_useStructSL ? slRawS : entryPrice + atr14 * 1.5
        tpATR1S = atr14 * i_tp1ATRMult
        tpATR2S = atr14 * i_tp2ATRMult
        tpCapS = atr14 * i_tpHardCap
        runnerCascadeS = i_useLiqCascade and not na(ssl2) ? ssl2 : not na(ssl1) ? ssl1 : (entryPrice - tpCapS)
        runnerS := math.max(runnerCascadeS, entryPrice - tpCapS)
        tp1S := entryPrice - tpATR1S
        tp2S := entryPrice - tpATR2S
    sellTPB := box.new(bar_index, entryPrice, bar_index+20, runnerS, bgcolor=color.new(color.red,90), border_color=color.new(color.red,50), border_width=1)
    sellSLB := box.new(bar_index, entryPrice, bar_index+20, slLevelS, bgcolor=color.new(color.green,90), border_color=color.new(color.green,50), border_width=1)
    sellTP1L := line.new(bar_index, tp1S, bar_index+20, tp1S, color=color.new(color.red,40), style=line.style_dashed, width=1)
    sellTP2L := line.new(bar_index, tp2S, bar_index+20, tp2S, color=color.new(color.red,30), style=line.style_dashed, width=1)
    sellRunL := line.new(bar_index, runnerS, bar_index+20, runnerS, color=color.new(color.red,10), style=line.style_solid, width=2)
    sellTP1Lb := label.new(bar_index+21, tp1S, "TP1 "+str.tostring(tp1S,"#.#"), color=color(na), textcolor=color.red, style=label.style_label_left, size=size.tiny)
    sellTP2Lb := label.new(bar_index+21, tp2S, "TP2 "+str.tostring(tp2S,"#.#"), color=color(na), textcolor=color.red, style=label.style_label_left, size=size.tiny)
    sellRunLb := label.new(bar_index+21, runnerS, "RUN★ "+str.tostring(runnerS,"#.#"), color=color(na), textcolor=color.red, style=label.style_label_left, size=size.small)

// ═══ PRE-SIGNAL ENGINE ═══
preSignalBuy = i_usePreSignal and not BUY and anyBullZone and biasAllowBuy and (effectiveZRS_bull >= effThreshBull - 1 or confBullHP >= 4) and not chopHardGate and not adrBlockBuy and (bar_index - lastBuyBar) >= adaptCD
preSignalSell = i_usePreSignal and not SELL and anyBearZone and biasAllowSell and (effectiveZRS_bear >= effThreshBear - 1 or confBearHP >= 4) and not chopHardGate and not adrBlockSell and (bar_index - lastSellBar) >= adaptCD
if preSignalBuy and drawOK
    label.new(bar_index, low, "▲", style=label.style_label_up, color=color.new(#00BCD4, 60), textcolor=color.white, size=size.tiny, yloc=yloc.belowbar, tooltip="PRE-SIG BUY  HP:"+str.tostring(hpBullC)+" ZRS:"+str.tostring(effectiveZRS_bull,"#"))
if preSignalSell and drawOK
    label.new(bar_index, high, "▼", style=label.style_label_down, color=color.new(#E040FB, 60), textcolor=color.white, size=size.tiny, yloc=yloc.abovebar, tooltip="PRE-SIG SELL  HP:"+str.tostring(hpBearC)+" ZRS:"+str.tostring(effectiveZRS_bear,"#"))

// ═══ WR TRACKER with REAL $ TRACKING ═══
var float activeBuyEntry=na, var float activeBuySL=na, var float activeBuyTP=na
var int activeBuyBar=0, var string activeBuySetup=""
var float activeSellEntry=na, var float activeSellSL=na, var float activeSellTP=na
var int activeSellBar=0, var string activeSellSetup=""
var int wrTotalBuy=0, var int wrWinBuy=0, var int wrTotalSell=0, var int wrWinSell=0
var float wrR_sumWin=0.0, var float wrR_sumLoss=0.0
var int wrR_winCount=0, var int wrR_lossCount=0
var float totalPnL=0.0, var float winSumDollars=0.0, var float lossSumDollars=0.0
var float largestWin=0.0, var float largestLoss=0.0
var int setupMagnetW=0, var int setupMagnetT=0
var int setupBOSRetestW=0, var int setupBOSRetestT=0
var int setupSweepZoneW=0, var int setupSweepZoneT=0
var int setupZoneEntryW=0, var int setupZoneEntryT=0
var int setupZoneTapW=0, var int setupZoneTapT=0
if HP_BUY and na(activeBuyEntry)
    activeBuyEntry := entryPrice, activeBuyBar := bar_index, activeBuySetup := setupName
    if i_useFixedSLTP and isGold
        activeBuySL := entryPrice - i_fixedSL
        activeBuyTP := entryPrice + i_fixedTP
    else
        activeBuySL := entryPrice - atr14 * 1.5
        activeBuyTP := entryPrice + atr14 * 3.0
if HP_SELL and na(activeSellEntry)
    activeSellEntry := entryPrice, activeSellBar := bar_index, activeSellSetup := setupName
    if i_useFixedSLTP and isGold
        activeSellSL := entryPrice + i_fixedSL
        activeSellTP := entryPrice - i_fixedTP
    else
        activeSellSL := entryPrice + atr14 * 1.5
        activeSellTP := entryPrice - atr14 * 3.0
if not na(activeBuyEntry)
    hitTP = high >= activeBuyTP
    hitSL = low <= activeBuySL
    stale = (bar_index - activeBuyBar) > 50
    // v18.1 FIX #2: a bar that straddles BOTH SL and TP is counted as a LOSS
    // (was counted as a win, inflating WR to 90%+ via intrabar look-ahead).
    if hitTP and not hitSL
        wrTotalBuy += 1, wrWinBuy += 1
        pnlD = activeBuyTP - activeBuyEntry
        totalPnL += pnlD, winSumDollars += pnlD
        largestWin := math.max(largestWin, pnlD)
        risk = activeBuyEntry - activeBuySL
        rMult = risk > 0 ? pnlD / risk : 0
        wrR_sumWin += rMult, wrR_winCount += 1
        if activeBuySetup == "★ MAGNET"
            setupMagnetW += 1, setupMagnetT += 1
        else if activeBuySetup == "BOS RETEST"
            setupBOSRetestW += 1, setupBOSRetestT += 1
        else if activeBuySetup == "SWEEP+ZONE"
            setupSweepZoneW += 1, setupSweepZoneT += 1
        else if activeBuySetup == "ZONE ENTRY ✓"
            setupZoneEntryW += 1, setupZoneEntryT += 1
        else
            setupZoneTapW += 1, setupZoneTapT += 1
        activeBuyEntry := na, consecLosses := 0
    else if hitSL
        wrTotalBuy += 1
        pnlD2 = activeBuySL - activeBuyEntry
        totalPnL += pnlD2, lossSumDollars += math.abs(pnlD2)
        largestLoss := math.max(largestLoss, math.abs(pnlD2))
        wrR_sumLoss += 1, wrR_lossCount += 1
        if activeBuySetup == "★ MAGNET"
            setupMagnetT += 1
        else if activeBuySetup == "BOS RETEST"
            setupBOSRetestT += 1
        else if activeBuySetup == "SWEEP+ZONE"
            setupSweepZoneT += 1
        else if activeBuySetup == "ZONE ENTRY ✓"
            setupZoneEntryT += 1
        else
            setupZoneTapT += 1
        activeBuyEntry := na, consecLosses += 1
    else if stale
        activeBuyEntry := na
if not na(activeSellEntry)
    hitTPs = low <= activeSellTP
    hitSLs = high >= activeSellSL
    stales = (bar_index - activeSellBar) > 50
    // v18.1 FIX #2: ambiguous straddle bar counts as a LOSS (was a win).
    if hitTPs and not hitSLs
        wrTotalSell += 1, wrWinSell += 1
        pnlDs = activeSellEntry - activeSellTP
        totalPnL += pnlDs, winSumDollars += pnlDs
        largestWin := math.max(largestWin, pnlDs)
        risks = activeSellSL - activeSellEntry
        rMults = risks > 0 ? pnlDs / risks : 0
        wrR_sumWin += rMults, wrR_winCount += 1
        if activeSellSetup == "★ MAGNET"
            setupMagnetW += 1, setupMagnetT += 1
        else if activeSellSetup == "BOS RETEST"
            setupBOSRetestW += 1, setupBOSRetestT += 1
        else if activeSellSetup == "SWEEP+ZONE"
            setupSweepZoneW += 1, setupSweepZoneT += 1
        else if activeSellSetup == "ZONE ENTRY ✓"
            setupZoneEntryW += 1, setupZoneEntryT += 1
        else
            setupZoneTapW += 1, setupZoneTapT += 1
        activeSellEntry := na, consecLosses := 0
    else if hitSLs
        wrTotalSell += 1
        pnlDs2 = activeSellEntry - activeSellSL
        totalPnL += pnlDs2, lossSumDollars += math.abs(pnlDs2)
        largestLoss := math.max(largestLoss, math.abs(pnlDs2))
        wrR_sumLoss += 1, wrR_lossCount += 1
        if activeSellSetup == "★ MAGNET"
            setupMagnetT += 1
        else if activeSellSetup == "BOS RETEST"
            setupBOSRetestT += 1
        else if activeSellSetup == "SWEEP+ZONE"
            setupSweepZoneT += 1
        else if activeSellSetup == "ZONE ENTRY ✓"
            setupZoneEntryT += 1
        else
            setupZoneTapT += 1
        activeSellEntry := na, consecLosses += 1
    else if stales
        activeSellEntry := na

wrTotal = wrTotalBuy + wrTotalSell
wrWin = wrWinBuy + wrWinSell
wrPct = wrTotal > 0 ? wrWin * 100.0 / wrTotal : 0
avgWinR = wrR_winCount > 0 ? wrR_sumWin / wrR_winCount : 0
avgLossR = wrR_lossCount > 0 ? wrR_sumLoss / wrR_lossCount : 0
expectancy = wrR_winCount + wrR_lossCount > 0 ? (wrR_sumWin - wrR_sumLoss) / (wrR_winCount + wrR_lossCount) : 0
avgWinD = wrR_winCount > 0 ? winSumDollars / wrR_winCount : 0
avgLossD = wrR_lossCount > 0 ? lossSumDollars / wrR_lossCount : 0
profitFactor = lossSumDollars > 0 ? winSumDollars / lossSumDollars : 0

// ═══ LIVE TRADE QUALITY MONITOR ═══
tradeWarnExitBuy = i_useTradeQual and not na(activeBuyEntry) and (cumDeltaDivBear or anyBearZone or (atr14 > atr200 * 1.5))
tradeWarnExitSell = i_useTradeQual and not na(activeSellEntry) and (cumDeltaDivBull or anyBullZone or (atr14 > atr200 * 1.5))
if tradeWarnExitBuy and drawOK and barstate.isconfirmed
    label.new(bar_index, high, "⚠ TRADE WARN", style=label.style_label_down, color=color.new(#FF9800, 30), textcolor=color.white, size=size.tiny, yloc=yloc.abovebar)
if tradeWarnExitSell and drawOK and barstate.isconfirmed
    label.new(bar_index, low, "⚠ TRADE WARN", style=label.style_label_up, color=color.new(#FF9800, 30), textcolor=color.white, size=size.tiny, yloc=yloc.belowbar)

// ═══ PLOTS ═══
plot(i_showEMA?eF:na, "EMA 9", color.new(#FFEB3B, 30))
plot(i_showEMA?eM:na, "EMA 21", color.new(#FF9800, 30))
plot(i_showEMA?eS:na, "EMA 50", color.new(#9C27B0, 30))
plot(i_showEMA?e200:na, "EMA 200", color.new(#F44336, 30), linewidth=2)
plot(i_showVWAP?vwap:na, "VWAP", color.new(#00BCD4, 20), linewidth=2)
plot(i_showPDHL?pdh:na, "PDH", color.new(#4CAF50, 30), style=plot.style_circles)
plot(i_showPDHL?pdl:na, "PDL", color.new(#F44336, 30), style=plot.style_circles)
plotshape(stBull and not stBull[1]?stV:na, "ST▲", shape.triangleup, location.belowbar, color.new(#4CAF50, 30), size=size.tiny)
plotshape(not stBull and stBull[1]?stV:na, "ST▼", shape.triangledown, location.abovebar, color.new(#F44336, 30), size=size.tiny)
plotshape(HP_BUY, "HP BUY", shape.labelup, location.belowbar, color.new(color.green, 0), text="HP", textcolor=color.white, size=size.tiny)
plotshape(HP_SELL, "HP SELL", shape.labeldown, location.abovebar, color.new(color.red, 0), text="HP", textcolor=color.white, size=size.tiny)
plotshape(magnetBullR, "MAG B", shape.circle, location.belowbar, color.new(#FFD700, 20), size=size.tiny)
plotshape(magnetBearR, "MAG S", shape.circle, location.abovebar, color.new(#FFD700, 20), size=size.tiny)
bgcolor(i_showSessBG and inTK?color.new(i_tokyoCol,i_sessBGTransp):na)
bgcolor(i_showSessBG and inLN?color.new(i_londonCol,i_sessBGTransp):na)
bgcolor(i_showSessBG and inNY?color.new(i_nyCol,i_sessBGTransp):na)
bgcolor(i_showPDZ and hyperPrem_v17?color.new(#B71C1C,85):i_showPDZ and extPrem?color.new(i_premCol,80):na)
bgcolor(i_showPDZ and hyperDisc_v17?color.new(#1B5E20,85):i_showPDZ and extDisc?color.new(i_discCol,80):na)
barcolor(HP_BUY?color.green:HP_SELL?color.red:na)

// ═══ DASHBOARD (split functions to stay within Pine 254-element limit) ═══
var table dash = table.new(position.top_right, 4, 19, frame_color=color.gray, frame_width=1, border_color=color.new(color.gray,70), border_width=1)
drawDashTop() =>
    biasCol = biasIsBull?color.new(#4CAF50,15):biasIsBear?color.new(#F44336,15):color.new(color.gray,15)
    structCol = swingTrend.bias==BULLISH_C?color.new(#4CAF50,30):swingTrend.bias==BEARISH_C?color.new(#F44336,30):color.new(color.gray,30)
    zoneCol = (anyBullZone or zcBullActive)?color.new(#4CAF50,30):(anyBearZone or zcBearActive)?color.new(#F44336,30):color.new(color.gray,40)
    table.cell(dash, 0, 0, "QUANTUM FLOW v18.0", text_color=color.white, bgcolor=color.new(#1A237E, 0), text_size=size.small, text_halign=text.align_center)
    table.merge_cells(dash, 0, 0, 3, 0)
    table.cell(dash, 0, 1, "BIAS", text_color=color.white, bgcolor=biasCol, text_size=size.tiny)
    table.cell(dash, 1, 1, biasTxt, text_color=color.white, bgcolor=biasCol, text_size=size.tiny)
    table.cell(dash, 2, 1, str.tostring(combBias), text_color=color.white, bgcolor=biasCol, text_size=size.tiny)
    table.cell(dash, 3, 1, htfLabel+"/"+ltfLabel, text_color=color.white, bgcolor=biasCol, text_size=size.tiny)
    table.cell(dash, 0, 2, "STRUCT", text_color=color.white, bgcolor=structCol, text_size=size.tiny)
    structTxt = swingTrend.bias==BULLISH_C?"BULL":swingTrend.bias==BEARISH_C?"BEAR":"NEUT"
    table.cell(dash, 1, 2, structTxt, text_color=color.white, bgcolor=structCol, text_size=size.tiny)
    table.cell(dash, 2, 2, "CH:"+str.tostring(intBullCHCount)+"/"+str.tostring(intBearCHCount), text_color=color.white, bgcolor=structCol, text_size=size.tiny)
    table.cell(dash, 3, 2, possibilityBuy?"⚠B":possibilitySell?"⚠S":"—", text_color=color.white, bgcolor=structCol, text_size=size.tiny)
    table.cell(dash, 0, 3, "ZONES", text_color=color.white, bgcolor=zoneCol, text_size=size.tiny)
    table.cell(dash, 1, 3, zName, text_color=color.white, bgcolor=zoneCol, text_size=size.tiny)
    table.cell(dash, 2, 3, "STK:"+str.tostring(math.max(zoneStackBull,zoneStackBear)), text_color=color.white, bgcolor=zoneCol, text_size=size.tiny)
    table.cell(dash, 3, 3, "F:"+str.tostring(math.max(freshBull,freshBear)), text_color=color.white, bgcolor=zoneCol, text_size=size.tiny)
drawDashMid() =>
    magCol = (magnetBullR or magnetBearR)?color.new(#FFD700,15):color.new(color.gray,50)
    confCol = (confBullHP>=4 or confBearHP>=4)?color.new(#9C27B0,20):color.new(color.gray,50)
    moveCol = moveExhausted?color.new(#F44336,30):color.new(color.gray,50)
    regCol = isChop?color.new(#FF9800,20):isTrend?color.new(#4CAF50,30):color.new(color.gray,50)
    volCol = volR>=1.5?color.new(#9C27B0,20):color.new(color.gray,50)
    table.cell(dash, 0, 4, "MAGNET", text_color=color.white, bgcolor=magCol, text_size=size.tiny)
    magTxt = (magnetBullR or magnetBearR)?"HIT ×"+str.tostring(magnetTouchCount):"—"
    table.cell(dash, 1, 4, magTxt, text_color=color.white, bgcolor=magCol, text_size=size.tiny)
    magWR = i_useBayesian?str.tostring(math.round(magnetBayesWR*100))+"%":"—"
    table.cell(dash, 2, 4, "WR:"+magWR, text_color=color.white, bgcolor=magCol, text_size=size.tiny)
    table.cell(dash, 3, 4, "Bayes", text_color=color.white, bgcolor=magCol, text_size=size.tiny)
    table.cell(dash, 0, 5, "CONF", text_color=color.white, bgcolor=confCol, text_size=size.tiny)
    confTxt = confBullHP>0?confBullTag+" "+str.tostring(confBullHP):confBearHP>0?confBearTag+" "+str.tostring(confBearHP):"—"
    table.cell(dash, 1, 5, confTxt, text_color=color.white, bgcolor=confCol, text_size=size.tiny)
    zrsTxt2 = "B:"+str.tostring(effectiveZRS_bull,"#")+"/"+str.tostring(effThreshBull)+" S:"+str.tostring(effectiveZRS_bear,"#")+"/"+str.tostring(effThreshBear)
    table.cell(dash, 2, 5, zrsTxt2, text_color=color.white, bgcolor=confCol, text_size=size.tiny)
    pendTxt = pendBuyActive?"◆B "+str.tostring(adaptPendBars-(bar_index-pendBuyBar)):pendSellActive?"◆S "+str.tostring(adaptPendBars-(bar_index-pendSellBar)):"—"
    table.cell(dash, 3, 5, pendTxt, text_color=color.white, bgcolor=confCol, text_size=size.tiny)
    table.cell(dash, 0, 6, "MOVE", text_color=color.white, bgcolor=moveCol, text_size=size.tiny)
    table.cell(dash, 1, 6, str.tostring(moveATRs,"#.#")+" ATR", text_color=color.white, bgcolor=moveCol, text_size=size.tiny)
    table.cell(dash, 2, 6, "Sig:"+str.tostring(moveSignalCount)+"/"+(moveAnchorDir==1?"▲":moveAnchorDir==-1?"▼":"—"), text_color=color.white, bgcolor=moveCol, text_size=size.tiny)
    table.cell(dash, 3, 6, "LSS:"+str.tostring(consecLosses), text_color=color.white, bgcolor=moveCol, text_size=size.tiny)
    table.cell(dash, 0, 7, "REGIME", text_color=color.white, bgcolor=regCol, text_size=size.tiny)
    table.cell(dash, 1, 7, regTxt, text_color=color.white, bgcolor=regCol, text_size=size.tiny)
    table.cell(dash, 2, 7, "ADX:"+str.tostring(adx,"#"), text_color=color.white, bgcolor=regCol, text_size=size.tiny)
    table.cell(dash, 3, 7, wyTxt, text_color=color.white, bgcolor=regCol, text_size=size.tiny)
    table.cell(dash, 0, 8, "VOL", text_color=color.white, bgcolor=volCol, text_size=size.tiny)
    table.cell(dash, 1, 8, viType, text_color=color.white, bgcolor=volCol, text_size=size.tiny)
    table.cell(dash, 2, 8, str.tostring(volR,"#.#")+"x", text_color=color.white, bgcolor=volCol, text_size=size.tiny)
    table.cell(dash, 3, 8, strongBP?"BP↑":strongSP?"SP↓":"—", text_color=color.white, bgcolor=volCol, text_size=size.tiny)
drawDashState() =>
    sessCol = inSB?color.new(#FFD700,20):inActive?color.new(#2196F3,30):color.new(color.gray,50)
    smtCol = (smtB or smtS)?color.new(#E91E63,20):color.new(color.gray,50)
    readCol = HP_BUY?color.new(#4CAF50,10):HP_SELL?color.new(#F44336,10):BUY?color.new(#4CAF50,30):SELL?color.new(#F44336,30):color.new(color.gray,40)
    table.cell(dash, 0, 9, "SESS", text_color=color.white, bgcolor=sessCol, text_size=size.tiny)
    sessTxt = inSB?"SILVER BULLET":inTK?"TOKYO":inLN and inNY?"LDN+NY":inLN?"LONDON":inNY?"NEW YORK":"OFF"
    table.cell(dash, 1, 9, sessTxt, text_color=color.white, bgcolor=sessCol, text_size=size.tiny)
    table.cell(dash, 2, 9, sessionPhase, text_color=color.white, bgcolor=sessCol, text_size=size.tiny)
    table.cell(dash, 3, 9, "T:"+str.tostring(timeScore), text_color=color.white, bgcolor=sessCol, text_size=size.tiny)
    table.cell(dash, 0, 10, "CORR", text_color=color.white, bgcolor=smtCol, text_size=size.tiny)
    table.cell(dash, 1, 10, smtSym, text_color=color.white, bgcolor=smtCol, text_size=size.tiny)
    table.cell(dash, 2, 10, str.tostring(smtCorr,"#.##"), text_color=color.white, bgcolor=smtCol, text_size=size.tiny)
    table.cell(dash, 3, 10, smtB?"SMT▲":smtS?"SMT▼":"—", text_color=color.white, bgcolor=smtCol, text_size=size.tiny)
    table.cell(dash, 0, 11, "READ", text_color=color.white, bgcolor=readCol, text_size=size.small, text_halign=text.align_center)
    readTxt = HP_BUY?"★ "+tierBuy+" BUY":HP_SELL?"★ "+tierSell+" SELL":BUY?tierBuy+" BUY":SELL?tierSell+" SELL":preSignalBuy?"PRE▲":preSignalSell?"PRE▼":pendBuyActive?"PENDING B":pendSellActive?"PENDING S":"NEUTRAL"
    table.cell(dash, 1, 11, readTxt, text_color=color.white, bgcolor=readCol, text_size=size.small, text_halign=text.align_center)
    table.merge_cells(dash, 1, 11, 3, 11)
drawDashFoot() =>
    wrCol = wrPct>=60?color.new(#4CAF50,20):wrPct>=45?color.new(#FF9800,30):color.new(#F44336,30)
    pnlCol = totalPnL>=0?color.new(#4CAF50,15):color.new(#F44336,15)
    v18Col = (v18BuyAllOK or v18SellAllOK)?color.new(#4CAF50,30):color.new(color.gray,50)
    table.cell(dash, 0, 12, "TRACK", text_color=color.white, bgcolor=wrCol, text_size=size.tiny)
    table.cell(dash, 1, 12, "WR:"+str.tostring(math.round(wrPct))+"%", text_color=color.white, bgcolor=wrCol, text_size=size.tiny)
    table.cell(dash, 2, 12, "W:"+str.tostring(wrWin)+"/"+str.tostring(wrTotal), text_color=color.white, bgcolor=wrCol, text_size=size.tiny)
    table.cell(dash, 3, 12, "B:"+str.tostring(wrWinBuy)+"/"+str.tostring(wrTotalBuy)+" S:"+str.tostring(wrWinSell)+"/"+str.tostring(wrTotalSell), text_color=color.white, bgcolor=wrCol, text_size=size.tiny)
    table.cell(dash, 0, 13, "R:R", text_color=color.white, bgcolor=color.new(color.gray,50), text_size=size.tiny)
    table.cell(dash, 1, 13, "Avg W:"+str.tostring(avgWinR,"#.#")+"R", text_color=color.white, bgcolor=color.new(color.gray,50), text_size=size.tiny)
    table.cell(dash, 2, 13, "Avg L:"+str.tostring(avgLossR,"#.#")+"R", text_color=color.white, bgcolor=color.new(color.gray,50), text_size=size.tiny)
    table.cell(dash, 3, 13, "Exp:"+str.tostring(expectancy,"#.##")+"R", text_color=color.white, bgcolor=color.new(color.gray,50), text_size=size.tiny)
    table.cell(dash, 0, 14, "$ P&L", text_color=color.white, bgcolor=pnlCol, text_size=size.tiny)
    table.cell(dash, 1, 14, (totalPnL>=0?"+$":"-$")+str.tostring(math.abs(totalPnL),"#.#"), text_color=color.white, bgcolor=pnlCol, text_size=size.tiny)
    table.cell(dash, 2, 14, "AvgW:$"+str.tostring(avgWinD,"#.#"), text_color=color.white, bgcolor=pnlCol, text_size=size.tiny)
    table.cell(dash, 3, 14, "PF:"+str.tostring(profitFactor,"#.##"), text_color=color.white, bgcolor=pnlCol, text_size=size.tiny)
    table.cell(dash, 0, 15, "SETUPS", text_color=color.white, bgcolor=color.new(color.gray,50), text_size=size.tiny)
    setupTxt1 = "MAG:"+str.tostring(setupMagnetW)+"/"+str.tostring(setupMagnetT)
    setupTxt2 = "BOS:"+str.tostring(setupBOSRetestW)+"/"+str.tostring(setupBOSRetestT)
    setupTxt3 = "SWP:"+str.tostring(setupSweepZoneW)+"/"+str.tostring(setupSweepZoneT)+" Z:"+str.tostring(setupZoneEntryW+setupZoneTapW)+"/"+str.tostring(setupZoneEntryT+setupZoneTapT)
    table.cell(dash, 1, 15, setupTxt1, text_color=color.white, bgcolor=color.new(color.gray,50), text_size=size.tiny)
    table.cell(dash, 2, 15, setupTxt2, text_color=color.white, bgcolor=color.new(color.gray,50), text_size=size.tiny)
    table.cell(dash, 3, 15, setupTxt3, text_color=color.white, bgcolor=color.new(color.gray,50), text_size=size.tiny)
    table.cell(dash, 0, 16, "v18 RULES", text_color=color.white, bgcolor=v18Col, text_size=size.tiny)
    dpTxt = i_useDPGate ? "P/D:"+str.tostring(math.round(pdPctClamped))+"%" : "P/D:OFF"
    obGuardTxt = nearSellOB ? "⊘ SellOB↑" : nearBuyOB ? "⊘ BuyOB↓" : "OB:OK"
    patTxt = bullPatternOK ? "+"+patternTag : bearPatternOK ? "+"+patternTag : "—"
    table.cell(dash, 1, 16, dpTxt, text_color=color.white, bgcolor=v18Col, text_size=size.tiny)
    table.cell(dash, 2, 16, obGuardTxt, text_color=color.white, bgcolor=v18Col, text_size=size.tiny)
    table.cell(dash, 3, 16, patTxt, text_color=color.white, bgcolor=v18Col, text_size=size.tiny)
    table.cell(dash, 0, 17, "THRESH", text_color=color.white, bgcolor=color.new(color.gray,60), text_size=size.tiny)
    table.cell(dash, 1, 17, "HP:"+str.tostring(rHPThresh), text_color=color.white, bgcolor=color.new(color.gray,60), text_size=size.tiny)
    table.cell(dash, 2, 17, "SL:$"+str.tostring(i_fixedSL,"#"), text_color=color.white, bgcolor=color.new(color.gray,60), text_size=size.tiny)
    table.cell(dash, 3, 17, "TP:$"+str.tostring(i_fixedTP,"#"), text_color=color.white, bgcolor=color.new(color.gray,60), text_size=size.tiny)
    table.cell(dash, 0, 18, "INSTR", text_color=color.white, bgcolor=color.new(#1A237E,20), text_size=size.tiny)
    table.cell(dash, 1, 18, rProfName, text_color=color.white, bgcolor=color.new(#1A237E,20), text_size=size.tiny)
    table.cell(dash, 2, 18, "ADR:"+str.tostring(math.round(adrPct))+"%", text_color=color.white, bgcolor=color.new(#1A237E,20), text_size=size.tiny)
    table.cell(dash, 3, 18, adrTxt, text_color=color.white, bgcolor=color.new(#1A237E,20), text_size=size.tiny)
if i_showDash and barstate.islast
    drawDashTop()
    drawDashMid()
    drawDashState()
    drawDashFoot()

// MARKET INTEL (small bottom-left)
var table mi = table.new(position.bottom_left, 3, 7, frame_color=color.gray, frame_width=1)
if i_showMI and barstate.islast
    table.cell(mi, 0, 0, "MARKET INTEL", text_color=color.white, bgcolor=color.new(#1A237E,0), text_size=size.tiny, text_halign=text.align_center)
    table.merge_cells(mi, 0, 0, 2, 0)
    table.cell(mi, 0, 1, "P/D", text_color=color.white, bgcolor=color.new(color.gray,60), text_size=size.tiny)
    table.cell(mi, 1, 1, str.tostring(math.round(pdPctClamped))+"%", text_color=color.white, bgcolor=color.new(color.gray,60), text_size=size.tiny)
    pdLabel = hyperPrem_v17?"HYPER↑":extPrem?"EXT↑":hyperDisc_v17?"HYPER↓":extDisc?"EXT↓":inPrem?"PREM":inDisc?"DISC":"EQ"
    table.cell(mi, 2, 1, pdLabel, text_color=color.white, bgcolor=color.new(color.gray,60), text_size=size.tiny)
    table.cell(mi, 0, 2, "RSI", text_color=color.white, bgcolor=color.new(color.gray,60), text_size=size.tiny)
    table.cell(mi, 1, 2, str.tostring(arsi,"#.#"), text_color=color.white, bgcolor=color.new(color.gray,60), text_size=size.tiny)
    table.cell(mi, 2, 2, arsiRegime, text_color=color.white, bgcolor=color.new(color.gray,60), text_size=size.tiny)
    table.cell(mi, 0, 3, "DIV", text_color=color.white, bgcolor=color.new(color.gray,60), text_size=size.tiny)
    divTxt = anyDivBull?"BULL":anyDivBear?"BEAR":"—"
    table.cell(mi, 1, 3, divTxt, text_color=color.white, bgcolor=color.new(color.gray,60), text_size=size.tiny)
    table.cell(mi, 2, 3, divRegBull?"REG":divHidBull?"HID":divRegBear?"REG":divHidBear?"HID":"—", text_color=color.white, bgcolor=color.new(color.gray,60), text_size=size.tiny)
    table.cell(mi, 0, 4, "ATR", text_color=color.white, bgcolor=color.new(color.gray,60), text_size=size.tiny)
    table.cell(mi, 1, 4, str.tostring(atr14,"#.#"), text_color=color.white, bgcolor=color.new(color.gray,60), text_size=size.tiny)
    table.cell(mi, 2, 4, atr14>atr200?"HIGH":"NORM", text_color=color.white, bgcolor=color.new(color.gray,60), text_size=size.tiny)
    table.cell(mi, 0, 5, "DELTA", text_color=color.white, bgcolor=color.new(color.gray,60), text_size=size.tiny)
    table.cell(mi, 1, 5, str.tostring(math.round(pressR))+"%", text_color=color.white, bgcolor=color.new(color.gray,60), text_size=size.tiny)
    table.cell(mi, 2, 5, cumDeltaDivBull?"BULL DIV":cumDeltaDivBear?"BEAR DIV":"—", text_color=color.white, bgcolor=color.new(color.gray,60), text_size=size.tiny)
    table.cell(mi, 0, 6, "BIAS PROB", text_color=color.white, bgcolor=color.new(color.gray,60), text_size=size.tiny)
    table.cell(mi, 1, 6, "B:"+str.tostring(math.round(biasProbBuy_v17*100))+"%", text_color=color.white, bgcolor=color.new(color.gray,60), text_size=size.tiny)
    table.cell(mi, 2, 6, "S:"+str.tostring(math.round(biasProbSell_v17*100))+"%", text_color=color.white, bgcolor=color.new(color.gray,60), text_size=size.tiny)

// ═══ ALERTS ═══
alertcondition(BUY, "QF v18 BUY", "QF v18 BUY {{ticker}} @ {{close}}")
alertcondition(SELL, "QF v18 SELL", "QF v18 SELL {{ticker}} @ {{close}}")
alertcondition(HP_BUY, "QF v18 HP BUY", "QF v18 HP★ BUY {{ticker}} @ {{close}}")
alertcondition(HP_SELL, "QF v18 HP SELL", "QF v18 HP★ SELL {{ticker}} @ {{close}}")
alertcondition(magnetBullR, "QF v18 MAGNET BUY", "QF v18 MAGNET HIT BUY {{ticker}}")
alertcondition(magnetBearR, "QF v18 MAGNET SELL", "QF v18 MAGNET HIT SELL {{ticker}}")
alertcondition(zoneEntryBuy, "QF v18 PENDING BUY", "QF v18 PENDING BUY {{ticker}}")
alertcondition(zoneEntrySell, "QF v18 PENDING SELL", "QF v18 PENDING SELL {{ticker}}")
alertcondition(possNewB, "QF v18 SHIFT BUY", "QF v18 BUY SHIFT POSSIBLE {{ticker}}")
alertcondition(possNewS, "QF v18 SHIFT SELL", "QF v18 SELL SHIFT POSSIBLE {{ticker}}")
alertcondition(preSignalBuy, "QF v18 PRE BUY", "QF v18 PRE-SIGNAL BUY {{ticker}}")
alertcondition(preSignalSell, "QF v18 PRE SELL", "QF v18 PRE-SIGNAL SELL {{ticker}}")
alertcondition(tradeWarnExitBuy or tradeWarnExitSell, "QF v18 TRADE WARN", "QF v18 TRADE QUALITY WARN {{ticker}}")
alertcondition(v18RejectBuy or v18RejectSell, "QF v18 REJECT", "QF v18 SIGNAL REJECTED — see chart")
if BUY and barstate.isconfirmed
    alert("QF v18 "+grade+" BUY "+syminfo.ticker+" @ "+str.tostring(close,"#.#")+" | "+setupName+" | "+usedZoneName+" HP:"+str.tostring(finalHPBull), alert.freq_once_per_bar_close)
if SELL and barstate.isconfirmed
    alert("QF v18 "+grade+" SELL "+syminfo.ticker+" @ "+str.tostring(close,"#.#")+" | "+setupName+" | "+usedZoneName+" HP:"+str.tostring(finalHPBear), alert.freq_once_per_bar_close)
