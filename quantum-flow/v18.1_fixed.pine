//@version=6
indicator("QUANTUM FLOW v18.1 — DISCIPLINED (FIXED)", overlay=true,
         max_labels_count=500, max_lines_count=500, max_boxes_count=500, max_bars_back=2000)

// ═══════════════════════════════════════════════════════
// v18.0 CHANGELOG
// 1. HARD D/P GATE — Buys only at Discount, Sells only at Premium
// 2. OPPOSING OB GUARD — Block buys near SELL OB, sells near BUY OB
// 3. SELL ZONE LOCK — Sells require OB or Breaker contact
// 4. BREAKER PATTERN GATE — Buys at breaker need Engulf or Morning Star
//                          Sells at breaker need Engulf or Evening Star
// 5. FIXED $ SL/TP for Gold — $20 SL / $50 TP default (2.5R)
// 6. REAL $ P&L TRACKING — Real WR, total P&L, dollar win/loss tracking
// ═══════════════════════════════════════════════════════

type pivotPoint
    float currentLevel
    float lastLevel
    bool crossed
    int barTime = na
    int barIdx = na
type trendBias
    int bias = 0
type trailExt
    float top = na
    float bottom = na
    int topTime = na
    int topIdx = na
    int bottomTime = na
    int bottomIdx = na
type liqPool
    float level
    int touches
    int firstBar
    int lastBar
    int firstTime
    bool isHigh
    bool swept
type breakerBlock
    float bHigh
    float bLow
    int bTime
    int bias
    int birthBar
type obData
    float bHigh
    float bLow
    int bTime
    int bias
    bool isBearishCandle
    int touchCount = 0
    bool partialMitig = false
type retestZone
    float level
    int bias
    int birthBar
    bool tested
type reactiveLevel
    float price
    int firstTouchBar
    int touchCount
    int reactionWins
    int reactionLosses
    float avgReactionPips
    int htfAgreement
    bool isMagnet
    int lastTouchBar
    int direction
    int lastDirection
    bool isActive
type htfZone
    float zHigh
    float zLow
    int bias
    string source
    int birthBar
    bool active

BULLISH_C = 1
BEARISH_C = -1
GREEN_C   = #089981
RED_C     = #F23645

isGold = str.contains(str.upper(syminfo.ticker), "XAU") or str.contains(str.upper(syminfo.ticker), "GOLD") or str.contains(str.upper(syminfo.ticker), "GC")
isNQ   = str.contains(str.upper(syminfo.ticker), "NQ") or str.contains(str.upper(syminfo.ticker), "MNQ")
isES   = str.contains(str.upper(syminfo.ticker), "ES") or str.contains(str.upper(syminfo.ticker), "MES") or str.contains(str.upper(syminfo.ticker), "SPX")
isEU   = str.contains(str.upper(syminfo.ticker), "EUR") and str.contains(str.upper(syminfo.ticker), "USD")
isGU   = str.contains(str.upper(syminfo.ticker), "GBP") and str.contains(str.upper(syminfo.ticker), "USD")
isUJ   = str.contains(str.upper(syminfo.ticker), "USD") and str.contains(str.upper(syminfo.ticker), "JPY")
isBTC  = str.contains(str.upper(syminfo.ticker), "BTC") or str.contains(str.upper(syminfo.ticker), "MBT")
isFX   = isEU or isGU or isUJ
float profDisplMult = isGold?1.3:isNQ?1.5:isES?1.2:isFX?1.4:isBTC?1.3:1.3
float profSweepTol  = isGold?0.10:isNQ?0.08:isES?0.06:isFX?0.12:isBTC?0.10:0.10
int   profHPThresh  = isGold?4:isNQ?5:isES?4:isFX?4:isBTC?4:4
string profCorr1    = isGold?"TVC:DXY":isNQ?"CME_MINI:ES1!":isES?"CME_MINI:NQ1!":isEU?"TVC:DXY":isGU?"TVC:DXY":isUJ?"FX:EURUSD":isBTC?"BINANCE:ETHUSD":"TVC:DXY"
string profName     = isGold?"GOLD":isNQ?"NQ":isES?"ES":isEU?"EUR/USD":isGU?"GBP/USD":isUJ?"USD/JPY":isBTC?"BTC":"GENERAL"

// INPUTS
GRP_PROF = "═══ INSTRUMENT ═══"
i_profOverride = input.string("Auto","Profile",group=GRP_PROF,options=["Auto","Gold","NQ","ES","EUR/USD","GBP/USD","USD/JPY","BTC"])

