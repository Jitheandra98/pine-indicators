i_discMaxPct    = input.float(50.0, "  └ Buy: max P/D %",   group=GRP_V18, minval=20.0, maxval=60.0, step=5.0)
i_premMinPct    = input.float(50.0, "  └ Sell: min P/D %",  group=GRP_V18, minval=40.0, maxval=80.0, step=5.0)
